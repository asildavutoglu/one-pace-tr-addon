Dialogue: 2,0:01:54.09,0:01:58.97,Title-480p,ti,0,0,0,,{\fad(800,800)}Küçük Bahçe Macerası
Dialogue: 0,0:02:16.50,0:02:18.50,Main-480p,,0,0,0,,Acaba kar mı yağacak?
Dialogue: 0,0:02:18.50,0:02:20.01,Main-480p,,0,0,0,,Nasıl kar yağabilir?
Dialogue: 0,0:02:20.01,0:02:23.16,Main-480p,,0,0,0,,Elbette yağabilir!\NUyuyordun, bu yüzden bilmiyorsun.
Dialogue: 0,0:02:24.41,0:02:27.21,Main-480p,,0,0,0,,Hey. Yeniden kar yağacak, değil mi?
Dialogue: 0,0:02:27.21,0:02:32.01,Main-480p,,0,0,0,,Bir daha asla kar yağmayacak değil\Nama okyanusun ilk uzanışı emsalsizdir.
Dialogue: 0,0:02:32.01,0:02:37.57,Main-480p,,0,0,0,,Döndüren Dağı'ndan yayılan 7 farklı\Nmanyetik alan bölgedeki her şeyi etkiler.
Dialogue: 0,0:02:41.10,0:02:44.39,Main-480p,,0,0,0,,Bu yüzden tedbirli olmalıyız.
Dialogue: 0,0:02:44.39,0:02:47.94,Main-480p,,0,0,0,,İlkinki gibi sert bir yolculuk epey nadir olur.
Dialogue: 0,0:02:48.78,0:02:52.36,Main-480p,,0,0,0,,Ama bu denizde yön belirlemek,\Ndünyadaki diğer denizlerden daha zordur.
Dialogue: 0,0:02:52.36,0:02:56.36,Main-480p,,0,0,0,,Altın kural, bu denizi asla hafife almamaktır.
Dialogue: 0,0:02:56.36,0:02:58.16,Main-480p,,0,0,0,,Hey, sizi hödükler!
Dialogue: 0,0:02:59.03,0:03:01.83,Main-480p,,0,0,0,,Özel içeceğimin tadına bakmaya ne dersiniz?
Dialogue: 0,0:03:06.49,0:03:08.19,Main-480p,,0,0,0,,İçin!
Dialogue: 0,0:03:12.04,0:03:15.42,Main-480p,,0,0,0,,Hey Usopp, bize balık avlamak için alet yap!
Dialogue: 0,0:03:15.42,0:03:17.68,Main-480p,,0,0,0,,Balık avlama aleti? İyi fikir!
Dialogue: 0,0:03:17.68,0:03:21.84,Main-480p,,0,0,0,,Tamam! Size gerçekten artistik balık tuzakları yapacağım!
Dialogue: 0,0:03:23.79,0:03:27.27,Main-480p,,0,0,0,,Sevdin, ha?\NGüzel, değil mi?
Dialogue: 0,0:03:31.81,0:03:33.49,Main-480p,,0,0,0,,Müthiş, Carue!
Dialogue: 0,0:03:34.27,0:03:35.87,Main-480p,,0,0,0,,Nasıl böyle davranabilirler?
Dialogue: 0,0:03:35.87,0:03:37.29,Main-480p,,0,0,0,,İşte seninki.
Dialogue: 0,0:03:37.29,0:03:38.15,Main-480p,,0,0,0,,Ne?
Dialogue: 0,0:03:38.15,0:03:40.24,Main-480p,,0,0,0,,Bırak eğlensinler.
Dialogue: 0,0:03:40.24,0:03:45.87,Main-480p,,0,0,0,,Fırtına gelirse, ne yapacaklarını biliyorlar.\NBilirsin, ölmek istemezler.
Dialogue: 0,0:03:46.70,0:03:50.33,Main-480p,,0,0,0,,Öyle ama tetikte olmaya bile çalışmıyor gibiler!
Dialogue: 0,0:03:51.00,0:03:54.29,Main-480p,,0,0,0,,O şekilde endişelenmemelisin.\NBu gemide olmaz.
Dialogue: 0,0:03:55.61,0:03:58.21,Main-480p,,0,0,0,,Evet, böyle bir rahatlık...
Dialogue: 0,0:04:03.38,0:04:06.26,Main-480p,,0,0,0,,Hey millet, bakın!\NBu bir yunus!
Dialogue: 0,0:04:06.26,0:04:08.26,Main-480p,,0,0,0,,Çok güzel!
Dialogue: 0,0:04:18.89,0:04:21.24,Main-480p,,0,0,0,,ÇOK BÜYÜK!
Dialogue: 0,0:04:33.71,0:04:35.50,Main-480p,,0,0,0,,KAÇIN!
Dialogue: 0,0:04:37.46,0:04:38.24,Main-480p,,0,0,0,,Hadi yapalım!
Dialogue: 0,0:04:38.24,0:04:39.88,Main-480p,,0,0,0,,Evet!
Dialogue: 0,0:04:38.59,0:04:39.88,Secondary-480p,,0,0,0,,Evet!
Dialogue: 0,0:04:44.29,0:04:45.68,Main-480p,,0,0,0,,Tamam!
Dialogue: 0,0:04:46.79,0:04:47.98,Main-480p,,0,0,0,,O tarafı sağlamlaştırın!
Dialogue: 0,0:04:47.98,0:04:48.89,Main-480p,,0,0,0,,Ben hallederim!
Dialogue: 0,0:04:48.89,0:04:50.52,Main-480p,,0,0,0,,Herkes...
Dialogue: 0,0:04:50.52,0:04:52.77,Main-480p,,0,0,0,,YELKENLER FORA!
Dialogue: 0,0:05:03.65,0:05:06.82,Main-480p,,0,0,0,,Tamam! Dalgayı yakalayıp buradan çıkacağız!
Dialogue: 0,0:05:19.67,0:05:22.51,Main-480p,,0,0,0,,Nami? Rotamız ne alemde?
Dialogue: 0,0:05:22.51,0:05:24.76,Main-480p,,0,0,0,,Bir saniye, kontrol edeceğim.
Dialogue: 0,0:05:31.08,0:05:32.97,Main-480p,,0,0,0,,Gemiyi iskele tarafına döndürün!
Dialogue: 0,0:05:35.31,0:05:37.60,Main-480p,,0,0,0,,HAY HAY!\NHAY HAY!
Dialogue: 0,0:06:05.90,0:06:07.30,Main-480p,,0,0,0,,Hiç şüphesiz.
Dialogue: 0,0:06:07.30,0:06:10.01,Main-480p,,0,0,0,,Kaktüs Adası'yla aynı hizadayız.
Dialogue: 0,0:06:10.01,0:06:12.64,Main-480p,,0,0,0,,Bir sonraki hedefimiz...
Dialogue: 0,0:06:13.30,0:06:15.10,Main-480p,,0,0,0,,...o ada!
Dialogue: 0,0:06:26.20,0:06:27.90,Main-480p,,0,0,0,,Demek o!
Dialogue: 0,0:06:27.90,0:06:31.24,Main-480p,,0,0,0,,Grand Line'daki ikinci adamız!
Dialogue: 0,0:06:55.12,0:06:57.18,Main-480p,,0,0,0,,Bay 3...
Dialogue: 0,0:06:57.18,0:07:00.01,Main-480p,,0,0,0,,Şimdi ne var? Bir saniye.
Dialogue: 0,0:07:00.80,0:07:05.15,Main-480p,,0,0,0,,Gerçekten tüm çaylar \NEarl Grey'e göre daha renksiz.
Dialogue: 0,0:07:05.15,0:07:06.81,Main-480p,,0,0,0,,Sıkıldım.
Dialogue: 0,0:07:06.81,0:07:11.00,Main-480p,,0,0,0,,Sıkıldığını söyleyip duruyorsun ve\Nçalışmaktan da hiç hoşlanmıyorsun.
Dialogue: 0,0:07:11.00,0:07:11.82,Main-480p,,0,0,0,,Doğru.
Dialogue: 0,0:07:11.82,0:07:13.67,Main-480p,,0,0,0,,Bu yüzden yeni emirler alıncaya dek...
Dialogue: 0,0:07:13.69,0:07:18.27,Main-480p,,0,0,0,,...tüm yapmamız gereken \Nrahatlamak ve keyfimize bakmak.
Dialogue: 0,0:07:18.37,0:07:24.34,Main-480p,,0,0,0,,Böyle huzurlu bir tatil yapmak\Nrütbeli bir ajan olmanın özel bir ayrıcalığı.
Dialogue: 0,0:07:24.34,0:07:26.34,Main-480p,,0,0,0,,Bir şey daha...
Dialogue: 0,0:07:26.71,0:07:31.84,Captions-480p,,0,0,0,,{\pos(320,344)\fs28\bord1.3\c&H000000&\1a&HFF&\blur0.6\fad(400,500)\t(355,400,\1a&H00&)\t(4630,4675,\1a&HFF&)}Bay 3\N {\fs25}Subay, Baroque Works
Dialogue: 1,0:07:26.71,0:07:31.84,Captions-480p,,0,0,0,,{\pos(320,344)\fs28\bord0\4a&HFF&\blur0.5\fad(400,500)}Bay 3\N {\fs25}Subay, Baroque Works
Dialogue: 0,0:07:26.34,0:07:32.00,Main-480p,,0,0,5,,...halka açık yerlerde dikkatsizce\Nkod adımı kullanmayı bırak.
Dialogue: 0,0:07:32.00,0:07:36.00,Main-480p,,0,0,0,,İnsanlar gerçekten \NBay 3 olduğumu keşfedebilir.
Dialogue: 0,0:07:38.56,0:07:41.56,Captions-480p,,0,0,0,,{\pos(445,298)\bord1.3\c&H000000&\1a&HFF&\blur0.6\fad(400,0)\t(355,400,\1a&H00&)}Bayan Altın Hafta\N {\fs24}Subay, Baroque Works
Dialogue: 1,0:07:38.56,0:07:41.56,Captions-480p,,0,0,0,,{\pos(445,298)\bord0\4a&HFF&\blur0.5\fad(400,0)}Bayan Altın Hafta\N {\fs24}Subay, Baroque Works
Dialogue: 0,0:07:38.31,0:07:39.67,Main-480p,,0,0,0,,Gerçekten?
Dialogue: 0,0:07:41.56,0:07:46.52,Main-480p,,0,0,0,,Bu arada, birkaç gündür o kağıt parçasına\Nbakmaktan başka bir şey yapmadın.
Dialogue: 0,0:07:46.52,0:07:48.29,Main-480p,,0,0,0,,Nedir o?
Dialogue: 0,0:07:48.29,0:07:50.22,Main-480p,,0,0,0,,Patronun emirleri.
Dialogue: 0,0:07:50.87,0:07:52.49,Main-480p,,0,0,0,,NEDEN DAHA ÖNCE SÖYLEMEDİN?!
Dialogue: 0,0:07:55.46,0:07:58.32,Main-480p,,0,0,0,,Demek Bay 5'in icabına bakıldı.
Dialogue: 0,0:07:58.32,0:08:03.46,Main-480p,,0,0,0,,Eğer Bay 2 olsaydı, daha mutlu olurdum.
Dialogue: 0,0:08:03.46,0:08:06.46,Main-480p,,0,0,0,,Böylece rütbemiz yükselirdi.
Dialogue: 0,0:08:06.46,0:08:11.63,Main-480p,,0,0,0,,Bay 5'in yenilgisi etkileyici bir şey değil.
Dialogue: 0,0:08:11.63,0:08:18.14,Main-480p,,0,0,0,,O adam aptalca Şeytan Meyvesi gücüne\Ngüveniyor ve bu onun sonu oldu.
Dialogue: 0,0:08:18.14,0:08:22.09,Main-480p,,0,0,0,,Şeytan'ın ne tür harikulade\Ngücünü elde edersen et,...
Dialogue: 0,0:08:22.09,0:08:27.70,Main-480p,,0,0,0,,...bunda tamamen ustalaşamazsan,\Ngerçekten zavallısın demektir.
Dialogue: 0,0:08:32.57,0:08:38.77,Main-480p,,0,0,0,,Üstün bir suçlu kendi sonunu \Nelde etmek için üstün bir akıl kullanıyor.
Dialogue: 0,0:08:38.77,0:08:42.78,Main-480p,,0,0,0,,Belki de ona küçük bir şey öğretmeliyiz.
Dialogue: 0,0:08:42.78,0:08:48.04,Main-480p,,0,0,0,,Suç örgütünü düşman edinmenin\Nne kadar korkutucu olabileceğini.
Dialogue: 0,0:08:59.51,0:09:02.46,Main-480p,,0,0,0,,Demek burası Küçük Bahçe.
Dialogue: 0,0:09:02.46,0:09:04.35,Main-480p,,0,0,0,,"Küçük" derken neyi kastediyorlar?
Dialogue: 0,0:09:04.35,0:09:08.11,Main-480p,,0,0,0,,Adı kadar güzel görünmüyor.
Dialogue: 0,0:09:08.11,0:09:13.07,Main-480p,,0,0,0,,Bu aynı, keşfedilmemiş bir bölge gibi!\NYabani bir orman!
Dialogue: 0,0:09:13.07,0:09:14.80,Main-480p,,0,0,0,,Dikkatli olmalıyız.
Dialogue: 0,0:09:14.80,0:09:18.48,Main-480p,,0,0,0,,Hala Bayan Tüm-Pazar'ın\Nsöylediği konusunda endişeliyim.
Dialogue: 0,0:09:20.18,0:09:27.00,Flashbacks-480p,,0,0,0,,Ama en kötü şansınız ise\NSeyir Belirleyicinin sizi götürdüğü rota.
Dialogue: 0,0:09:27.00,0:09:28.71,Flashbacks-480p,,0,0,0,,Bir sonraki adanın adı...
Dialogue: 0,0:09:29.58,0:09:31.67,Flashbacks-480p,,0,0,0,,...Küçük Bahçe.
Dialogue: 0,0:09:32.31,0:09:35.40,Flashbacks-480p,,0,0,0,,Sizi durdurmaya çalışmasak bile,\Nasla Arabasta'ya varamadan...
Dialogue: 0,0:09:35.40,0:09:38.53,Flashbacks-480p,,0,0,0,,...yok edileceksiniz.
Dialogue: 0,0:09:39.72,0:09:43.68,Main-480p,,0,0,0,,B-B-Bu canavarlar olacağı anlamına mı geliyor?!
Dialogue: 0,0:09:43.68,0:09:45.54,Main-480p,,0,0,0,,Kim bilir?
Dialogue: 0,0:09:45.54,0:09:48.65,Main-480p,,0,0,0,,Burada durmadan bir sonraki adaya gidelim!
Dialogue: 0,0:09:48.65,0:09:51.51,Main-480p,,0,0,0,,Ama Seyir'in ayarlanması\Niçin zamana ihtiyacımız var.
Dialogue: 0,0:09:51.51,0:09:54.61,Main-480p,,0,0,0,,O ve bir de bazı tedbirler almalıyız.
Dialogue: 0,0:09:54.61,0:09:57.61,Main-480p,,0,0,0,,Geçtiğimiz kasabada yiyecek stoğu yapmadık.
Dialogue: 0,0:09:57.61,0:10:00.19,Main-480p,,0,0,0,,İleride bir nehir ağzı görüyorum!
Dialogue: 0,0:10:00.19,0:10:02.08,Main-480p,,0,0,0,,Gerçekten?
Dialogue: 0,0:10:07.04,0:10:08.94,Main-480p,,0,0,0,,Umarım burada yakiniku* dükkanı vardır~!
Dialogue: 0,0:10:08.94,0:10:10.33,Main-480p,,0,0,0,,Burada yakiniku dükkanı ne arasın?
Dialogue: 0,0:10:10.33,0:10:12.92,Main-480p,,0,0,0,,Ama stok yapmamız gerektiğini\Nsöylemedin mi?
Dialogue: 0,0:10:12.92,0:10:14.92,Main-480p,,0,0,0,,Malzeme bulmamız gerektiğini söylüyorum!!
Dialogue: 0,0:10:14.95,0:10:16.95,Main-480p,,0,0,0,,O küçük beyninden \Nne geçiyor bilmiyorum!
Dialogue: 0,0:10:16.95,0:10:19.01,Main-480p,,0,0,0,,Ama karaya çıkmak tehlikeli olacak.
Dialogue: 0,0:10:21.54,0:10:24.54,Main-480p,,0,0,0,,Yani, şu bitkilere bakın.
Dialogue: 0,0:10:24.54,0:10:26.98,Main-480p,,0,0,0,,Bunlar gördüğüm hiçbir botanik\Nkitabında yok.
Dialogue: 0,0:10:33.32,0:10:35.32,Main-480p,,0,0,0,,Çok güzel~!
Dialogue: 0,0:10:35.32,0:10:36.82,Main-480p,,0,0,0,,Beni mi kastediyorsun?
Dialogue: 0,0:10:36.82,0:10:39.49,Main-480p,,0,0,0,,TABİİ Kİ NAMI-SAN'I KASTEDİYORUM!!
Dialogue: 0,0:10:39.49,0:10:41.28,Main-480p,,0,0,0,,O da ne?
Dialogue: 0,0:10:43.00,0:10:45.69,Main-480p,,0,0,0,,Endişelenme. Sadece küçük yaşlı bir kuş.
Dialogue: 0,0:10:45.69,0:10:48.75,Main-480p,,0,0,0,,Üstelik bu sadece normal bir orman.\NEndişelenecek bir şey yok.
Dialogue: 0,0:10:51.17,0:10:52.50,Main-480p,,0,0,0,,Sorun nedir?
Dialogue: 0,0:10:58.40,0:11:00.72,Main-480p,,0,0,0,,NEYİN VAR, SENİ KAHROLASI KUŞ?!!
Dialogue: 0,0:11:00.72,0:11:03.68,Main-480p,,0,0,0,,Kertenkele? Acaba tadı nasıl?
Dialogue: 0,0:11:08.02,0:11:11.98,Main-480p,,0,0,0,,Bu normal bir ormanda duyacağın bir ses mi?
Dialogue: 0,0:11:11.98,0:11:16.61,Main-480p,,0,0,0,,Yanardağ püskürmesi sesi gibiydi!
Dialogue: 0,0:11:28.91,0:11:30.89,Main-480p,,0,0,0,,Kaplan?!
Dialogue: 0,0:11:30.89,0:11:32.41,Main-480p,,0,0,0,,Çok büyük!!
Dialogue: 0,0:11:41.63,0:11:44.70,Main-480p,,0,0,0,,Ne? Ona ne oldu?
Dialogue: 0,0:11:44.70,0:11:47.47,Main-480p,,0,0,0,,Bu hiç de normal değil.\NKesinlikle normal değil!
Dialogue: 0,0:11:48.24,0:11:51.81,Main-480p,,0,0,0,,Nasıl olur da, ormanın kralı kaplan\Nkendi kanının içine düşer?!
Dialogue: 0,0:11:54.06,0:11:58.71,Main-480p,,0,0,0,,Pekala, bu adada durmamamıza karar verildi.
Dialogue: 0,0:11:58.71,0:12:02.11,Main-480p,,0,0,0,,{\q2}Sadece gemide oturacağız ve sessiz bir\Nşekilde Seyir'in ayarlanmasını bekleyeceğiz.
Dialogue: 0,0:12:02.11,0:12:04.72,Main-480p,,0,0,0,,Böylece, buradan mümkün\Nolan en kısa sürede çıkabiliriz.
Dialogue: 0,0:12:02.11,0:12:03.05,Secondary-480p,,0,0,0,,Evet!
Dialogue: 0,0:12:04.72,0:12:05.72,Main-480p,,0,0,0,,Evet!!
Dialogue: 0,0:12:05.70,0:12:09.08,Main-480p,,0,0,0,,Bir an önce Arabasta'ya gitmeliyiz, değil mi?
Dialogue: 0,0:12:20.79,0:12:22.63,Main-480p,,0,0,0,,Sanji, yemek kutusu!
Dialogue: 0,0:12:22.63,0:12:23.59,Main-480p,,0,0,0,,Yemek kutusu mu?
Dialogue: 0,0:12:23.59,0:12:26.35,Main-480p,,0,0,0,,Evet, gücümü tazelemek için!
Dialogue: 0,0:12:26.35,0:12:29.64,Main-480p,,0,0,0,,Bir ton et ve sebze yok!\NKorsan yemek kutusu!
Dialogue: 0,0:12:29.64,0:12:31.56,Main-480p,,0,0,0,,Macera kokusu alıyorum!
Dialogue: 0,0:12:32.31,0:12:36.02,Main-480p,,0,0,0,,Dur bakalım biraz! \NNereye gittiğini sanıyorsun?
Dialogue: 0,0:12:36.02,0:12:37.56,Main-480p,,0,0,0,,Maceraya!
Dialogue: 0,0:12:37.56,0:12:40.65,Main-480p,,0,0,0,,Gelmek ister misin?\NMacera!
Dialogue: 0,0:12:40.65,0:12:43.99,Thoughts-480p,th,0,0,0,,Faydasız... Onu durduramam.\NÇok heyecanlanmış.
Dialogue: 0,0:12:44.78,0:12:46.21,Thoughts-480p,th,0,0,0,,Şaka yapıyorsun, değil mi?
Dialogue: 0,0:12:46.24,0:12:49.65,Thoughts-480p,th,0,0,0,,O dev kaplanı öldüren\Ncanavar hala orada bir yerde!
Dialogue: 0,0:12:49.95,0:12:51.99,Main-480p,,0,0,0,,Sanji, yemek kutusu!
Dialogue: 0,0:12:51.99,0:12:54.92,Main-480p,,0,0,0,,Duydum.\NBana biraz zaman ver.
Dialogue: 0,0:12:57.90,0:13:00.59,Main-480p,,0,0,0,,Hey, seninle gelebilir miyim?
Dialogue: 0,0:13:00.59,0:13:01.42,Main-480p,,0,0,0,,Ne?!
Dialogue: 0,0:13:01.42,0:13:03.00,Main-480p,,0,0,0,,Evet, gel! Gidelim!
Dialogue: 0,0:13:03.00,0:13:04.93,Main-480p,,0,0,0,,Bununla gideceğini söyleme sakın?!
Dialogue: 0,0:13:04.93,0:13:09.34,Main-480p,,0,0,0,,Evet, burada oturmaya devam edersem,\Nsadece umutsuzluğa kapılacağım.
Dialogue: 0,0:13:09.34,0:13:11.84,Main-480p,,0,0,0,,Seyir'in ayarlanmasını beklerken,\Nben de iyice rahatlayabilirim.
Dialogue: 0,0:13:11.84,0:13:15.52,Main-480p,,0,0,0,,Yapamazsın! Luffy bunu her zaman yapar\Nama senin için çok tehlikeli!
Dialogue: 0,0:13:15.52,0:13:18.15,Main-480p,,0,0,0,,İyi olacağım! \NCarue benimle birlikte olacak!
Dialogue: 0,0:13:20.86,0:13:25.20,Main-480p,,0,0,0,,Konuşamadığı için çok şaşırdı.
Dialogue: 0,0:13:25.20,0:13:28.16,Main-480p,,0,0,0,,Pekala Vivi-chan, sana özel \NAşk Yemek Kutusu hazırlayacağım!
Dialogue: 0,0:13:28.79,0:13:31.63,Main-480p,,0,0,0,,Carue için de içeceklerinden biraz\Nyapabilir misin?
Dialogue: 0,0:13:31.63,0:13:34.50,Main-480p,,0,0,0,,Elbette! Bana bırakın!
Dialogue: 0,0:13:39.50,0:13:41.30,Main-480p,,0,0,0,,Tamam!
Dialogue: 0,0:13:48.12,0:13:51.33,Main-480p,,0,0,0,,Bir korsan yemek kutusu\Nve Carue için özel içecek!
Dialogue: 0,0:13:51.36,0:13:52.68,Main-480p,,0,0,0,,Artık hazırsınız.
Dialogue: 0,0:13:52.68,0:13:53.69,Main-480p,,0,0,0,,Evet!
Dialogue: 0,0:13:58.46,0:14:00.90,Main-480p,,0,0,0,,Biz gidiyoruz!
Dialogue: 0,0:14:00.90,0:14:02.43,Main-480p,,0,0,0,,Pekala! Gidelim!
Dialogue: 0,0:14:02.43,0:14:04.99,Main-480p,,0,0,0,,Yakında döneceğiz!
Dialogue: 0,0:14:05.90,0:14:09.34,Main-480p,,0,0,0,,Cesaretli bir kız.\NBayan Çarşamba.
Dialogue: 0,0:14:09.34,0:14:12.87,Main-480p,,0,0,0,,Bir suç örgütüne sızan birinden başka ne beklersin?
Dialogue: 0,0:14:15.69,0:14:18.61,Main-480p,,0,0,0,,Pekala, benim de biraz boş\Nvaktim var. Yürüyüşe çıkacağım.
Dialogue: 0,0:14:18.61,0:14:19.71,Main-480p,,0,0,0,,YÜRÜYÜŞ MÜ?
Dialogue: 0,0:14:22.17,0:14:24.13,Main-480p,,0,0,0,,Hey, Zoro!
Dialogue: 0,0:14:24.13,0:14:25.75,Main-480p,,0,0,0,,Bekle!
Dialogue: 0,0:14:26.76,0:14:28.90,Main-480p,,0,0,0,,Yiyecek stoğumuz tükendi.
Dialogue: 0,0:14:28.90,0:14:31.72,Main-480p,,0,0,0,,Yenilebilir gibi görünen \Nbir şey görürsen buraya getir.
Dialogue: 0,0:14:31.72,0:14:33.72,Main-480p,,0,0,0,,Tamam, olur.
Dialogue: 0,0:14:33.72,0:14:38.00,Main-480p,,0,0,0,,Senin asla yakalayamayacağın \Nbir şey bulacağım.
Dialogue: 0,0:14:38.00,0:14:39.56,Main-480p,,0,0,0,,DUR BAKALIM PİSLİK!
Dialogue: 0,0:14:41.06,0:14:43.84,Main-480p,,0,0,0,,Böyle meydan okumalara pabuç bırakmam.
Dialogue: 0,0:14:43.84,0:14:48.70,Main-480p,,0,0,0,,Benimkinden daha büyük bir şey \Ngetirebileceğini mi sanıyorsun?
Dialogue: 0,0:14:49.52,0:14:50.78,Main-480p,,0,0,0,,Evet.
Dialogue: 0,0:14:56.19,0:14:57.75,Main-480p,,0,0,0,,Av Müsabakası.
Dialogue: 0,0:15:01.49,0:15:04.84,Main-480p,,0,0,0,,Dinle. Çok kilolu et getiren kazanır.
Dialogue: 0,0:15:04.84,0:15:07.05,Main-480p,,0,0,0,,Tonlarca demek istemiyor musun?
Dialogue: 0,0:15:07.05,0:15:10.32,Main-480p,,0,0,0,,Övünmeni yenilebilecekleri\Nsıraladığımız zamana sakla.
Dialogue: 0,0:15:10.32,0:15:12.06,Main-480p,,0,0,0,,Ben de öyle düşünmüştüm.
Dialogue: 0,0:15:13.47,0:15:17.38,Main-480p,,0,0,0,,Al birini vur ötekine.\NNiye hepsi böyle olmak zorunda?
Dialogue: 0,0:15:17.38,0:15:19.01,Main-480p,,0,0,0,,Nasıl hissettiğini çok iyi anlıyorum.
Dialogue: 0,0:15:19.01,0:15:22.02,Main-480p,,0,0,0,,Ağlama. Ben senden yanayım.
Dialogue: 0,0:15:27.79,0:15:29.07,Main-480p,,0,0,0,,Bizi terkettiler.
Dialogue: 0,0:15:29.07,0:15:31.31,Main-480p,,0,0,0,,Bunu ben söylemek üzereydim!
Dialogue: 0,0:15:35.66,0:15:37.58,Main-480p,,0,0,0,,Ama dur biraz.
Dialogue: 0,0:15:38.08,0:15:39.79,Main-480p,,0,0,0,,Ne oldu?
Dialogue: 0,0:15:41.84,0:15:43.74,Main-480p,,0,0,0,,N-N-N-N-Nami?!
Dialogue: 0,0:15:43.74,0:15:46.71,Main-480p,,0,0,0,,Bu değil. Bu da değil.
Dialogue: 0,0:15:46.71,0:15:49.13,Main-480p,,0,0,0,,Hey! Hey, hey! Nami, Nami!
Dialogue: 0,0:15:49.13,0:15:52.00,Main-480p,,0,0,0,,Ne arıyorsun Allah aşkına?
Dialogue: 0,0:15:52.00,0:15:54.60,Main-480p,,0,0,0,,Bu kitaplardan birinde\Nokuduğumu hatırlıyorum.
Dialogue: 0,0:15:55.49,0:15:56.85,Main-480p,,0,0,0,,Neyi?
Dialogue: 0,0:15:56.85,0:15:58.52,Main-480p,,0,0,0,,Küçük Bahçe.
Dialogue: 0,0:16:01.90,0:16:03.01,Main-480p,,0,0,0,,Ne oldu?
Dialogue: 0,0:16:03.01,0:16:06.80,Main-480p,,0,0,0,,Bak! Şuna bak! \NKabuklu bir kalamar gibi görünüyor.
Dialogue: 0,0:16:10.60,0:16:11.78,Main-480p,,0,0,0,,Kabuklu Kalamar.
Dialogue: 0,0:16:12.60,0:16:15.65,Main-480p,,0,0,0,,Fosil gibi görünüyor.
Dialogue: 0,0:16:15.65,0:16:16.78,Main-480p,,0,0,0,,Kabuklu kalamar, değil mi?
Dialogue: 0,0:16:28.90,0:16:32.24,Main-480p,,0,0,0,,İzlendiğimi hissediyorum.
Dialogue: 0,0:16:32.24,0:16:33.72,Main-480p,,0,0,0,,Neyse, bana öyle geliyor olmalı.
Dialogue: 0,0:16:50.23,0:16:51.94,Main-480p,,0,0,0,,Benimle oyun oynuyorsun, ha?
Dialogue: 0,0:16:53.49,0:16:56.02,Main-480p,a,0,0,0,,{\fad(150,150)}COLLER VURUŞ!
Dialogue: 0,0:17:07.85,0:17:11.38,Main-480p,,0,0,0,,Bu da ne böyle?\NYenir mi acaba?
Dialogue: 0,0:17:13.01,0:17:16.22,Main-480p,,0,0,0,,Bir bakalım... Hangisindeydi?
Dialogue: 0,0:17:16.22,0:17:20.68,Main-480p,,0,0,0,,Sanki yakın zamanda okumuşum gibi.\NOnunla ne yaptım ben?
Dialogue: 0,0:17:27.01,0:17:30.70,Main-480p,,0,0,0,,Niye karada yürüyen bir Deniz Kralı var?
Dialogue: 0,0:17:35.28,0:17:36.61,Main-480p,,0,0,0,,DİNOZOR!!
Dialogue: 0,0:17:36.61,0:17:37.86,Main-480p,,0,0,0,,DİNOZOR MU?!
Dialogue: 0,0:17:37.86,0:17:40.85,Main-480p,,0,0,0,,Öyleyse... burası tarih öncesi\Nadalardan biri olmalı!
Dialogue: 0,0:17:41.83,0:17:45.79,Main-480p,,0,0,0,,Bu ada hala dinozorlar çağında!
Dialogue: 0,0:17:47.75,0:17:52.25,Main-480p,,0,0,0,,Grand Line adalarının yön\Nbelirleme zorluğu sebebiyle...
Dialogue: 0,0:17:52.25,0:17:54.85,Main-480p,,0,0,0,,...farklı adalar nadiren birbiriyle karışır.
Dialogue: 0,0:17:54.85,0:17:58.97,Main-480p,,0,0,0,,Her ada kendisine has gelişim\Nşekliyle bırakılır.
Dialogue: 0,0:17:58.97,0:18:02.73,Main-480p,,0,0,0,,Bu nedenle hayalin ötesinde\Nuygarlıklar içeren adalar vardır.
Dialogue: 0,0:18:03.93,0:18:06.69,Main-480p,,0,0,0,,Ayrıca, yüz binlerce yıl boyunca...
Dialogue: 0,0:18:06.69,0:18:11.00,Main-480p,,0,0,0,,...izole olmuş şekilde,\Nasıl hallerini muhafaza eden adalar da var!
Dialogue: 0,0:18:14.54,0:18:18.36,Main-480p,,0,0,0,,Grand Line'ın tahmin edilmesi mümkün\Nolmayan iklimi bunu mümkün kılıyor.
Dialogue: 0,0:18:18.36,0:18:23.70,Main-480p,,0,0,0,,Bu ada gerçekten hala dinozorlar çağında!
Dialogue: 0,0:18:24.33,0:18:25.83,Main-480p,,0,0,0,,MÜTHİŞ!
Dialogue: 0,0:18:30.79,0:18:32.79,Main-480p,,0,0,0,,ONA TIRMANMA!
Dialogue: 0,0:18:34.48,0:18:37.23,Main-480p,,0,0,0,,Usopp!\NUsopp!
Dialogue: 0,0:18:37.23,0:18:39.43,Main-480p,,0,0,0,,Ne? Ne oldu?
Dialogue: 0,0:18:39.43,0:18:41.39,Main-480p,,0,0,0,,Kitabı buldun mu?
Dialogue: 0,0:18:57.15,0:19:00.03,Main-480p,,0,0,0,,Bu korkunç! Bu ada...
Dialogue: 0,0:19:22.39,0:19:27.27,Main-480p,,0,0,0,,Ne? Sanki Nami-san'ın beni\Nçağırdığını duydum.
Dialogue: 0,0:19:30.91,0:19:36.68,Narrator-480p,,0,0,0,,Burada yaşayan insanlar için\Nada aynı küçük bir bahçe gibi.
Dialogue: 0,0:19:37.93,0:19:39.45,Narrator-480p,,0,0,0,,"Küçük Bahçe"...
Dialogue: 0,0:19:40.26,0:19:42.55,Narrator-480p,,0,0,0,,...bu yeri böyle adlandıracağız.
Dialogue: 0,0:19:43.30,0:19:45.90,Narrator-480p,,0,0,0,,Yolculuk Lideri, Louis Arnote
Dialogue: 0,0:20:01.34,0:20:04.51,Captions-480p,,0,0,0,,{\pos(325,298)\bord1.3\c&H000000&\1a&HFF&\blur0.5\fad(350,0)\t(305,350,\1a&H00&)}Dev Broggy
Dialogue: 1,0:20:01.34,0:20:04.51,Captions-480p,,0,0,0,,{\pos(325,298)\bord0\4a&HFF&\blur0.5\fad(350,0)}Dev Broggy
Dialogue: 0,0:20:03.11,0:20:04.51,Main-480p,,0,0,0,,Evet?
Dialogue: 0,0:20:05.20,0:20:09.68,Main-480p,,0,0,0,,A-Afedersiniz?\NB-Bunu bir kez daha söyleyebilir misiniz?
Dialogue: 0,0:20:10.82,0:20:13.65,Main-480p,,0,0,0,,Hiç biranız var mı diye sordum.
Dialogue: 0,0:20:15.19,0:20:16.48,Main-480p,,0,0,0,,Biraz olabilir.
Dialogue: 0,0:20:16.48,0:20:19.05,Main-480p,,0,0,0,,Oh! Biraz var mı?
Dialogue: 0,0:20:19.05,0:20:23.45,Main-480p,,0,0,0,,S-Son zamanlarda pek ihtiyaç duymadık,\Narada bir yemek pişirirken lazım oluyor.
Dialogue: 0,0:20:23.45,0:20:26.66,Main-480p,,0,0,0,,Ama istiyorsanız, hepsini alabilirsiniz!
Dialogue: 0,0:20:33.68,0:20:35.01,Main-480p,,0,0,0,,Dino...
Dialogue: 0,0:20:35.01,0:20:36.38,Main-480p,,0,0,0,,Bir dinozor.
Dialogue: 0,0:20:51.36,0:20:56.97,Main-480p,,0,0,0,,BEN ELBAF'IN YENİLMEZ SAVAŞÇISI BROGGY'İM!
Dialogue: 0,0:21:02.19,0:21:06.16,Main-480p,,0,0,0,,Şimdi biraz etim oldu.\NMisafirim olarak bana katılın.
Dialogue: 0,0:21:11.78,0:21:13.29,Main-480p,,0,0,0,,Hey.
Dialogue: 0,0:21:13.29,0:21:17.39,Main-480p,,0,0,0,,Ö-Ölmüş numarası yap.\NNe yaparsa yapsın.
Dialogue: 0,0:21:17.39,0:21:21.84,Main-480p,,0,0,0,,A-Ama o ayı değil. Ölü rolü yapmanın\Nişe yarayacağına emin misin?
Dialogue: 0,0:21:30.33,0:21:35.73,Main-480p,,0,0,0,,Üfff be, ne harika bir manzara!
Dialogue: 0,0:21:35.73,0:21:39.23,Main-480p,,0,0,0,,Burası yemeğimi yemek için harika\Nbir yer olmalı.
Dialogue: 0,0:21:39.23,0:21:42.61,Main-480p,,0,0,0,,Nasıl bu kadar umursamaz olabilirsin?
Dialogue: 0,0:21:42.61,0:21:47.36,Main-480p,,0,0,0,,Demek burada gerçekten yanardağlar var.
Dialogue: 0,0:21:47.36,0:21:51.37,Main-480p,,0,0,0,,Orada dev gibi delikli bir dağ var!
Dialogue: 0,0:22:04.46,0:22:07.47,Main-480p,,0,0,0,,O yenildi!
Dialogue: 0,0:22:09.01,0:22:10.97,Main-480p,,0,0,0,,Neredeyim ben?
Dialogue: 0,0:22:54.78,0:22:56.45,Main-480p,,0,0,0,,Seni seyrediyordum!
Dialogue: 0,0:22:53.39,0:22:59.77,Captions-480p,,0,0,0,,{\pos(163,299)\bord1.3\c&H000000&\1a&HFF&\blur0.5\fad(500,450)\t(455,500,\1a&H00&)\t(5930,5975,\1a&HFF&)}Dev Dorry
Dialogue: 1,0:22:53.39,0:22:59.77,Captions-480p,,0,0,0,,{\pos(163,299)\bord0\4a&HFF&\blur0.5\fad(500,450)}Dev Dorry
Dialogue: 0,0:22:56.45,0:23:01.60,Main-480p,,0,0,0,,Ormandaki Uzun Boyunlar'la oynuyordun.\NNe hayat dolu küçük bir insan!
Dialogue: 0,0:23:01.60,0:23:03.73,Main-480p,,0,0,0,,Ziyaretçim olmayalı uzun zaman oldu.
Dialogue: 0,0:23:03.73,0:23:06.69,Main-480p,,0,0,0,,Vay canına, DEV gibisin!\NSen insan mısın?
Dialogue: 0,0:23:08.65,0:23:13.43,Main-480p,,0,0,0,,BEN, ELBAF'IN YENİLMEZ\NSAVAŞÇISI DORRY'İM!
Dialogue: 0,0:23:16.34,0:23:18.58,Main-480p,,0,0,0,,B-Bu bir dev.
Dialogue: 0,0:23:18.58,0:23:23.54,Main-480p,,0,0,0,,Gerçeğini hiç görmemiştim.\NOnları sadece hikayelerde duymuştum.
Dialogue: 0,0:23:23.54,0:23:26.30,Main-480p,,0,0,0,,Ben Luffy. Korsanım!
Dialogue: 0,0:23:27.90,0:23:30.86,Main-480p,,0,0,0,,Korsan mı? Bu harika!
Dialogue: 0,0:23:31.80,0:23:33.44,Main-480p,,0,0,0,,Carue, uyan!
Dialogue: 0,0:23:33.44,0:23:35.26,Main-480p,,0,0,0,,Çok geç olmadan kaçalım!
Dialogue: 0,0:23:35.26,0:23:39.23,Main-480p,,0,0,0,,Ah, oradakileri görüyor musun? Onlar\NVivi ve Carue. Merhaba deyin çocuklar!
Dialogue: 0,0:23:39.23,0:23:43.19,Main-480p,,0,0,0,,Luffy-san, niye söyledin?
Dialogue: 0,0:23:45.18,0:23:48.15,Main-480p,,0,0,0,,Hey, size mekanımı göstermeme izin verin.
Dialogue: 0,0:24:09.63,0:24:13.89,Main-480p,,0,0,0,,Tamam, hadi yiyelim!\NDinazor eti gerçekten iyi!
Dialogue: 0,0:24:16.19,0:24:18.60,Main-480p,,0,0,0,,İ-İştahımı yitirdim.
Dialogue: 0,0:24:18.60,0:24:21.27,Main-480p,,0,0,0,,Çekinmeyin! Yumulun!
Dialogue: 0,0:24:22.71,0:24:25.27,Main-480p,,0,0,0,,Onu yemek istemiyoruz.\NOnu yemek istemiyoruz.
Dialogue: 0,0:24:26.64,0:24:30.53,Main-480p,,0,0,0,,Ama bu dinazor eti çok iyi!
Dialogue: 0,0:24:31.65,0:24:34.65,Main-480p,,0,0,0,,İlk önce bize dinazor etini yedirecek ve...
Dialogue: 0,0:24:34.65,0:24:36.64,Main-480p,,0,0,0,,...bu bizi şişmanlatacak.
Dialogue: 0,0:24:36.64,0:24:38.47,Main-480p,,0,0,0,,Sonra bizi de yiyecek.
Dialogue: 0,0:24:38.47,0:24:41.04,Main-480p,,0,0,0,,Evet, devler böyle yapar.
Dialogue: 0,0:24:41.04,0:24:43.49,Main-480p,,0,0,0,,Çok genciz.
Dialogue: 0,0:24:43.49,0:24:45.45,Main-480p,,0,0,0,,Belki de bu yenilebileceğimiz en iyi zaman.
Dialogue: 0,0:24:45.45,0:24:48.17,Main-480p,,0,0,0,,Ne yazık ama.
Dialogue: 0,0:24:48.17,0:24:50.64,Main-480p,,0,0,0,,Gerçekten lezzetli.
Dialogue: 0,0:24:52.17,0:24:56.26,Main-480p,,0,0,0,,Seyir ayarlanana dek kendimizi aç bırakırsak ve zayıf tutarsak,...
Dialogue: 0,0:24:56.26,0:24:57.43,Main-480p,,0,0,0,,...hayatta kalabiliriz.
Dialogue: 0,0:24:57.43,0:25:01.01,Main-480p,,0,0,0,,Ama seyirin ayarlanması ne kadar sürecek?
Dialogue: 0,0:25:01.01,0:25:07.36,Main-480p,,0,0,0,,Et çok güzel kokuyor, kısa süre\Nsonra kendimi kontrol edemeyeceğim.
Dialogue: 0,0:25:07.36,0:25:11.26,Main-480p,,0,0,0,,Brogy-san, size küçük bir soru sorabilir miyim?
Dialogue: 0,0:25:11.26,0:25:15.01,Main-480p,,0,0,0,,Sorun nedir, küçük kız?
Dialogue: 0,0:25:15.01,0:25:18.32,Main-480p,,0,0,0,,Bu adada seyirin ayarlanması\Nne kadar sürer, biliyor musunuz?
Dialogue: 0,0:25:19.10,0:25:20.36,Main-480p,,0,0,0,,Bir yıl.
Dialogue: 0,0:25:20.36,0:25:21.73,Main-480p,,0,0,0,,Ne?!
Dialogue: 0,0:25:23.29,0:25:28.50,Main-480p,,0,0,0,,Hayır! Koca bir yıl boyunca \Naç kalmamız mümkün değil.
Dialogue: 0,0:25:28.50,0:25:31.46,Main-480p,,0,0,0,,Kendimi... kontrol edemeyeceğim.
Dialogue: 0,0:25:31.46,0:25:34.33,Main-480p,,0,0,0,,Bu yüzden keyfinize bakın!
Dialogue: 0,0:25:46.80,0:25:49.40,Main-480p,,0,0,0,,Bu harika, dev amca!
Dialogue: 0,0:25:49.40,0:25:53.00,Main-480p,,0,0,0,,Küçük korsan yemek kutusu da\Nfena değildi.
Dialogue: 0,0:25:53.03,0:25:55.15,Main-480p,,0,0,0,,Ama biraz küçüktü!
Dialogue: 0,0:25:56.15,0:25:58.24,Main-480p,,0,0,0,,Gerçekten!
Dialogue: 0,0:25:58.24,0:26:02.01,Main-480p,,0,0,0,,O korsan gemimin aşçısı\Ntarafından yapılmış özel bir yemekti!
Dialogue: 0,0:26:02.01,0:26:04.08,Main-480p,,0,0,0,,Kötü deseydin, seni mahvederdim.
Dialogue: 0,0:26:04.08,0:26:06.92,Main-480p,,0,0,0,,Mahveder miydin?
Dialogue: 0,0:26:10.01,0:26:12.35,Main-480p,,0,0,0,,Ne komik küçük bir adam!
Dialogue: 0,0:26:12.35,0:26:14.59,Main-480p,,0,0,0,,Birbirleriyle çok arkadaşçalar.
Dialogue: 0,0:26:14.59,0:26:18.55,Main-480p,,0,0,0,,Her neyse. \NAmca, burada niye yalnız yaşıyorsun?
Dialogue: 0,0:26:18.55,0:26:20.36,Main-480p,,0,0,0,,Köyün falan yok mu?
Dialogue: 0,0:26:20.36,0:26:25.30,Main-480p,,0,0,0,,Evet, bir köyüm var.\NSavaşçılar Köyü, Elbaf.
Dialogue: 0,0:26:25.30,0:26:27.63,Main-480p,,0,0,0,,Grand Line'da bir yerde.
Dialogue: 0,0:26:28.39,0:26:31.40,Main-480p,,0,0,0,,Ama, köyümüzün kanunları vardır.
Dialogue: 0,0:26:32.40,0:26:33.40,Main-480p,,0,0,0,,Kanunlar mı?
Dialogue: 0,0:26:33.40,0:26:37.72,Main-480p,,0,0,0,,Örneğin: Bir dövüşü sonuçlandırmak\Niçin rakipler köyden ayrılmalı...
Dialogue: 0,0:26:37.72,0:26:40.78,Main-480p,,0,0,0,,...ve Elbaf'ın tanrısının hükmünü kabul etmeli.
Dialogue: 0,0:26:40.78,0:26:44.34,Main-480p,,0,0,0,,Elbaf'ın tanrısı haklı bir kazanana\Nkutsal bir koruma bahşeder.
Dialogue: 0,0:26:44.34,0:26:46.77,Main-480p,,0,0,0,,O haklı kazananın yaşamasına izin verilir.
Dialogue: 0,0:26:46.77,0:26:49.32,Main-480p,,0,0,0,,Elbaf'ın tanrısı mı?
Dialogue: 0,0:26:49.32,0:26:52.19,Main-480p,,0,0,0,,Evet, uzun süreli bir mücadeleye başladım.
Dialogue: 0,0:26:52.19,0:26:56.33,Main-480p,,0,0,0,,Bugüne dek başka bir adam ve ben bu\Nadayı düello alanımız olarak kullandık.
Dialogue: 0,0:26:56.33,0:27:00.13,Main-480p,,0,0,0,,Haklı kazanan galip gelmeli ve\Nhayatta kalmalı.
Dialogue: 0,0:27:01.00,0:27:04.94,Main-480p,,0,0,0,,Ama 100 yıl oldu ve \Nhala bir sonuca vardıramadık!
Dialogue: 0,0:27:05.77,0:27:08.10,Main-480p,,0,0,0,,Siz 100 yıldır dövüşüyor muydunuz?!
Dialogue: 0,0:27:08.83,0:27:15.31,Main-480p,,0,0,0,,{\q2}Şaşırdın mı? Şaşılacak bir şey değil.\NBiz siz ufaklıklardan 3 kat daha uzun yaşarız.
Dialogue: 0,0:27:16.44,0:27:18.68,Main-480p,,0,0,0,,Üç kat daha uzun yaşasanız bile...
Dialogue: 0,0:27:18.68,0:27:21.66,Main-480p,,0,0,0,,...100 yıldır dövüşüyorsunuz?!\NBundan yorulmuş olmanız gerekmez mi?
Dialogue: 0,0:27:21.66,0:27:24.33,Main-480p,,0,0,0,,Hala dövüşe devam etmenin\Nbir sebebi var mı?
Dialogue: 0,0:27:24.33,0:27:26.25,Main-480p,,0,0,0,,Ölümüne bir dövüş, değil mi?
Dialogue: 0,0:27:33.50,0:27:35.96,Main-480p,,0,0,0,,Bu büyük bir patlama!
Dialogue: 0,0:27:35.96,0:27:38.72,Main-480p,,0,0,0,,Gitme vakti.
Dialogue: 0,0:27:50.56,0:27:52.04,Main-480p,,0,0,0,,O da ne?
Dialogue: 0,0:27:52.04,0:27:53.52,Main-480p,,0,0,0,,Yanardağ patlaması.
Dialogue: 0,0:28:00.45,0:28:04.41,Thoughts-480p,th,0,0,0,,Aniden gözlerinde uzak bir bakış belirdi.
Dialogue: 0,0:28:04.41,0:28:09.08,Main-480p,,0,0,0,,Bunun için üzgünüm.\NGitmeliyim.
Dialogue: 0,0:28:09.08,0:28:11.50,Main-480p,,0,0,0,,Eh? Gitmek mi?
Dialogue: 0,0:28:11.50,0:28:16.96,Main-480p,,0,0,0,,Evet. Bu yüz yıllık dövüşümüzün işareti.
Dialogue: 0,0:28:16.96,0:28:18.33,Main-480p,,0,0,0,,Dövüş?
Dialogue: 0,0:28:18.33,0:28:21.27,Main-480p,,0,0,0,,Kime karşı? Nerede?\NNe sebeple?
Dialogue: 0,0:28:21.27,0:28:24.78,Main-480p,,0,0,0,,Sebep?\NUNUTTUM!
Dialogue: 0,0:28:27.85,0:28:30.85,Main-480p,,0,0,0,,Ne zaman karar verdiğimizi unuttum.
Dialogue: 0,0:28:30.85,0:28:35.31,Main-480p,,0,0,0,,Merkezdeki dağın patlaması,\Ndövüşümüzün başlama işareti.
Dialogue: 0,0:28:36.02,0:28:37.06,Main-480p,,0,0,0,,Ama o...!
Dialogue: 0,0:28:37.19,0:28:40.93,Main-480p,,0,0,0,,Yüz yıl boyunca ölümüne\Ndövüşecek kadar birinden nefret etmek!
Dialogue: 0,0:28:41.03,0:28:43.99,Main-480p,,0,0,0,,Ne sebepten ötürü dövüşüyor olabilirsiniz?!
Dialogue: 0,0:28:43.99,0:28:45.37,Main-480p,,0,0,0,,Karışma.
Dialogue: 0,0:28:46.61,0:28:48.28,Main-480p,,0,0,0,,Ne hakkında olduğuyla ilgili değil.
Dialogue: 0,0:28:55.29,0:28:57.71,Main-480p,,0,0,0,,Aynen öyle. Bu ŞEREF'le ilgili!
Dialogue: 0,0:29:05.93,0:29:08.89,Main-480p,,0,0,0,,SEBEP?!
Dialogue: 0,0:29:10.51,0:29:13.43,Main-480p,,0,0,0,,YILLAR ÖNCE UNUTTUM!
