Dialogue: 0,0:00:13.10,0:00:14.63,Main-480p,,0,0,0,,{\i1}Miras kalan istek...
Dialogue: 0,0:00:14.63,0:00:17.54,Main-480p,,0,0,0,,{\i1}Çağın kaderi ve insanların hayalleri...
Dialogue: 0,0:00:17.54,0:00:20.37,Main-480p,,0,0,0,,{\i1}Bunlar durdurulmayacak şeyler.
Dialogue: 0,0:00:20.37,0:00:23.48,Main-480p,,0,0,0,,{\i1}İnsanlar özgürlüğün manasını takip\Netmeye devam ettiği sürece,...
Dialogue: 0,0:00:23.48,0:00:26.11,Main-480p,,0,0,0,,{\i1}...bu şeyler asla sona ermeyecek!
Dialogue: 0,0:00:34.82,0:00:37.92,Lyrics,,0,0,0,karaoke,♪ Gelecekte yalnızlığa inanıyorum ve...
Dialogue: 0,0:00:37.94,0:00:41.04,Lyrics,,0,0,0,karaoke, ...bunun için diğer insanlar \Nbana gülse de umrumda değil. ♪
Dialogue: 0,0:00:41.08,0:00:46.56,Lyrics,,0,0,0,karaoke,♪ Çılgınca koşan tutkun, parlamanı sağlıyor. ♪
Dialogue: 0,0:00:46.58,0:00:52.10,Lyrics,,0,0,0,karaoke,♪ Beni kör ediyorsun, \Nama yine de seyretmek istiyorum. ♪
Dialogue: 0,0:00:52.44,0:00:56.08,Lyrics,,0,0,0,karaoke,♪ Bir şekilde, bana güzellik hissi veriyorsun. ♪
Dialogue: 0,0:00:56.14,0:00:59.35,Lyrics,,0,0,0,,♪ Sana gerçekten, gerçekten tutuldum. ♪
Dialogue: 0,0:00:59.44,0:01:02.70,Lyrics,,0,0,0,karaoke,♪ Bir benzeri daha olmayan bir rüyanın sonunu,...
Dialogue: 0,0:01:02.70,0:01:05.99,Lyrics,,0,0,0,karaoke,...tekrar, tekrar takip edeceğim. ♪
Dialogue: 0,0:01:05.99,0:01:09.22,Lyrics,,0,0,0,karaoke,♪ O dramatik ânı, elime geçirinceye dek. ♪
Dialogue: 0,0:01:09.52,0:01:15.09,Lyrics,,0,0,0,,♪ Hayaller ülkesine inan! ♪
Dialogue: 0,0:01:18.08,0:01:21.12,Lyrics,,0,0,0,karaoke,♪ Bir diğerine benzemeyen, bir rüyanın şeklini...
Dialogue: 0,0:01:21.22,0:01:24.20,Lyrics,,0,0,0,karaoke,...tekrar, tekrar yakalayacağım. ♪
Dialogue: 0,0:01:24.48,0:01:30.22,Lyrics,,0,0,0,karaoke,♪ O sıcacık hissi takip ediyor olacağım. ♪
Dialogue: 0,0:01:30.46,0:01:33.58,Lyrics,,0,0,0,karaoke,♪ Geliri gidere eşitlemeyi ya da her günkü...
Dialogue: 0,0:01:33.66,0:01:36.85,Lyrics,,0,0,0,karaoke,...hayatı yaşamayı umursamıyorum. ♪
Dialogue: 0,0:01:36.86,0:01:40.45,Lyrics,,0,0,0,karaoke,♪ Cennete doğru koşuyorum. ♪
Dialogue: 0,0:01:40.45,0:01:45.98,Lyrics,,0,0,0,,♪ Hayaller ülkesine inan! ♪
