Dialogue: 0,0:01:57.09,0:02:01.68,Title-480p,,0,0,0,,{\c&H000000&\1a&HFF&\blur0.6\fad(800,0)\t(500,800,\1a&H00&)}Dorry ve Brogy
Dialogue: 1,0:01:57.09,0:02:01.68,Title-480p,,0,0,0,,{\bord0\4a&HFF&\blur0.5\fad(800,0)}Dorry ve Brogy
Dialogue: 5,0:02:08.50,0:02:10.44,Main-480p,,0,0,0,,S-Sorun nedir?
Dialogue: 5,0:02:12.60,0:02:15.90,Main-480p,,0,0,0,,İnanılmaz. Çok büyükler!
Dialogue: 5,0:03:08.16,0:03:10.21,Main-480p,,0,0,0,,Darbeyi miğferine aldı!
Dialogue: 5,0:03:10.21,0:03:13.67,Main-480p,,0,0,0,,Biraz bile kaysaydı, kesin ölüm olurdu!
Dialogue: 5,0:03:30.10,0:03:32.39,Main-480p,,0,0,0,,Ne dövüş ama...
Dialogue: 5,0:03:32.39,0:03:38.53,Main-480p,,0,0,0,,Her saldırı yaşamsal bir noktaya,\Nölümcül bir vuruş hedefliyor!
Dialogue: 5,0:03:38.53,0:03:43.95,Main-480p,,0,0,0,,O ikisi bu şekilde yüz yıldır\Nbirbirini öldürmeye mi çalışıyordu?
Dialogue: 5,0:03:45.03,0:03:49.62,Main-480p,,0,0,0,,Ama bu iyi bir şey! \NŞimdi kaçabiliriz, değil mi? Gidelim.
Dialogue: 5,0:03:59.38,0:04:00.55,Main-480p,,0,0,0,,Usopp?
Dialogue: 5,0:04:03.88,0:04:05.26,Main-480p,,0,0,0,,Müthiş...
Dialogue: 5,0:04:07.05,0:04:09.14,Flashbacks-480p,,0,0,0,,Sebep?
Dialogue: 5,0:04:09.14,0:04:10.89,Flashbacks-480p,,0,0,0,,Unuttum!
Dialogue: 5,0:04:17.69,0:04:21.40,Main-480p,,0,0,0,,Bir sebepleri yok.\NYine de bu şekilde dövüşüyorlar.
Dialogue: 5,0:04:22.24,0:04:25.07,Main-480p,,0,0,0,,Ne manasız bir dövüş.
Dialogue: 5,0:04:25.07,0:04:26.12,Main-480p,,0,0,0,,Aptal!
Dialogue: 5,0:04:26.12,0:04:29.83,Main-480p,,0,0,0,,Bu gerçek bir erkek dövüşü.
Dialogue: 5,0:04:31.04,0:04:32.20,Main-480p,,0,0,0,,Bu ne demek oluyor?
Dialogue: 5,0:04:33.04,0:04:39.96,Main-480p,,0,0,0,,İkisi de göğüslerinde bir savaşçının\Nbayrağını büyütmüş gibiler.
Dialogue: 5,0:04:39.96,0:04:43.84,Main-480p,,0,0,0,,Ve o bayrak, onlar için\Nhayatlarından bile daha önemli.
Dialogue: 5,0:04:44.68,0:04:46.93,Main-480p,,0,0,0,,Asla ele geçirilmesine izin vermeyecekler.
Dialogue: 5,0:04:46.93,0:04:51.47,Main-480p,,0,0,0,,Bu yüzden yüz yıldır dövüşüyorlar.
Dialogue: 5,0:04:54.73,0:04:57.48,Main-480p,,0,0,0,,Anlamıyor musun?\NBu bir öfke savaşı değil.
Dialogue: 5,0:04:57.48,0:05:01.28,Main-480p,,0,0,0,,Savaşçı onurları için bir düello!
Dialogue: 5,0:05:03.32,0:05:06.95,Main-480p,,0,0,0,,Her neyse. Niye öyle aptalca\Nbir şeyi umursayayım?
Dialogue: 5,0:05:06.95,0:05:08.16,Main-480p,,0,0,0,,Harekete geçelim!
Dialogue: 5,0:05:08.16,0:05:10.12,Main-480p,,0,0,0,,Biraz daha seyredeceğim.
Dialogue: 5,0:05:12.20,0:05:18.17,Main-480p,,0,0,0,,{\q2}Bu kesinlikle o.\NOlmak istediğim "Denizin Cesur Savaşçısı"!
Dialogue: 5,0:05:18.17,0:05:22.13,Main-480p,,0,0,0,,Bu tür şerefli bir savaşçı olmak istiyorum!
Dialogue: 5,0:05:28.47,0:05:32.51,Main-480p,,0,0,0,,Hımm? Demek dev olmak istiyorsun?
Dialogue: 5,0:05:33.31,0:05:36.69,Main-480p,,0,0,0,,HAYIR! Söylediğim tek bir kelimeyi\Nbile dinliyor muydun?!
Dialogue: 5,0:05:36.69,0:05:39.61,Main-480p,,0,0,0,,Onları seyrediyor olman gerekmiyor mu?
Dialogue: 5,0:05:45.24,0:05:48.32,Main-480p,,0,0,0,,O savaşçıların bir köyü varsa...
Dialogue: 5,0:05:48.32,0:05:50.91,Main-480p,,0,0,0,,...bir gün orayı gerçekten görmek isterim!
Dialogue: 5,0:06:05.21,0:06:11.22,Main-480p,,0,0,0,,İkimiz de... evimizi özlüyoruz,\Ndeğil mi Dorry?
Dialogue: 5,0:06:12.60,0:06:19.35,Main-480p,,0,0,0,,Bu yüzden seni yendikten sonra\NElbaf'a döneceğim.
Dialogue: 5,0:06:34.95,0:06:38.50,Main-480p,,0,0,0,,73,466 dövüş...
Dialogue: 5,0:06:38.50,0:06:43.50,Main-480p,,0,0,0,,73,466 beraberlik...
Dialogue: 5,0:07:13.20,0:07:16.54,Main-480p,,0,0,0,,Hey. Çekil yolumdan, seni koca kertenkele.
Dialogue: 5,0:07:18.75,0:07:20.50,Main-480p,,0,0,0,,Bunu bana bırak.
Dialogue: 5,0:07:23.00,0:07:24.96,Main-480p,,0,0,0,,{\fad(150,150)}10,000 KİLO BASKI!
Dialogue: 5,0:07:38.10,0:07:40.81,Main-480p,,0,0,0,,Ah, Bay 5.
Dialogue: 5,0:07:42.60,0:07:44.48,Main-480p,,0,0,0,,Küçük, güzel bir gücünüz var.
Dialogue: 5,0:07:44.48,0:07:47.32,Main-480p,,0,0,0,,Ormanda hazır bir saklanma yeri.
Dialogue: 5,0:07:47.32,0:07:50.44,Main-480p,,0,0,0,,Ama bildiğiniz gibi bu hala\Nbizim görevlendirmemiz.
Dialogue: 5,0:07:50.44,0:07:52.99,Main-480p,,0,0,0,,Buna karışmamanızı istiyoruz.
Dialogue: 5,0:07:52.99,0:07:55.78,Main-480p,,0,0,0,,Daha fazla gaf olmayacak.
Dialogue: 5,0:07:55.78,0:07:57.28,Main-480p,,0,0,0,,Gaf?
Dialogue: 5,0:07:57.28,0:08:04.12,Main-480p,,0,0,0,,Pek değil. Siz açıkçası güçsüzsünüz\NBay 5, Bayan Valentine.
Dialogue: 5,0:08:06.71,0:08:11.05,Main-480p,,0,0,0,,O kadar kızgın bakmayın.\NŞu aranan posterine bakın.
Dialogue: 5,0:08:12.22,0:08:21.02,Main-480p,,0,0,0,,Bana bu adaya gelme fırsatı\Nverdiğiniz için ikinize teşekkür etmeliyim.
Dialogue: 5,0:08:21.81,0:08:25.85,Main-480p,,0,0,0,[3-liner],Dev Savaşçı Korsanlar; \NMavi Ogre Dorry ve Kırmızı Ogre Brogy.
Dialogue: 5,0:08:26.81,0:08:29.11,Main-480p,,0,0,0,,Onlarla ilgili efsaneler duymuştum.
Dialogue: 5,0:08:29.11,0:08:31.69,Main-480p,,0,0,0,,Bu aranan posteri yüz yıllık, değil mi?
Dialogue: 5,0:08:31.69,0:08:36.95,Main-480p,,0,0,0,,Evet, ama bu adada yaşıyorlar.
Dialogue: 5,0:08:36.95,0:08:40.83,Main-480p,,0,0,0,,O zamanlar yüz milyon beli değerindeydiler.
Dialogue: 5,0:08:40.83,0:08:43.58,Main-480p,,0,0,0,,İkisi birlikte iki yüz milyon beli.
Dialogue: 5,0:08:43.58,0:08:48.34,Main-480p,,0,0,0,,İki yüz milyonluk bir ödül mü?\NAma devlerle dövüşüyor olacaksın!
Dialogue: 5,0:08:48.34,0:08:54.80,Main-480p,,0,0,0,,Üstün bir suçlu suçlarını işlemek için, \Nüstün bir zeka kullanır.
Dialogue: 5,0:08:54.80,0:08:58.39,Main-480p,,0,0,0,,İkiniz sadece emirlerime uymalısınız.
Dialogue: 5,0:08:58.39,0:09:04.10,Main-480p,,0,0,0,,Uygun bir planla herhangi\Nbir dağ düz edilebilir.
Dialogue: 5,0:09:26.33,0:09:29.46,Main-480p,,0,0,0,,Bil bakalım ne oldu, Dorry! \Nİki küçük ziyaretçiden biraz bira aldım!
Dialogue: 5,0:09:29.46,0:09:34.92,Main-480p,,0,0,0,,Güzel! Epeydir içmemiştim!\NBana da biraz ver!
Dialogue: 5,0:09:42.31,0:09:46.48,Main-480p,,0,0,0,,Yani oradaki küçük cüceler,\Narkadaşların mı?
Dialogue: 5,0:09:46.48,0:09:49.69,Main-480p,,0,0,0,,Uzun burunlu bir adam ve bir kadın var.
Dialogue: 5,0:09:49.69,0:09:51.27,Main-480p,,0,0,0,,Usopp ve Nami!
Dialogue: 5,0:09:51.27,0:09:54.36,Main-480p,,0,0,0,,Bu da ne? Gemiden ayrılmak\Nistemediklerini söylemişlerdi!
Dialogue: 5,0:09:54.36,0:09:56.15,Main-480p,,0,0,0,,Görünüşe göre onlar da bir\Nmacera istemişler!
Dialogue: 5,0:09:56.15,0:10:00.78,Main-480p,,0,0,0,,Yani buradaki birayı sizden\Naldığım anlamına mı geliyor?
Dialogue: 5,0:10:05.66,0:10:07.41,Main-480p,,0,0,0,,Bu arada, Dorry-{\i1}san{\i0}...
Dialogue: 5,0:10:07.41,0:10:11.04,Main-480p,,0,0,0,,...gerçekten Seyir'in\Nayarlanması bir yıl mı sürüyor?
Dialogue: 5,0:10:11.04,0:10:16.76,Main-480p,,0,0,0,,Oradaki küçük insan kemiklerini\Nfarketmediniz mi?
Dialogue: 5,0:10:17.59,0:10:22.80,Main-480p,,0,0,0,[3-liner],Buraya ayak basan insanların çoğu,\Ngenelde seyirleri ayarlanmadan ölür.
Dialogue: 5,0:10:22.80,0:10:25.72,Main-480p,,0,0,0,,Bazısı dinazor yemeği olur.
Dialogue: 5,0:10:25.72,0:10:27.56,Main-480p,,0,0,0,,Bazısı sıcağa dayanamaz...
Dialogue: 5,0:10:27.56,0:10:32.69,Main-480p,,0,0,0,,...ve bazısı bize saldırmaya\Nçalışır, ama hepsi ölür.
Dialogue: 5,0:10:33.90,0:10:39.66,Main-480p,,0,0,0,,Bu adada bir yıl geçirmek, insanlar\Niçin çok fazla gibi görünüyor.
Dialogue: 5,0:10:40.36,0:10:44.45,Main-480p,,0,0,0,,Şimdi ne? \NBurada bir yıl hayatta kalabilsem bile...
Dialogue: 5,0:10:44.45,0:10:48.58,Main-480p,,0,0,0,,...bu sürede ülkeme ne olacağını\Nkim bilebilir!
Dialogue: 5,0:10:49.21,0:10:52.92,Main-480p,,0,0,0,,Bu konuda haklısın. Bir yıl çok uzun.
Dialogue: 5,0:10:52.92,0:10:55.38,Main-480p,,0,0,0,,Daha iyi bir yol bilmiyor musun, Amca?
Dialogue: 5,0:10:56.71,0:11:02.43,Main-480p,,0,0,0,,Burada tek bir daimi belirleyici var.\NAma o anavatanımız Elbaf'ı gösteriyor.
Dialogue: 5,0:11:02.43,0:11:07.68,Main-480p,,0,0,0,,Dövüşümüzün galibi, o daimi\Nbelirleyiciyi elde edecek.
Dialogue: 5,0:11:07.68,0:11:10.14,Main-480p,,0,0,0,,Ne dersin? Onu bizden almayı\Ndenemek ister misin?
Dialogue: 5,0:11:10.14,0:11:14.15,Main-480p,,0,0,0,,Bu hiç iyi değil.\NOraya gitmek istemiyoruz.
Dialogue: 5,0:11:14.15,0:11:18.82,Main-480p,,0,0,0,,Tüm yapmak istediğimiz bir\Nsonraki adaya gitmek, değil mi?
Dialogue: 5,0:11:19.61,0:11:23.82,Main-480p,,0,0,0,,Arabasta yolumuzu kaybedersek\Ndevam etmek için nedenimiz kalmayacak.
Dialogue: 5,0:11:23.82,0:11:24.99,Main-480p,,0,0,0,,Duydun mu?
Dialogue: 5,0:11:25.78,0:11:28.79,Main-480p,,0,0,0,,İyi öyleyse, niye çıkıp kendiniz için\Ndoğru yolu bulmaya çalışmıyorsunuz?
Dialogue: 5,0:11:29.50,0:11:33.13,Main-480p,,0,0,0,,Şans sizden yanaysa, başaracaksınız.
Dialogue: 5,0:11:39.76,0:11:41.88,Main-480p,,0,0,0,,Haklı olabilirsin!
Dialogue: 5,0:11:43.72,0:11:46.43,Main-480p,,0,0,0,,Başarabiliriz!
Dialogue: 5,0:11:49.73,0:11:54.40,Main-480p,,0,0,0,[3-liner],Bu bana, uzun zaman önce seyiri\Nayarlanmadan giden birini hatırlattı.
Dialogue: 5,0:11:54.56,0:11:55.98,Main-480p,,0,0,0,,Ona ne oldu?
Dialogue: 5,0:11:55.98,0:11:57.82,Main-480p,,0,0,0,,Ben nereden bileyim?
Dialogue: 5,0:11:57.82,0:12:00.32,Main-480p,,0,0,0,,Bir sonraki adaya varmış olmalı!
Dialogue: 5,0:12:00.32,0:12:01.65,Main-480p,,0,0,0,,Elbette!
Dialogue: 5,0:12:05.12,0:12:07.53,Thoughts-480p,,0,0,0,,Bu kadar komik olan ne?
Dialogue: 5,0:12:13.87,0:12:18.30,Thoughts-480p,,0,0,0,,Nasıl bu şekilde düşünebilirler?!
Dialogue: 5,0:12:24.09,0:12:28.10,Main-480p,,0,0,0,,Denizin Cesur Savaşçısı mı?\NO da neyin nesi?
Dialogue: 5,0:12:28.10,0:12:32.77,Main-480p,,0,0,0,,O sizsiniz!\NBir gün sizin gibi olmak istiyorum!
Dialogue: 5,0:12:32.77,0:12:35.60,Main-480p,,0,0,0,,Hımm? Dev mi olmak istiyorsun?
Dialogue: 5,0:12:35.60,0:12:36.81,Main-480p,,0,0,0,,GÖRDÜN MÜ?
Dialogue: 5,0:12:36.81,0:12:38.06,Main-480p,,0,0,0,,Hayır, istemiyorum!
Dialogue: 5,0:12:39.11,0:12:44.03,Main-480p,,0,0,0,,Elbaf savaşçısı gibi hayatımı şerefli bir\Nşekilde yaşamak istiyorum!
Dialogue: 5,0:12:48.41,0:12:49.37,Main-480p,,0,0,0,,Anlıyorum!
Dialogue: 5,0:12:50.20,0:12:54.08,Main-480p,,0,0,0,,Pekala, siz cılız, kavruk insanlardan\Nçok daha uzun yaşadığımıza göre...
Dialogue: 5,0:12:54.08,0:12:56.83,Main-480p,,0,0,0,,...nasıl ölmek istediğimizi dikkatlice\Ndüşünüyoruz.
Dialogue: 5,0:12:56.83,0:13:02.55,Main-480p,,0,0,0,,{\q2}Sonuçta, bir kimsenin hayatı gibi, zenginlik\Nve maddi servet de bir gün yok olacak.
Dialogue: 5,0:13:02.55,0:13:07.80,Main-480p,,0,0,0,,Ama, Elbaf savaşçısı için\Nlekelenmemiş bir şerefle ölmek...
Dialogue: 5,0:13:07.80,0:13:10.01,Main-480p,,0,0,0,,...ölmenin en güzel yoludur.
Dialogue: 5,0:13:10.68,0:13:15.48,Main-480p,,0,0,0,,Elbaf ülkesinde bu şeref\Nsonsuza dek süren bir hazinedir.
Dialogue: 5,0:13:16.81,0:13:20.44,Main-480p,,0,0,0,,Şeref hazine mi?\NBu mükemmel!
Dialogue: 5,0:13:20.44,0:13:24.86,Main-480p,,0,0,0,,Karar verdim! Şu andan itibaren sana Efendim diyeceğim!
Dialogue: 5,0:13:24.86,0:13:25.90,Main-480p,,0,0,0,,Ha?
Dialogue: 5,0:13:43.88,0:13:44.97,Main-480p,,0,0,0,,Dev amca!
Dialogue: 5,0:13:47.84,0:13:49.51,Main-480p,,0,0,0,,Ne oldu Allah aşkına?
Dialogue: 5,0:13:49.51,0:13:51.64,Main-480p,,0,0,0,,Bira niye patladı?
Dialogue: 5,0:13:51.64,0:13:55.60,Main-480p,,0,0,0,,Bira gemimizdendi, değil mi?
Dialogue: 5,0:13:57.35,0:13:59.73,Main-480p,,0,0,0,,Midesinin içinde patladı!
Dialogue: 5,0:13:59.73,0:14:02.82,Main-480p,,0,0,0,,Bunu diğer dev mi yaptı?
Dialogue: 5,0:14:03.53,0:14:05.65,Main-480p,,0,0,0,,SEN! İZLEMİYOR MUYDUN?!
Dialogue: 5,0:14:05.65,0:14:08.45,Main-480p,,0,0,0,,Yüz yıl boyunca dövüştüler ve böyle\Nbir şey yapacaklarını mı düşünüyorsun?!
Dialogue: 5,0:14:10.41,0:14:12.62,Main-480p,,0,0,0,,Öyleyse bunu kim yapmış olabilir?
Dialogue: 5,0:14:15.16,0:14:17.25,Main-480p,,0,0,0,,Sizdiniz.
Dialogue: 5,0:14:19.29,0:14:21.96,Main-480p,,0,0,0,,Brogy değildi.
Dialogue: 5,0:14:22.67,0:14:28.05,Main-480p,,0,0,0,,Biz şerefli Elbaf savaşçılarıyız.
Dialogue: 5,0:14:28.05,0:14:32.14,Main-480p,,0,0,0,,Şüphelenilecek olanlar... sizsiniz.
Dialogue: 5,0:14:33.85,0:14:35.18,Main-480p,,0,0,0,,Kaçmalıyız!
Dialogue: 5,0:14:35.18,0:14:37.31,Main-480p,,0,0,0,,Söylediğimiz hiçbir şeyi dinlemeyecek!
Dialogue: 5,0:14:37.31,0:14:39.31,Main-480p,,0,0,0,,Kaçmak işe yaramayacak.
Dialogue: 5,0:14:40.10,0:14:41.77,Main-480p,,0,0,0,,Bunu al ve saklan.
Dialogue: 5,0:14:42.52,0:14:45.65,Main-480p,,0,0,0,,Yoksa sen onunla\Ndövüşecek misin?
Dialogue: 5,0:14:48.86,0:14:53.07,Main-480p,,0,0,0,,Bunun için üzgünüm, amca.\NBiraz çeneni kapatmak zorundayım.
Dialogue: 5,0:14:57.08,0:15:00.33,Main-480p,,0,0,0,,İkiniz de durun! Lütfen!
Dialogue: 5,0:15:00.33,0:15:01.88,Main-480p,,0,0,0,,Dorry-{\i1}san{\i0}, lütfen beni dinleyin!
Dialogue: 5,0:15:01.88,0:15:06.80,Main-480p,,0,0,0,,Biranın niye patladığını gerçekten bilmiyoruz! Lütfen aceleci olmayın!
Dialogue: 5,0:15:06.80,0:15:11.34,Main-480p,,0,0,0,,Sakin olmalısınız! İç yaralanmanız\Nolduğunun farkında değil misiniz?!
Dialogue: 5,0:15:12.47,0:15:17.89,Main-480p,,0,0,0,,Seni küçük küstah...\NBunun yanına kalacağını mı sanıyorsun?!
Dialogue: 5,0:15:28.32,0:15:30.99,Main-480p,,0,0,0,,{\fad(150,150)}GOMU GOMU NO{!}...
Dialogue: 5,0:15:48.67,0:15:50.42,Main-480p,,0,0,0,,{\fad(150,150)}GOMU GOMU NO{!}...
Dialogue: 5,0:16:00.23,0:16:01.35,Thoughts-480p,,0,0,0,,Üzgünüm.
Dialogue: 5,0:16:01.35,0:16:03.31,Main-480p,,0,0,0,,{\fad(150,150)}...ROKET!!
Dialogue: 5,0:16:31.80,0:16:33.76,Main-480p,,0,0,0,,LUFFY-{\i1}SAN!{\i0}
Dialogue: 5,0:16:35.30,0:16:41.22,Main-480p,,0,0,0,,Şeytan Meyvesi'nin... \Ngücüne mi sahipsin?
Dialogue: 5,0:16:41.22,0:16:45.85,Main-480p,,0,0,0,,Onu hafife aldım.
Dialogue: 5,0:17:07.17,0:17:09.79,Main-480p,,0,0,0,,Luffy-{\i1}san{\i0}, iyi misin?
Dialogue: 5,0:17:10.84,0:17:12.13,Main-480p,,0,0,0,,Amca?
Dialogue: 5,0:17:12.80,0:17:15.09,Main-480p,,0,0,0,,Sanırım yaşıyor.
Dialogue: 5,0:17:15.72,0:17:19.05,Main-480p,,0,0,0,,Bunu yapmasaydın, sakinleşmezdi.
Dialogue: 5,0:17:20.43,0:17:22.31,Main-480p,,0,0,0,,Kızdım!
Dialogue: 5,0:17:22.31,0:17:23.77,Main-480p,,0,0,0,,Ne?
Dialogue: 5,0:17:23.77,0:17:26.48,Main-480p,,0,0,0,,O birayı... dediği gibi...
Dialogue: 5,0:17:26.48,0:17:29.15,Main-480p,,0,0,0,,...diğer dev yapmadı.
Dialogue: 5,0:17:29.15,0:17:32.98,Main-480p,,0,0,0,,Benim arkadaşlarımdan hiç birinin de\Nbunu yapması mümkün değil.
Dialogue: 5,0:17:32.98,0:17:35.45,Main-480p,,0,0,0,,Öyleyse kim?
Dialogue: 5,0:17:35.45,0:17:38.70,Main-480p,,0,0,0,,Burada başka biri var.\NBu adada.
Dialogue: 5,0:17:46.83,0:17:53.21,Main-480p,,0,0,0,,Bir mücadele, rakiplerin şevkiyle\Nsonuçlandırılan bir şeydir.
Dialogue: 5,0:17:53.21,0:17:55.97,Main-480p,,0,0,0,,Şu anda görülmeyen bir düşmandan gelen...
Dialogue: 5,0:17:55.97,0:18:01.43,Main-480p,,0,0,0,,...açıklanamayan "Bomba Servisi"\Nnedeniyle, kafaları karışmış durumda.
Dialogue: 5,0:18:01.43,0:18:06.06,Main-480p,,0,0,0,,İlk hedefimiz \NMavi Ogre Dorry ile başlıyoruz.
Dialogue: 5,0:18:06.06,0:18:08.60,Main-480p,,0,0,0,,Bombanın onu öldürmeyeceğini çok iyi biliyordum.
Dialogue: 5,0:18:08.60,0:18:12.77,Main-480p,,0,0,0,[3-liner],Ancak midesindeki patlama\Nhatırı sayılır bir hasara yol açtı.
Dialogue: 5,0:18:12.77,0:18:19.70,Main-480p,,0,0,0,,{\q2}Sadece bir sonraki karşılaşmalarını beklemeliyiz.\NBu sırada çayımızın tadını çıkarabiliriz.
Dialogue: 5,0:18:19.70,0:18:24.49,Main-480p,,0,0,0,,Demek bir devi haklamak için\Ndiğerini kullanıyorsun, ha?
Dialogue: 5,0:18:24.49,0:18:27.04,Main-480p,,0,0,0,,Doğru.
Dialogue: 5,0:18:27.04,0:18:29.17,Main-480p,,0,0,0,,İşleri yapmak için epey dolambaçlı bir yöntem.
Dialogue: 5,0:18:29.17,0:18:34.13,Main-480p,,0,0,0,,Sonuçta savaşçı olarak bilinenler,\Nyaban domuzları gibi değil.
Dialogue: 5,0:18:34.13,0:18:39.43,Main-480p,,0,0,0,,Kafa kafaya mücadeleden kaçınırsan\Nonları ele geçirmesi epey kolaydır.
Dialogue: 5,0:18:39.43,0:18:42.22,Main-480p,,0,0,0,,Bununla birlikte, \Nonların gücü bizde olmasa da...
Dialogue: 5,0:18:42.22,0:18:45.72,Main-480p,,0,0,0,,...zekamızı kullanarak şartları eşitleyebiliriz.
Dialogue: 5,0:18:59.15,0:19:04.66,Main-480p,,0,0,0,,Yani... onu kendin alamaz mısın, \NBayan Altın Hafta?
Dialogue: 5,0:19:04.66,0:19:08.04,Main-480p,,0,0,0,,Her neyse, Hasır Şapka Korsanlarıyla\Nnasıl baş edeceksiniz?
Dialogue: 5,0:19:08.04,0:19:14.34,Main-480p,,0,0,0,,{\q2}Hasır Şapka mı? Ah, patronun sırrını açığa \Nçıkaran küçük solucanları kastediyorsun.
Dialogue: 5,0:19:14.34,0:19:18.55,Main-480p,,0,0,0,[3-liner],Evet, bölünmüş ve alt edici bir\Nstratejinin yeterli olacağına inanıyorum.
Dialogue: 5,0:19:18.55,0:19:22.14,Main-480p,,0,0,0,,Bu da elbette benim Servis Set'im olacak.
Dialogue: 5,0:19:23.05,0:19:27.85,Main-480p,,0,0,0,,Benim ilkem "Büyük Becerikli Suçlar"dır.
Dialogue: 5,0:19:29.27,0:19:33.86,Main-480p,,0,0,0,,Parmağını bile oynatmadan düşmanını\Ndevirmenin birçok yolu var.
Dialogue: 5,0:19:33.86,0:19:36.19,Main-480p,,0,0,0,,Bay 3, bir fincan daha.
Dialogue: 5,0:19:36.19,0:19:37.73,Main-480p,,0,0,0,,Hey, bana da.
Dialogue: 5,0:19:37.73,0:19:41.03,Main-480p,,0,0,0,,SİZ! TADINI ÇIKARACAK KADAR VAKİT HARCADINIZ MI?!
Dialogue: 5,0:19:45.45,0:19:48.08,Main-480p,,0,0,0,,Dağ...\NYani bu...
Dialogue: 5,0:19:53.88,0:19:55.92,Main-480p,,0,0,0,,İşte işaret.
Dialogue: 5,0:19:55.92,0:19:58.92,Main-480p,,0,0,0,,Bugün epey eğlenceli olacak\Ngibi görünüyor.
Dialogue: 5,0:19:58.92,0:20:03.26,Main-480p,,0,0,0,,Gidiyor musun? \NDeminki dövüşten olan yaraların-
Dialogue: 5,0:20:04.18,0:20:07.89,Main-480p,,0,0,0,,Ne olmuş? \NDiğerinin de aynı sorunları var.
Dialogue: 5,0:20:13.73,0:20:19.15,Main-480p,,0,0,0,,Ölümüne acımasız bir dövüşte\Nmazeret uydurmak adımı lekeler!
Dialogue: 5,0:20:29.58,0:20:30.91,Main-480p,,0,0,0,,Hey! Bekle, amca!
Dialogue: 5,0:20:30.91,0:20:32.37,Main-480p,,0,0,0,,Gitme!
Dialogue: 5,0:20:32.37,0:20:34.75,Main-480p,,0,0,0,,Bunu yapamazsın, Dorry-san!\NYerde kalmalısın!
Dialogue: 5,0:20:34.75,0:20:37.17,Main-480p,,0,0,0,,Kendini fazla zorlarsan, öleceksin!
Dialogue: 5,0:20:39.21,0:20:42.51,Main-480p,,0,0,0,,Ben savaşçı Dorry'im.
Dialogue: 5,0:20:42.51,0:20:44.59,Main-480p,,0,0,0,,Ve...
Dialogue: 5,0:20:44.59,0:20:48.10,Main-480p,,0,0,0,,...Elbaf adına dövüşeceğim!
