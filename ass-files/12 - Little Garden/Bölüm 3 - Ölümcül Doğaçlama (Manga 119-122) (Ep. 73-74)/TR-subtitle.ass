Dialogue: 0,0:01:50.04,0:01:55.21,Title-480p,,0,0,0,,{\c&H000000&\1a&HFF&\blur0.6\fad(700,0)\t(655,700,\1a&H00&)}Ölümcül Doğaçlama
Dialogue: 1,0:01:50.04,0:01:55.21,Title-480p,,0,0,0,,{\bord0\4a&HFF&\blur0.6\fad(700,0)}Ölümcül Doğaçlama
Dialogue: 5,0:02:24.36,0:02:25.37,Main-480p,,0,0,0,,Yoksa...
Dialogue: 5,0:02:36.50,0:02:39.69,Main-480p,,0,0,0,,Vay! O büyük kayayı yerden söktü!
Dialogue: 5,0:02:40.80,0:02:41.89,Main-480p,,0,0,0,,Luffy-{\i1}san{\fs10} {\r}!
Dialogue: 5,0:02:50.58,0:02:53.80,Main-480p,,0,0,0,,Bu da ne demek, amca?!\NŞu kayayı üzerimden kaldır! Hey!
Dialogue: 5,0:02:53.80,0:02:55.73,Main-480p,,0,0,0,,Şimdi duramam.
Dialogue: 5,0:02:58.90,0:03:01.86,Main-480p,,0,0,0,,Bu yüz yıllık bir hikaye olabilir,...
Dialogue: 5,0:03:04.10,0:03:06.98,Main-480p,,0,0,0,,...ama bir kez dövüş başladı mı...
Dialogue: 5,0:03:08.70,0:03:13.37,Main-480p,,0,0,0,,...kaçmak, Savaşçı adından...
Dialogue: 5,0:03:13.37,0:03:16.55,Main-480p,,0,0,0,,...kaçmak anlamına gelir!
Dialogue: 5,0:03:16.55,0:03:19.92,Main-480p,,0,0,0,,Ve artık savaşçı değilsem...
Dialogue: 5,0:03:19.92,0:03:23.72,Main-480p,,0,0,0,,...kendim değilim demektir.
Dialogue: 5,0:03:23.72,0:03:27.35,Main-480p,,0,0,0,,Senden şüphelendiğim için üzgünüm.
Dialogue: 5,0:03:28.30,0:03:30.77,Main-480p,,0,0,0,,Savaş Tanrısı...
Dialogue: 5,0:03:32.19,0:03:35.60,Main-480p,,0,0,0,,...Elbaf hükmünü verdi!
Dialogue: 5,0:03:36.48,0:03:41.00,Main-480p,,0,0,0,,Onun ilahi sempatisini yitirdim.\NHepsi bu.
Dialogue: 5,0:03:42.89,0:03:45.85,Main-480p,,0,0,0,,Tanrılar! Sempati!\NOlması ya da olmaması!
Dialogue: 5,0:03:45.87,0:03:47.94,Main-480p,,0,0,0,,Onların bununla bir alakası yok!
Dialogue: 5,0:03:47.94,0:03:50.79,Main-480p,,0,0,0,,Sırf Tanrın öyle diyor diye, ölmeye mi gideceksin?!
Dialogue: 5,0:03:50.79,0:03:53.86,Main-480p,,0,0,0,,Düellon sabotaj edildi!
Dialogue: 5,0:03:54.67,0:03:58.38,Main-480p,,0,0,0,,Sabotaja uğramış bir düello, \Ndüello değildir!
Dialogue: 5,0:03:58.98,0:04:02.34,Main-480p,,0,0,0,,– Haklı olduğumu biliyorsun!\N– Sessizlik!
Dialogue: 5,0:04:03.64,0:04:08.64,Main-480p,,0,0,0,,On veya yirmi yıl yaşamış\Nolan siz küstah insanlar...
Dialogue: 5,0:04:08.64,0:04:13.13,Main-480p,,0,0,0,,...Elbaf'ın Kutsal Sözleri'ni nasıl duyabilirsiniz?
Dialogue: 5,0:04:13.98,0:04:18.94,Main-480p,,0,0,0,,Bu kimin umrunda?!\NHey! Şunu çek üzerimden! Hey, amca!
Dialogue: 5,0:04:18.94,0:04:23.15,Main-480p,,0,0,0,,Dev Amca! Hey! Amca!\NBuraya gel, seni uyuz!
Dialogue: 5,0:04:23.15,0:04:25.23,Main-480p,,0,0,0,,Öyle gitmene izin vermeyeceğim!
Dialogue: 5,0:04:29.24,0:04:32.46,Main-480p,,0,0,0,,Tamam, Usta Brogy! Elinden geleni yap!
Dialogue: 5,0:04:36.89,0:04:38.90,Main-480p,,0,0,0,,İyi dedin, Usopp!
Dialogue: 5,0:04:38.90,0:04:42.13,Main-480p,,0,0,0,,Bu kez kesinlikle devrilecek!
Dialogue: 5,0:04:42.13,0:04:45.50,Main-480p,,0,0,0,,Evet! Elinden geleni yap!\NElbaf'ın Savaşçısı!
Dialogue: 5,0:04:48.05,0:04:50.31,Main-480p,,0,0,0,,Git ve dövüş!
Dialogue: 5,0:04:50.31,0:04:55.41,Main-480p,,0,0,0,,Sen en iyisisin! Müthişsin!\NGüçlüsün!
Dialogue: 5,0:04:55.41,0:05:00.21,Main-480p,,0,0,0,,Kocamansın! Büyüksün! Dev gibis-
Dialogue: 5,0:04:58.11,0:05:00.21,Secondary-480p,,0,0,0,,{\q2}Bu manasız dövüşü kesinlikle ciddiye alıyorlar.
Dialogue: 5,0:05:00.21,0:05:02.10,Main-480p,,0,0,0,,Manasız deme, aptal!
Dialogue: 5,0:05:02.10,0:05:05.23,Main-480p,,0,0,0,,Brogy benim olmak istediğim\NDenizin Cesur Savaşçısı!
Dialogue: 5,0:05:05.23,0:05:06.70,Main-480p,,0,0,0,,Nasıl öyle bir şey diyebilirsin?!
Dialogue: 5,0:05:06.70,0:05:08.66,Main-480p,,0,0,0,,Her neyse, gemiye dönelim.
Dialogue: 5,0:05:09.36,0:05:13.13,Main-480p,,0,0,0,,Seyir'in belirlenmesi koca bir\Nyıl sürüyor. Ne sıkıntı ama.
Dialogue: 5,0:05:13.13,0:05:15.60,Main-480p,,0,0,0,,Diğerlerini gemide bekleyelim ve\Nbir plan düşünelim.
Dialogue: 5,0:05:15.60,0:05:16.96,Main-480p,,0,0,0,,Bekle! Dur bakalım orada!
Dialogue: 5,0:05:19.44,0:05:22.70,Main-480p,,0,0,0,,Ben dinazorlara karşı tamamen faydasızım!
Dialogue: 5,0:05:22.70,0:05:27.68,Main-480p,,0,0,0,,Bu yüzden ormandan geçebilmemiz\Nimkansız!
Dialogue: 5,0:05:27.68,0:05:32.28,Main-480p,,0,0,0,,Tüm o "Cesur Savaşçı" konuşmasına ne oldu?
Dialogue: 5,0:05:32.28,0:05:34.78,Main-480p,,0,0,0,,Sadece niyetlerimden bahsediyordum.
Dialogue: 5,0:05:34.78,0:05:38.06,Main-480p,,0,0,0,,Onuruyla yaşayan bir adam olmak istiyorum!
Dialogue: 5,0:05:38.06,0:05:39.45,Thoughts-480p,,0,0,0,,Sanırım başka çarem yok.
Dialogue: 5,0:05:39.45,0:05:42.80,Thoughts-480p,,0,0,0,,Luffy ve Vivi diğer Dev'în yerinde olmalı.
Dialogue: 5,0:05:42.80,0:05:45.03,Thoughts-480p,,0,0,0,,Sanırım şimdilik oraya gideceğiz.
Dialogue: 5,0:05:45.03,0:05:46.69,Main-480p,,0,0,0,,Dinle, Nami.
Dialogue: 5,0:05:46.69,0:05:49.39,Main-480p,,0,0,0,,Her şeyi kaybettiğim ve terkedilmiş bir adada...
Dialogue: 5,0:05:49.39,0:05:52.73,Main-480p,,0,0,0,,...ölüm anımla yüzleştiğim\Nbir gün gelecek olsa bile,...
Dialogue: 5,0:05:52.73,0:05:56.30,Main-480p,,0,0,0,,...yaşadığım hayattaki onuru alıp ilan edeceğim:...
Dialogue: 5,0:05:56.30,0:06:00.16,Main-480p,,0,0,0,,..."Ben Denizin Cesur Savaşçısı, Usopp!!"
Dialogue: 5,0:06:01.42,0:06:03.09,Main-480p,,0,0,0,,Tabii, tabii.
Dialogue: 5,0:06:03.09,0:06:07.05,Main-480p,,0,0,0,,Madem öyle, belki de bir an önce\Ndaha güvenilir bir savaşçı olmalısın.
Dialogue: 5,0:06:07.05,0:06:08.29,Main-480p,,0,0,0,,Ah...
Dialogue: 5,0:06:08.29,0:06:09.51,Main-480p,,0,0,0,,Evet!
Dialogue: 5,0:06:16.80,0:06:20.69,Main-480p,,0,0,0,,Dorry! O kadar uzun zaman geçtikten\Nsonra, o bira olağanüstü olmalı!
Dialogue: 5,0:06:21.59,0:06:24.28,Main-480p,,0,0,0,,Evet. İlahi bir tadı vardı.
Dialogue: 5,0:06:26.67,0:06:29.41,Main-480p,,0,0,0,,Abartıyorsun!\NBaşlayalım!
Dialogue: 5,0:06:36.16,0:06:40.46,Main-480p,,0,0,0,,Sorun nedir, Dorry?\NGüç bela karşı koyuyorsun!
Dialogue: 5,0:06:41.46,0:06:44.84,Main-480p,,0,0,0,,Kendini kandırma!\NHer zamanki gibiyim!
Dialogue: 5,0:06:58.69,0:07:01.44,Main-480p,,0,0,0,,BU OLMUYOR! HEY!
Dialogue: 5,0:07:02.40,0:07:05.65,Main-480p,,0,0,0,,İlham verici bir savaşçı bulduğumu\Ndüşünmüştüm.
Dialogue: 5,0:07:06.47,0:07:07.63,Main-480p,,0,0,0,,Luffy-{\i1}san{\i0}{...}.
Dialogue: 5,0:07:09.21,0:07:13.19,Thoughts-480p,,0,0,0,,Daha yeni tanıştığı bir Devi \Nniye bu kadar umursuyor?
Dialogue: 5,0:07:13.19,0:07:16.83,Thoughts-480p,,0,0,0,,Başına konan ödülü hak eden\Nkötü bir adam gibi görünmüyor.
Dialogue: 5,0:07:16.83,0:07:21.17,Main-480p,,0,0,0,,Kimdi o?! \NDevlerin düellosunu kim batırdı?!
Dialogue: 5,0:07:22.70,0:07:23.71,Main-480p,,0,0,0,,Sahi...
Dialogue: 5,0:07:25.00,0:07:26.21,Main-480p,,0,0,0,,Carue kayıp.
Dialogue: 5,0:07:37.19,0:07:39.73,Main-480p,,0,0,0,,Ah... kayboldum.
Dialogue: 5,0:07:40.46,0:07:43.67,Main-480p,,0,0,0,,Kesinlikle bu ağacı daha önce\Ngördüğümü hatırlıyorum.
Dialogue: 5,0:07:43.67,0:07:47.44,Main-480p,,0,0,0,,"Sarmaşıklı ağacın solunda" değil miydi?
Dialogue: 5,0:07:48.38,0:07:50.70,Main-480p,,0,0,0,,Nami!
Dialogue: 5,0:07:50.70,0:07:52.89,Main-480p,,0,0,0,,İyi zamanlama.
Dialogue: 5,0:07:52.89,0:07:56.33,Main-480p,,0,0,0,,Hey, nasılsa kayboldum.\NNereye gideceğimi düşünemedim.
Dialogue: 5,0:07:56.33,0:07:59.21,Main-480p,,0,0,0,,Sahi, burada ne yapıyorsun?
Dialogue: 5,0:07:59.95,0:08:02.54,Main-480p,,0,0,0,,Hey... sorun nedir?
Dialogue: 5,0:08:07.09,0:08:09.05,Main-480p,,0,0,0,,DİNOZOR!!
Dialogue: 5,0:08:09.05,0:08:11.05,Main-480p,,0,0,0,,Dinozor! Dinozor! Dinozor!
Dialogue: 5,0:08:13.70,0:08:15.76,Main-480p,,0,0,0,,ÇOK HIZLI KOŞUYORSUN!!
Dialogue: 5,0:08:18.56,0:08:20.90,Main-480p,,0,0,0,,Lanet olası...
Dialogue: 5,0:08:20.90,0:08:21.93,Main-480p,,0,0,0,,Luffy!
Dialogue: 5,0:08:21.93,0:08:23.80,Main-480p,,0,0,0,,Hele şükür!
Dialogue: 5,0:08:23.80,0:08:26.22,Main-480p,,0,0,0,,Niye buradasın?
Dialogue: 5,0:08:40.10,0:08:41.70,Main-480p,,0,0,0,,N-Nami?
Dialogue: 5,0:09:00.35,0:09:03.81,Main-480p,,0,0,0,,Nami! Nami! Nami! Nami!
Dialogue: 5,0:09:04.88,0:09:06.98,Main-480p,,0,0,0,,Kahretsin.
Dialogue: 5,0:09:06.98,0:09:08.56,Main-480p,,0,0,0,,Luffy!
Dialogue: 5,0:09:15.20,0:09:18.07,Main-480p,,0,0,0,,Luffy!
Dialogue: 5,0:09:18.07,0:09:20.87,Main-480p,,0,0,0,,Luffy! Luffy! Luffy! Luffy!
Dialogue: 5,0:09:20.87,0:09:23.12,Main-480p,,0,0,0,,Luffy!
Dialogue: 5,0:09:29.59,0:09:32.30,Main-480p,,0,0,0,,Acil durum! Nami bir dinazor\Ntarafından yendi!!
Dialogue: 5,0:09:32.30,0:09:33.51,Main-480p,,0,0,0,,GERÇEKTEN Mİ?!!
Dialogue: 5,0:09:33.51,0:09:37.98,Main-480p,,0,0,0,,Bir dinazordan kaçmak için ormana\Ndoğru birlikte koştuğumuz sırada...
Dialogue: 5,0:09:37.98,0:09:40.02,Main-480p,,0,0,0,,...aniden kayboldu!!
Dialogue: 5,0:09:40.02,0:09:44.98,Main-480p,,0,0,0,,Ben ne yaptım?!\NArkadaşımın ölmesine izin verdim!!
Dialogue: 5,0:09:46.23,0:09:50.19,Main-480p,,0,0,0,,D-Dur biraz. Sakin ol! İKİNİZ DE!
Dialogue: 5,0:09:51.70,0:09:56.82,Main-480p,,0,0,0,,Aniden yok oldu dedin. Yani aslında ona\Nne olduğunu görmedin, değil mi?
Dialogue: 5,0:09:56.82,0:10:00.77,Main-480p,,0,0,0,,Sersem! Ne olduğunu nasıl görebilirim, çok korkmuştum?!
Dialogue: 5,0:10:00.77,0:10:02.58,Main-480p,,0,0,0,,Dinazor değildiyse başka\Nbir vahşi hayvandı!
Dialogue: 5,0:10:02.58,0:10:04.33,Main-480p,,0,0,0,,Başka ne olabilir?!
Dialogue: 5,0:10:04.33,0:10:06.41,Main-480p,,0,0,0,,Emin değilim, ama...
Dialogue: 5,0:10:06.41,0:10:10.75,Main-480p,,0,0,0,,Baroque Works bizi bu adaya\Nkadar takip etmiş olabilir.
Dialogue: 5,0:10:10.75,0:10:15.30,Main-480p,,0,0,0,,İkiniz içerisinde, hedef durumunda\Nolan sadece Nami-san'dı.
Dialogue: 5,0:10:15.30,0:10:19.50,Main-480p,,0,0,0,,Baroque Works bu adada mı?!
Dialogue: 5,0:10:20.62,0:10:24.97,Main-480p,,0,0,0,,Ama öyleyse niye beni de\Nhedef almadılar?
Dialogue: 5,0:10:24.97,0:10:29.70,Main-480p,,0,0,0,,Büyük ihtimalle Baroque Works'un\Nölüm listesinde olmadığın için.
Dialogue: 5,0:10:29.70,0:10:30.94,Main-480p,,0,0,0,,Anladım!
Dialogue: 5,0:10:30.94,0:10:36.90,Main-480p,,0,0,0,,O bira da bizim için hazırlanmış olabilir.
Dialogue: 5,0:10:36.90,0:10:39.98,Main-480p,,0,0,0,,Bira? Biraya ne olmuş?
Dialogue: 5,0:10:39.98,0:10:43.38,Main-480p,,0,0,0,,Brogy biranızdan birazını Dorry'e verdi.
Dialogue: 5,0:10:43.38,0:10:48.50,Main-480p,,0,0,0,,Ama Dorry onu içince \Nbira midesinde patladı.
Dialogue: 5,0:10:48.50,0:10:51.38,Main-480p,,0,0,0,,NE?! Bira midesinde mi patladı?!
Dialogue: 5,0:10:52.12,0:10:55.52,Main-480p,,0,0,0,,O haliyle düelloya mı gitti?!
Dialogue: 5,0:10:55.52,0:10:58.59,Main-480p,,0,0,0,,Onu durdurmaya çalıştım ama durum ortada.
Dialogue: 5,0:11:01.01,0:11:02.85,Main-480p,,0,0,0,,Olamaz.
Dialogue: 5,0:11:02.85,0:11:09.27,Main-480p,,0,0,0,,Yüz yıldır onlar tam güçle eşit\Nolarak dövüşüyordu!
Dialogue: 5,0:11:20.24,0:11:24.01,Main-480p,,0,0,0,,Onların dövüşü dünyadaki en\Nonurlu dövüş olmalı!
Dialogue: 5,0:11:24.01,0:11:24.78,Main-480p,,0,0,0,,Evet.
Dialogue: 5,0:11:24.78,0:11:27.87,Main-480p,,0,0,0,,Birisi onların dövüşünü\Nmahvetmeye nasıl cüret eder?!!
Dialogue: 5,0:11:33.50,0:11:35.71,Main-480p,,0,0,0,,Sorun nedir?!
Dialogue: 5,0:11:47.60,0:11:50.14,Main-480p,,0,0,0,,Hala dövüşüyorlar.
Dialogue: 5,0:11:50.14,0:11:54.65,Main-480p,,0,0,0,,Mavi Ogre Dorry epey inatçı biri.
Dialogue: 5,0:11:56.21,0:11:59.28,Main-480p,,0,0,0,,Belki de biraz yardım etmeliyim.
Dialogue: 5,0:12:11.58,0:12:13.79,Thoughts-480p,,0,0,0,,Uzun bir...
Dialogue: 5,0:12:17.88,0:12:22.30,Thoughts-480p,,0,0,0,,...dövüş asrı oldu.
Dialogue: 5,0:13:01.30,0:13:03.65,Flashbacks-480p,,0,0,0,,Savaş Tanrısı Elbaf hükmünü verdi.
Dialogue: 0,0:13:03.65,0:13:05.89,Flashbacks-480p,,0,0,0,,Bunun benim kaderim olduğuna karar verdi.
Dialogue: 5,0:13:05.89,0:13:10.89,Flashbacks-480p,,0,0,0,,Sempatisini kaybettim.\NHepsi bu.
Dialogue: 5,0:13:18.06,0:13:20.65,Main-480p,,0,0,0,,– Luffy!\N– Luffy-{\i1}san{\i0}?!
Dialogue: 5,0:13:20.65,0:13:23.24,Main-480p,,0,0,0,,KİMDİ O?!!
Dialogue: 5,0:13:24.07,0:13:28.57,Main-480p,,0,0,0,,GÖSTER KENDİNİ!
Dialogue: 5,0:13:37.99,0:13:41.00,Main-480p,,0,0,0,,Bay 3. Sanırım bir şey duydum.
Dialogue: 5,0:13:43.03,0:13:48.06,Main-480p,,0,0,0,,Ne tuhaf! Belki de ormandaki\Nacınası bir eziğin ağlayışıydı!
Dialogue: 5,0:13:57.79,0:14:00.86,Main-480p,,0,0,0,,Yetmiş üç bin...
Dialogue: 5,0:14:02.87,0:14:07.04,Main-480p,,0,0,0,,...dört yüz altmış yedi dövüş.
Dialogue: 5,0:14:09.24,0:14:15.20,Main-480p,,0,0,0,,Yetmiş üç bin dört yüz\Naltmış altı beraberlik.
Dialogue: 5,0:14:17.70,0:14:19.71,Main-480p,,0,0,0,,Bir zafer!
Dialogue: 5,0:14:35.64,0:14:39.78,Main-480p,,0,0,0,,Zaferin için sevinç gözyaşları mı?\NBöyle aptal olmak güzel olmalı.
Dialogue: 5,0:14:40.59,0:14:44.11,Main-480p,,0,0,0,,Neyse, sanırım seni tebrik edeceğim.
Dialogue: 5,0:14:44.11,0:14:45.57,Main-480p,,0,0,0,,Sevinç gözyaşları mı?!
Dialogue: 5,0:14:45.57,0:14:49.86,Main-480p,,0,0,0,,Sen bu konuda ne bilebilirsin ki?!\NKimsin sen lanet olası?!
Dialogue: 5,0:14:49.86,0:14:53.29,Main-480p,,0,0,0,,Ben Bay 3. \NKod adımı kullandığım için kusura bakma.
Dialogue: 5,0:14:53.51,0:14:56.04,Main-480p,,0,0,0,,Sadece mütevazı bir heykeltraşım.
Dialogue: 5,0:14:56.14,0:15:02.33,Main-480p,,0,0,0,,Bu da asistanım gerçekçi ressam, \NBayan Altın Hafta.
Dialogue: 5,0:15:02.33,0:15:06.80,Main-480p,,0,0,0,,Artık, benim kontrolümdesin.
Dialogue: 5,0:15:09.39,0:15:10.99,Main-480p,,0,0,0,,Bu da ne?!
Dialogue: 5,0:15:22.55,0:15:23.95,Main-480p,,0,0,0,,Tamam, Luffy!
Dialogue: 5,0:15:23.95,0:15:27.44,Main-480p,,0,0,0,,Kim olduklarını bilmiyorum ama\Nonları kendim haklayacağım!
Dialogue: 5,0:15:28.19,0:15:29.37,Main-480p,,0,0,0,,Ben de geliyorum.
Dialogue: 5,0:15:29.37,0:15:32.45,Main-480p,,0,0,0,,Evet! Senin de gelmen harika olur!\NKendimi daha güvende hissedeceğim.
Dialogue: 5,0:15:32.45,0:15:34.33,Main-480p,,0,0,0,,Bu gerekli olmayacak!
Dialogue: 5,0:15:37.00,0:15:38.79,Main-480p,,0,0,0,,Demek sizdiniz!
Dialogue: 5,0:15:50.21,0:15:53.41,Main-480p,,0,0,0,,Onu geri alabilirsin.\NArtık ihtiyacımız yok.
Dialogue: 5,0:15:55.48,0:15:56.60,Main-480p,,0,0,0,,Carue!
Dialogue: 5,0:15:56.60,0:15:58.65,Main-480p,,0,0,0,,Siz...
Dialogue: 5,0:15:58.65,0:16:00.32,Main-480p,,0,0,0,,Hey. Onlar da kim?
Dialogue: 5,0:16:00.32,0:16:02.10,Main-480p,,0,0,0,,En son uğradığımız şehirden!
Dialogue: 5,0:16:02.10,0:16:06.11,Main-480p,,0,0,0,,Bunu nasıl yapabilirsiniz?!\NCarue'nun bununla bir ilgisi yok!
Dialogue: 5,0:16:06.11,0:16:09.80,Main-480p,,0,0,0,,Haklısın. O kuşun bununla\Nkesinlikle bir ilgisi yok.
Dialogue: 5,0:16:09.80,0:16:15.03,Main-480p,,0,0,0,,Ama o hasır şapkalı adamın ciddi\Nbir tehdit olabileceğini düşündük.
Dialogue: 5,0:16:15.70,0:16:19.21,Main-480p,,0,0,0,,Ama o kuşu bağırtmanın\Nher zaman olduğu gibi...
Dialogue: 5,0:16:19.24,0:16:22.75,Main-480p,,0,0,0,,...prensesi ormana çekeceğini düşündük.
Dialogue: 5,0:16:22.75,0:16:25.20,Main-480p,,0,0,0,,Ama o şey çok inatçıydı.
Dialogue: 5,0:16:25.85,0:16:28.81,Flashbacks-480p,,0,0,0,,Şimdi. Efendini çağır.
Dialogue: 5,0:16:30.02,0:16:33.22,Flashbacks-480p,,0,0,0,,Sadece koca bir çığlık. \NSonra gitmene izin vereceğiz.
Dialogue: 5,0:16:36.96,0:16:39.68,Flashbacks-480p,,0,0,0,,Madem öyle! Seni bağırtacağız!
Dialogue: 5,0:16:40.33,0:16:42.35,Flashbacks-480p,,0,0,0,,Prensesi çağır.
Dialogue: 5,0:16:45.77,0:16:49.76,Flashbacks-480p,,0,0,0,,Onu hemen çağırsan iyi olur!
Dialogue: 5,0:16:53.07,0:16:55.63,Flashbacks-480p,,0,0,0,,Aç gaganı lanet olası kuş!
Dialogue: 5,0:16:56.87,0:17:02.49,Main-480p,,0,0,0,,Hasır Şapka zaten işe yaramaz\Nhalde görünüyor.
Dialogue: 5,0:17:02.49,0:17:04.83,Main-480p,,0,0,0,,Bu yüzden artık kuşa ihtiyacımız yok.
Dialogue: 5,0:17:04.83,0:17:06.58,Main-480p,,0,0,0,,Carue.
Dialogue: 5,0:17:12.09,0:17:13.47,Main-480p,,0,0,0,,Ne aptal bir kuş.
Dialogue: 5,0:17:15.50,0:17:17.97,Main-480p,,0,0,0,,Siz...
Dialogue: 5,0:17:17.97,0:17:21.31,Main-480p,,0,0,0,,Demek biramıza bomba koyan sizdiniz!
Dialogue: 5,0:17:22.30,0:17:24.99,Main-480p,,0,0,0,,Ah, evet. Sen de kimsin?
Dialogue: 5,0:17:24.99,0:17:26.10,Main-480p,,0,0,0,,Listede miydi?
Dialogue: 5,0:17:26.10,0:17:28.62,Main-480p,,0,0,0,,Hayır ama belli ki onların\Narkadaşlarından biri.
Dialogue: 5,0:17:28.64,0:17:29.65,Main-480p,,0,0,0,,Onu da yok edelim.
Dialogue: 5,0:17:29.65,0:17:32.53,Main-480p,,0,0,0,,Devlerin düellosuna sabotaj\Nyapan sizsiniz!
Dialogue: 5,0:17:32.53,0:17:36.03,Main-480p,,0,0,0,,Onlar mı?! Onları mahvedeceğim!
Dialogue: 5,0:17:36.03,0:17:38.49,Main-480p,,0,0,0,,Yok edilecek olanlar sizlersiniz!
Dialogue: 5,0:17:39.90,0:17:43.37,Main-480p,,0,0,0,,Oh? Bizi kendin mi karşılayacaksın\NBayan Wednesday?
Dialogue: 5,0:17:44.78,0:17:48.54,Main-480p,,0,0,0,,İki rütbeli ajana karşı şansın\Nolduğunu mu düşünüyorsun?
Dialogue: 5,0:17:48.54,0:17:50.53,Main-480p,,0,0,0,,{\fad(150,150)}Tavus Biçici
Dialogue: 5,0:17:50.53,0:17:51.25,Main-480p,,0,0,0,,Bunu alın!
Dialogue: 5,0:17:51.25,0:17:53.38,Main-480p,,0,0,0,,{\fad(150,150)}Kesin Öldürücü Barut Yıldızı
Dialogue: 5,0:17:56.38,0:17:57.51,Main-480p,,0,0,0,,Hakladım!
Dialogue: 5,0:18:00.79,0:18:02.06,Main-480p,,0,0,0,,Vay canına, ne patlama ama!
Dialogue: 5,0:18:02.93,0:18:04.64,Main-480p,,0,0,0,,{\fad(150,150)}Fantezik Burun Topu
Dialogue: 5,0:18:10.28,0:18:11.57,Main-480p,,0,0,0,,Zavallı küçük adam.
Dialogue: 5,0:18:11.57,0:18:13.57,Main-480p,,0,0,0,,Usopp!
Dialogue: 5,0:18:13.57,0:18:14.94,Main-480p,,0,0,0,,{\fad(150,150)}10,000 Kilo Baskı!
Dialogue: 5,0:18:19.43,0:18:21.29,Main-480p,,0,0,0,,Sakin ol!
Dialogue: 5,0:18:27.80,0:18:32.54,Main-480p,,0,0,0,,İstediğin gibi hararetlenebilirsin\Nama seni henüz öldürmeyeceğiz.
Dialogue: 5,0:18:36.26,0:18:41.24,Main-480p,,0,0,0,,Seni kaçırmaya geldik, \NBay 3'ün emirleri doğrultusunda.
Dialogue: 5,0:18:43.81,0:18:47.51,Main-480p,,0,0,0,,Bay 3 mü? \NDoru Doru Meyvesi yiyen adam,...
Dialogue: 5,0:18:47.53,0:18:48.98,Main-480p,,0,0,0,,...o bu adada mı?
Dialogue: 5,0:18:48.98,0:18:50.60,Main-480p,,0,0,0,,Evet.
Dialogue: 5,0:18:50.60,0:18:56.49,Main-480p,,0,0,0,,{ \q2}Bedeninden mum yapabilme ve onu isteği\Ndoğrultusunda kullanabilme yeteneğine sahip.
Dialogue: 5,0:18:58.59,0:19:00.23,Main-480p,,0,0,0,,Mum adam?
Dialogue: 5,0:19:02.53,0:19:05.70,Main-480p,,0,0,0,,SİZİ... ASLA AFFETMEYECEĞİM!
Dialogue: 5,0:19:30.89,0:19:33.75,Main-480p,,0,0,0,,Seni şeytan! Bu da ne?
Dialogue: 5,0:19:35.39,0:19:37.23,Main-480p,,0,0,0,,Ne mi dedin?
Dialogue: 5,0:19:37.23,0:19:41.46,Main-480p,,0,0,0,,Hepiniz sanat eserim olacaksınız.
Dialogue: 5,0:19:46.87,0:19:48.86,Main-480p,,0,0,0,,Şimdi sakinleş.
Dialogue: 5,0:19:48.86,0:19:55.25,Main-480p,,0,0,0,,Gerçekten Baroque Works'tan\Nkaçabileceğine inandın mı?
Dialogue: 5,0:20:01.70,0:20:05.39,Main-480p,,0,0,0,,30 milyonluk ödülü olan o adam bile \Nbizim dengimiz değil.
Dialogue: 5,0:20:06.81,0:20:09.85,Main-480p,,0,0,0,,{\q2}Viski Tepesi'nde bana yaptığını ödetme\Nşansı yakaladığım için gerçekten mutluyum.
Dialogue: 5,0:20:09.85,0:20:15.88,Main-480p,,0,0,0,,{\q2}Bu tür nazik durumlar korsanların burnunu\Nsokması gereken işlerden değildir.
Dialogue: 5,0:20:15.88,0:20:21.28,Main-480p,,0,0,0,,Kılıç ustası arkadaşını ve\Ndiğer kadını zaten yakaladık.
Dialogue: 5,0:20:21.99,0:20:24.56,Main-480p,,0,0,0,,Zoro'yu yakaladınız mı?
Dialogue: 5,0:20:24.56,0:20:27.49,Main-480p,,0,0,0,,Öyleyse... doğranacaksınız.
Dialogue: 5,0:20:28.50,0:20:30.57,Main-480p,,0,0,0,,Hala konuşuyorsun, ha?
Dialogue: 5,0:20:30.57,0:20:33.67,Main-480p,,0,0,0,,Belki de suratına küçük bir\NTekme Bombası verebilirim.
Dialogue: 5,0:20:33.67,0:20:35.77,Main-480p,,0,0,0,,Bunun beni \Nyaralayacağını mı sanıyorsun?
Dialogue: 5,0:20:35.77,0:20:38.36,Main-480p,,0,0,0,,Seni mahvedeceğim.
Dialogue: 5,0:20:42.44,0:20:43.68,Main-480p,,0,0,0,,Ne aptalca.
Dialogue: 5,0:20:47.10,0:20:48.35,Main-480p,,0,0,0,,LUFFY-{\i1}SAN{\fs10} {\r}!
Dialogue: 5,0:20:51.52,0:20:52.60,Main-480p,,0,0,0,,CEHENNEME GİT!
Dialogue: 5,0:21:05.43,0:21:07.28,Main-480p,,0,0,0,,– Ahmak.\N– Luffy-{\i1}san{\fs10} {\r}!
Dialogue: 5,0:21:07.99,0:21:10.49,Main-480p,,0,0,0,,Luffy-{\i1}san{\fs10} {\r}! Luffy-{\i1}san{\fs10} {\r}!
Dialogue: 5,0:21:10.49,0:21:12.10,Main-480p,,0,0,0,,Gidelim, Bayan Valentine!
Dialogue: 5,0:21:12.10,0:21:13.46,Main-480p,,0,0,0,,Luffy-{\i1}san{\fs10} {\r}!
Dialogue: 5,0:21:14.10,0:21:16.42,Main-480p,,0,0,0,,Usopp-{\i1}san{\fs10} {\r}! Carue!
Dialogue: 5,0:21:37.29,0:21:38.52,Main-480p,,0,0,0,,Seni ifrit!
Dialogue: 5,0:21:38.52,0:21:41.30,Main-480p,,0,0,0,,Ah, kes şunu.
Dialogue: 5,0:21:41.30,0:21:46.41,Main-480p,,0,0,0,,Mum Ceket'im katılaştığında\Nçelik kadar sert olur.
Dialogue: 5,0:21:48.20,0:21:50.97,Main-480p,,0,0,0,,Devin sınırsız gücü...
Dialogue: 5,0:21:50.97,0:21:55.14,Main-480p,,0,0,0,,...zaptedildiğinde hiçbir şey ifade etmez.
Dialogue: 5,0:21:55.14,0:21:57.53,Main-480p,,0,0,0,,Kafalarımızı kullandık,...
Dialogue: 5,0:21:57.53,0:22:00.54,Main-480p,,0,0,0,,...bu yüzden sizinle yüz yüze\Ndövüşmek zorunda kalmadık.
Dialogue: 5,0:22:01.22,0:22:04.08,Main-480p,,0,0,0,,Zaferin kafana işlemesine izin verdin.
Dialogue: 5,0:22:04.08,0:22:06.17,Main-480p,,0,0,0,,Kırmızı Ogre Brogy.
Dialogue: 5,0:22:08.14,0:22:12.65,Main-480p,,0,0,0,,Ah, bana öyle bakma.\NKorkudan dilim tutuldu.
Dialogue: 5,0:22:13.51,0:22:15.65,Main-480p,,0,0,0,,Harika hissettirdi, değil mi?
Dialogue: 0,0:22:15.65,0:22:19.69,Main-480p,,0,0,0,,O upuzun düello sonunda bitti.
Dialogue: 5,0:22:19.69,0:22:23.84,Main-480p,,0,0,0,,Bir asır boyunca onurlu bir\Nşekilde dövüştün, haklı mıyım?
Dialogue: 5,0:22:23.84,0:22:27.64,Main-480p,,0,0,0,,Bu zaferin tadı olağanüstü değil mi?
Dialogue: 5,0:22:27.64,0:22:31.91,Main-480p,,0,0,0,,Yine de bu kez dışarıdan bir\Nyardım gelmiş olabilir.
Dialogue: 5,0:22:32.61,0:22:34.20,Main-480p,,0,0,0,,Yanılıyor muyum?
Dialogue: 5,0:22:34.20,0:22:36.91,Main-480p,,0,0,0,,Seni köpek! Yoksa?!
Dialogue: 5,0:22:39.88,0:22:43.94,Main-480p,,0,0,0,,Ama sonunda, gerçek galip benim!
Dialogue: 5,0:22:43.94,0:22:50.89,Main-480p,,0,0,0,[3-liner],Biliyor muydun? Bir zamanlar ikinizin başına konan iki yüz milyon belilik ödül...
Dialogue: 5,0:22:50.89,0:22:53.64,Main-480p,,0,0,0,,...hala geçerli.
Dialogue: 5,0:22:54.53,0:22:55.61,Main-480p,,0,0,0,,Seni şeytan!
Dialogue: 5,0:22:55.61,0:22:59.90,Main-480p,,0,0,0,,Gömülü bir hazine keşfetmiş gibiyim.
Dialogue: 5,0:23:00.70,0:23:03.44,Main-480p,,0,0,0,,Demek planın buydu!
Dialogue: 5,0:23:03.44,0:23:05.13,Main-480p,,0,0,0,,Bay 3!
Dialogue: 5,0:23:05.80,0:23:06.94,Main-480p,,0,0,0,,Onu getirdik.
Dialogue: 5,0:23:07.60,0:23:09.52,Main-480p,,0,0,0,,Örgütümüzün haini.
Dialogue: 5,0:23:09.52,0:23:12.25,Main-480p,,0,0,0,,Çok yavaşsınız.\NUzun zamandır bekliyordum.
Dialogue: 5,0:23:12.25,0:23:15.41,Main-480p,,0,0,0,,Yöntemlerin çok pis, Bay 3!
Dialogue: 5,0:23:15.41,0:23:18.76,Main-480p,,0,0,0,,Gerçekten Dorry-san'ın birasına bomba koydunuz!
Dialogue: 5,0:23:18.76,0:23:19.82,Main-480p,,0,0,0,,Ne?
Dialogue: 5,0:23:20.51,0:23:21.88,Main-480p,,0,0,0,,Bira?!
Dialogue: 5,0:23:22.23,0:23:25.26,Thoughts-480p,,0,0,0,,Ona verdiğim bira!
Dialogue: 5,0:23:27.60,0:23:31.22,Flashbacks-480p,,0,0,0,,Dorry! Uzun bir sürenin ardından, \No bira gerçekten olağanüstüydü!
Dialogue: 5,0:23:31.22,0:23:35.47,Flashbacks-480p,,0,0,0,,Evet. İlahi bir tadı vardı.
Dialogue: 5,0:23:35.47,0:23:39.06,Thoughts-480p,,0,0,0,,Kastettiğin bu muydu? Dorry!
Dialogue: 5,0:23:39.69,0:23:43.48,Main-480p,,0,0,0,,Demek genç bayan küçük numaramı anlamış.
Dialogue: 5,0:23:43.48,0:23:47.44,Main-480p,,0,0,0,,Bununla birlikte, şimdi beni durdurmak\Niçin yapabileceği bir şey yok.
Dialogue: 5,0:23:49.03,0:23:51.86,Main-480p,,0,0,0,,{\fad(150,0)}Mum!
Dialogue: 5,0:23:51.86,0:23:53.55,Main-480p,,0,0,0,,{\fad(0,150)}Kilit!
Dialogue: 5,0:24:02.25,0:24:03.75,Main-480p,,0,0,0,,Bay 5.
Dialogue: 5,0:24:03.75,0:24:05.71,Main-480p,,0,0,0,,Kılıç ustasını ve kızı bana getirin.
Dialogue: 5,0:24:06.40,0:24:07.38,Main-480p,,0,0,0,,Başlıyorum.
Dialogue: 5,0:24:14.34,0:24:19.18,Main-480p,,0,0,0,,{\fad(150,150)}Süper Büyük Mum Seti!
Dialogue: 5,0:24:53.86,0:24:56.60,Main-480p,,0,0,0,,Demek bu Bay 3'ün gücü.
Dialogue: 5,0:25:02.31,0:25:03.77,Main-480p,,0,0,0,,Ne yapıyor bu?
Dialogue: 5,0:25:04.41,0:25:06.23,Main-480p,,0,0,0,,İşte geldiler.
Dialogue: 5,0:25:11.38,0:25:12.69,Main-480p,,0,0,0,,Ne hayalkırıklığı ama.
Dialogue: 5,0:25:14.35,0:25:17.50,Main-480p,,0,0,0,,Seviyesiz bir grup tarafından yenilmişim.
Dialogue: 5,0:25:17.63,0:25:20.38,Main-480p,,0,0,0,,O kadar utanç verici ki\Nkendimden utanıyorum.
Dialogue: 5,0:25:21.02,0:25:23.79,Main-480p,,0,0,0,,Bu sadece güçsüz olduğun için oldu.
Dialogue: 5,0:25:23.79,0:25:25.41,Main-480p,,0,0,0,,Ha? Ne dedin sen?
Dialogue: 5,0:25:25.41,0:25:26.55,Main-480p,,0,0,0,,Bir şey demedim.
Dialogue: 5,0:25:26.57,0:25:28.80,Main-480p,,0,0,0,,Acele et ve onları \NMum Seti'nin üstüne yerleştir.
Dialogue: 5,0:25:29.10,0:25:30.36,Main-480p,,0,0,0,,Set mi?
Dialogue: 5,0:25:30.75,0:25:33.22,Main-480p,,0,0,0,,O şey de ne?
Dialogue: 5,0:25:33.22,0:25:35.94,Main-480p,,0,0,0,,Nami-{\i1}san{\i0}{...}! Bay Bushido{...}!
Dialogue: 5,0:25:35.94,0:25:39.68,Main-480p,,0,0,0,,Vivi! Luffy'le değil miydin?
Dialogue: 5,0:25:39.68,0:25:41.38,Main-480p,,0,0,0,,Evet... Ama...
Dialogue: 5,0:25:41.38,0:25:45.31,Main-480p,,0,0,0,,Hasır Şapka'yı kastediyorsan, \Nişini bitirdim.
Dialogue: 5,0:25:46.80,0:25:49.27,Main-480p,,0,0,0,,Kolay bir işti.
Dialogue: 5,0:25:49.27,0:25:51.26,Main-480p,,0,0,0,,Sen mi?
Dialogue: 5,0:26:20.68,0:26:24.39,Main-480p,,0,0,0,,Hepiniz hoş geldiniz!\NBenim Servis Setime!
Dialogue: 5,0:26:27.04,0:26:31.71,Main-480p,,0,0,0,,Demek böyle bir his, ha?\NPasta üzerindeki mum olmak.
Dialogue: 5,0:26:31.71,0:26:35.11,Main-480p,,0,0,0,,Orada dönüp duran şey de ne?
Dialogue: 5,0:26:37.32,0:26:39.03,Main-480p,,0,0,0,,Bacaklarımı kıpırdatamıyorum bile.
Dialogue: 5,0:26:39.03,0:26:42.49,Main-480p,,0,0,0,,Niye hareket etmemize izin versin?
Dialogue: 5,0:26:42.49,0:26:44.04,Main-480p,,0,0,0,,Düşmanımız olduğunu biliyorsun.
Dialogue: 5,0:26:47.50,0:26:49.90,Main-480p,,0,0,0,,Kahretsin. Çok sert.
Dialogue: 5,0:26:49.90,0:26:53.44,Main-480p,,0,0,0,,Üstelik bu pozisyonda gücümü\Nhiç kullanamıyorum.
Dialogue: 5,0:26:54.18,0:26:55.38,Main-480p,,0,0,0,,Bir şey düşüyor!
Dialogue: 5,0:26:57.30,0:27:00.76,Main-480p,,0,0,0,,Mum Servisi'min tadını çıkarın!
Dialogue: 5,0:27:00.76,0:27:03.86,Main-480p,,0,0,0,,Düşen mum parçacıkları...
Dialogue: 5,0:27:03.86,0:27:06.73,Main-480p,,0,0,0,,...bedenlerinizi mumdan figürlere\Ndönüştürecek.
Dialogue: 5,0:27:06.73,0:27:10.82,Main-480p,,0,0,0,,Artistik yeteneklerimin bile\Nyapamayacağı bir şey var:...
Dialogue: 5,0:27:10.82,0:27:13.77,Main-480p,,0,0,0,,...mükemmel insan büstü.
Dialogue: 5,0:27:13.77,0:27:19.49,Main-480p,,0,0,0,,Adından anlaşıldığı gibi yakında ruh içeren\Nmumdan figürler olacaksınız.
Dialogue: 5,0:27:19.49,0:27:23.70,Main-480p,,0,0,0,,Sanatım uğruna öleceksiniz.
Dialogue: 5,0:27:23.70,0:27:25.33,Main-480p,,0,0,0,,Hiç de olmayacağım!
Dialogue: 5,0:27:26.14,0:27:29.71,Main-480p,,0,0,0,,Niye senin "sanatın" olmak zorundayız?!
Dialogue: 5,0:27:29.71,0:27:33.03,Main-480p,,0,0,0,,Brogy-san! Orada öylece yatma!
Dialogue: 5,0:27:33.03,0:27:35.57,Main-480p,,0,0,0,,Bir şey yap, yoksa sen de \Nmum figür olacaksın!
Dialogue: 5,0:27:35.57,0:27:38.34,Main-480p,,0,0,0,,Ama cidden dev gibi insanlar.
Dialogue: 5,0:27:39.24,0:27:42.58,Main-480p,,0,0,0,,Ona yalvarmak faydasız.
Dialogue: 5,0:27:42.58,0:27:49.56,Main-480p,,0,0,0,,Rakibinin yaralarını farketmeden\Nyüz yıldır dövüştüğü arkadaşını...
Dialogue: 5,0:27:49.56,0:27:53.31,Main-480p,,0,0,0,,...Dorry'i, kendi elleriyle\Nöldürdüğünü daha yeni farketti.
Dialogue: 5,0:27:53.31,0:28:00.99,Main-480p,,0,0,0,,Üstelik o ahmak, \Nzaferinin sevinç gözyaşlarını akıttı!
Dialogue: 5,0:28:00.99,0:28:04.78,Main-480p,,0,0,0,,Ya da belki, sevgili arkadaşını\Nkaybedişine üzülüyordun?
Dialogue: 5,0:28:06.04,0:28:10.16,Main-480p,,0,0,0,,Evet, şimdi ona yardım etmek için\Nhiçbir şey yapılamaz, seni ahmak!
Dialogue: 5,0:28:20.05,0:28:22.09,Main-480p,,0,0,0,,Biliyordum.
Dialogue: 5,0:28:23.01,0:28:26.05,Main-480p,,0,0,0,,Bir şeylerin ters gittiğini biliyordum.
Dialogue: 5,0:28:31.10,0:28:33.90,Main-480p,,0,0,0,,Dövüşümüze başladığımız andan itibaren...
Dialogue: 5,0:28:33.90,0:28:36.82,Main-480p,,0,0,0,,...Dorry'nin bir şey gizlediğini biliyordum.
Dialogue: 5,0:28:37.56,0:28:39.97,Main-480p,,0,0,0,,Farkettiğini mi söylüyorsun?
Dialogue: 5,0:28:39.97,0:28:40.86,Main-480p,,0,0,0,,Yalancı!
Dialogue: 5,0:28:40.86,0:28:44.10,Main-480p,,0,0,0,,Öyleyse, niye dövüşmeye devam ettin?
Dialogue: 5,0:28:44.10,0:28:50.07,Main-480p,,0,0,0,,Ne kadar sert dövüştüğünü gördüm.\NEn ufak sempati kırıntısı bile görmedim!
Dialogue: 5,0:28:53.29,0:28:56.15,Main-480p,,0,0,0,,Düello kelimesinin önemini\Nanlamayan bir çocuğun,...
Dialogue: 5,0:28:56.15,0:28:59.20,Main-480p,,0,0,0,,...gözyaşlarımın sebebini\Nanlaması nasıl mümkün olabilir?!
Dialogue: 5,0:29:00.10,0:29:02.66,Main-480p,,0,0,0,,Sen ne bilirsin ki?
Dialogue: 5,0:29:02.66,0:29:04.65,Main-480p,,0,0,0,,Bir savaşçı yarasını gizleyerek\Ndövüşmeye devam ediyor...
Dialogue: 5,0:29:04.65,0:29:08.64,Main-480p,,0,0,0,,...ve sen de ona hakaret etme\Ncüretini mi gösteriyorsun?!
Dialogue: 5,0:29:11.93,0:29:18.82,Main-480p,,0,0,0,,DÜELLO İSTEYEN BİR SAVAŞÇIYA KARŞI\NNASIL SEMPATİ GÖSTEREBİLİRSİN?!
Dialogue: 5,0:29:19.77,0:29:22.74,Main-480p,,0,0,0,,Şimdi... bunun nasıl olduğunu anlıyorum.
Dialogue: 5,0:29:23.68,0:29:27.70,Main-480p,,0,0,0,,Anladığıma göre, \Nbunu kendi ellerimle bitireceğim!
Dialogue: 5,0:29:36.19,0:29:40.63,Main-480p,,0,0,0,,En iyi arkadaşım Dorry'e karşı bir\Nnezaket olarak!
Dialogue: 5,0:29:45.18,0:29:46.38,Main-480p,,0,0,0,,Brogy-{\i1}san{\fs10} {\r}!
Dialogue: 5,0:29:58.34,0:30:00.23,Main-480p,,0,0,0,,– Brogy-{\i1}san{\fs10} {\r}!\N– Brogy-{\i1}san{\fs10} {\r}!
Dialogue: 5,0:30:00.89,0:30:03.19,Main-480p,,0,0,0,,Ne sinir bozucu bir canavar.
Dialogue: 5,0:30:04.60,0:30:08.13,Main-480p,,0,0,0,,U-Usopp{...}.
Dialogue: 5,0:30:08.13,0:30:09.80,Main-480p,,0,0,0,,Usopp{...}.
Dialogue: 5,0:30:12.66,0:30:16.25,Main-480p,,0,0,0,,Onları... affedebilir misin?
Dialogue: 5,0:30:16.25,0:30:19.71,Main-480p,,0,0,0,,Mümkün değil.\NOnları affedemem.
Dialogue: 5,0:30:29.99,0:30:32.97,Main-480p,,0,0,0,,Sen de mi... kızgınsın?
Dialogue: 5,0:30:39.33,0:30:44.32,Main-480p,,0,0,0,,Tamam, haklayalım onları!\NOnları mahvedeceğiz!
Dialogue: 5,0:30:44.32,0:30:46.34,Main-480p,,0,0,0,,Brogy-{\i1}san{\fs10} {\r}!
Dialogue: 5,0:30:46.34,0:30:47.28,Main-480p,,0,0,0,,Ne ahmak ama!
Dialogue: 5,0:30:48.53,0:30:51.56,Main-480p,,0,0,0,,Görünüşe bakılırsa onu hafife almışım.
Dialogue: 5,0:30:51.59,0:30:53.79,Main-480p,,0,0,0,,Bir devin gücünün bu kadar büyük\Nolmasını ben bile beklemiyordum!
Dialogue: 5,0:30:55.45,0:30:58.83,Main-480p,,0,0,0,,Sanırım onu daha düzgün zaptetmeliyim.
Dialogue: 5,0:30:58.83,0:31:02.42,Main-480p,,0,0,0,,{\fad(150,150)}Doru Doru Sanatları Kelepçe!
Dialogue: 5,0:31:05.30,0:31:06.76,Main-480p,,0,0,0,,Biraz daha!
Dialogue: 5,0:31:13.30,0:31:15.97,Main-480p,,0,0,0,,Şimdi son darbe!
Dialogue: 5,0:31:15.97,0:31:17.02,Main-480p,,0,0,0,,İşte!
Dialogue: 5,0:31:26.44,0:31:29.40,Main-480p,,0,0,0,,Artık tamamiyle hareketsiz kaldın!
Dialogue: 5,0:31:37.80,0:31:39.96,Main-480p,,0,0,0,,Ne acımasız bir işkence!
Dialogue: 5,0:31:39.96,0:31:42.92,Main-480p,,0,0,0,,Acele et, Mum Servisim!
Dialogue: 5,0:31:42.92,0:31:47.64,Main-480p,,0,0,0,,Onları mum figürlerim haline getir!
Dialogue: 5,0:31:52.81,0:31:54.61,Main-480p,,0,0,0,,Göğsüm acıyor.
Dialogue: 5,0:31:54.61,0:31:57.00,Main-480p,,0,0,0,,Mum buharı ciğerlerime giriyor.
Dialogue: 5,0:31:57.00,0:32:00.39,Main-480p,,0,0,0,,Bu devam ederse, bedenim içten\Ndışa doğru mum figür olacak!
Dialogue: 5,0:32:01.41,0:32:06.36,Main-480p,,0,0,0,,Evet, evet. Katlanabileceğiniz tüm\Nacıyı bana gösterin!
Dialogue: 5,0:32:06.36,0:32:12.36,Main-480p,,0,0,0,,Istırap ve acının umutsuz yüzü\Nen değer verdiğim sanat türüdür!
Dialogue: 5,0:32:13.32,0:32:15.37,Main-480p,,0,0,0,,O umutsuz bakışı sertleştirin!
Dialogue: 5,0:32:15.37,0:32:18.33,Main-480p,,0,0,0,,Bu ne tür bir sanat, seni hasta,\Ndüğüm saçlı kaçık?
Dialogue: 5,0:32:18.33,0:32:22.27,Main-480p,,0,0,0,,Brogy-san'a bunu yapamaya nasıl\Ncüret edersin?!
Dialogue: 5,0:32:22.27,0:32:25.57,Main-480p,,0,0,0,,Hak ettiğini bulacaksın!\NDuyuyor musun?!
Dialogue: 5,0:32:27.44,0:32:30.10,Main-480p,,0,0,0,,İstediğin kadar bağır!
Dialogue: 5,0:32:36.45,0:32:38.14,Thoughts-480p,,0,0,0,,Yüz yıl...
Dialogue: 5,0:32:46.11,0:32:51.07,Thoughts-480p,,0,0,0,,Gün be gün, dövüş üstüne dövüş...
Dialogue: 5,0:32:51.07,0:32:56.87,Thoughts-480p,,0,0,0,, Savaşçılar Köyü Elbaf'tan içimize\Ndoğan onurla mücadele ettik.
Dialogue: 5,0:32:56.87,0:33:03.24,Thoughts-480p,,0,0,0,,Ama niye böyle sona erdi?!\NSavaş Tanrısı Elbaf!
Dialogue: 5,0:33:05.89,0:33:11.21,Thoughts-480p,,0,0,0,,İlan ettiğin hüküm bu mu? Elbaf!
Dialogue: 5,0:33:11.21,0:33:13.39,Thoughts-480p,,0,0,0,,BUNU NİYE YAPTIN?!
Dialogue: 5,0:33:13.39,0:33:16.98,Thoughts-480p,,0,0,0,,NİYE DÖVÜŞTE ÖLMÜYORUM?!
Dialogue: 5,0:33:19.51,0:33:21.64,Main-480p,,0,0,0,,Ne mükemmel bir yüz ifadesi!
Dialogue: 5,0:33:21.64,0:33:25.50,Main-480p,,0,0,0,,Harikulade! Acı, kederli, ıstırap\Nçeken yüz ifadesi,...
Dialogue: 5,0:33:25.50,0:33:28.97,Main-480p,,0,0,0,,...sanatın en üst şekli!
Dialogue: 5,0:33:28.97,0:33:31.40,Thoughts-480p,,0,0,0,,ELBAF!!
Dialogue: 5,0:33:32.11,0:33:34.04,Main-480p,,0,0,0,,Olamaz! Ellerimi hareket ettiremiyorum!
Dialogue: 5,0:33:34.04,0:33:36.59,Main-480p,,0,0,0,,Bu şekilde ölmek istemiyorum!\NBir şey yapamaz mıyız?
Dialogue: 5,0:33:36.59,0:33:38.78,Main-480p,,0,0,0,,Bedenim çoktan sertleşmeye başladı!
Dialogue: 5,0:33:38.78,0:33:40.49,Main-480p,,0,0,0,,Ne yapabiliriz?!
Dialogue: 5,0:33:41.14,0:33:43.25,Main-480p,,0,0,0,,Zoro, bir şey düşün!
Dialogue: 5,0:33:43.25,0:33:45.58,Main-480p,,0,0,0,,Hey, amca.
Dialogue: 5,0:33:45.58,0:33:47.42,Main-480p,,0,0,0,,Hala kıpırdayabiliyorsun, değil mi?
Dialogue: 5,0:33:48.11,0:33:49.95,Main-480p,,0,0,0,,Ben de hala kıpırdayabiliyorum.
Dialogue: 5,0:33:51.84,0:33:55.30,Main-480p,,0,0,0,,Bu herifleri benimle birlikte\Nöldürebilecek gibi hissediyor musun?
Dialogue: 5,0:33:56.47,0:33:59.74,Main-480p,,0,0,0,,Zoro, sen ne- Yoksa?!
Dialogue: 5,0:33:59.74,0:34:00.47,Main-480p,,0,0,0,,Evet.
Dialogue: 5,0:34:00.47,0:34:02.89,Main-480p,,0,0,0,,Kendi bacaklarını mı keseceksin?!\NŞakayı bırak!
Dialogue: 5,0:34:02.89,0:34:07.07,Main-480p,,0,0,0,,Şaka değil.\NBuradan çıkmamızın tek yolu bu.
Dialogue: 5,0:34:07.07,0:34:08.07,Main-480p,,0,0,0,,Kararınız nedir?
Dialogue: 5,0:34:08.07,0:34:09.70,Main-480p,,0,0,0,,Kararımız mı?\NMümkün değil!
Dialogue: 5,0:34:09.70,0:34:12.44,Main-480p,,0,0,0,,Aşağı inmeyi başarsak bile\Nhemen yeniden yakalanacağız!
Dialogue: 5,0:34:12.44,0:34:15.40,Main-480p,,0,0,0,,Denemezsen nasıl bilebilirsin?
Dialogue: 5,0:34:16.02,0:34:19.02,Main-480p,,0,0,0,,Zaten burada öleceğiz.
Dialogue: 5,0:34:19.02,0:34:21.37,Main-480p,,0,0,0,,Niye bunu çirkinleştirip\Nbiraz çabalamayalım?
Dialogue: 5,0:34:22.02,0:34:25.46,Main-480p,,0,0,0,,Bu değersiz böceklere karşı bu\Nkadar kolay ölmek için bir sebep yok!
Dialogue: 5,0:34:25.46,0:34:26.69,Main-480p,,0,0,0,,Değil mi?
Dialogue: 5,0:34:26.69,0:34:29.35,Main-480p,,0,0,0,,Neden bahsediyor bu? Delirmiş mi?
Dialogue: 5,0:34:29.35,0:34:33.13,Main-480p,,0,0,0,,Blöf yapıyorsun. Kendine böyle bir\Nşey yapabilmen mümkün değil!
Dialogue: 5,0:34:33.13,0:34:34.90,Main-480p,,0,0,0,,Bu sadece sert adam rolü!
Dialogue: 5,0:34:37.90,0:34:40.44,Main-480p,,0,0,0,,Ne korkusuz bir çocuk.
Dialogue: 5,0:34:40.44,0:34:45.27,Main-480p,,0,0,0,,Dövüşme sebebimi kaybettiğimi düşünmüştüm.
Dialogue: 5,0:34:45.27,0:34:48.73,Main-480p,,0,0,0,,Böyle bir isteği, nasıl geri çevirebilirim?!
Dialogue: 5,0:34:50.65,0:34:52.76,Main-480p,,0,0,0,,Şaka yapıyorsun, değil mi?\NCiddi misin?
Dialogue: 5,0:34:52.76,0:34:55.18,Main-480p,,0,0,0,,Bacakların olmadan nasıl dövüşeceksin?
Dialogue: 5,0:34:55.18,0:34:56.11,Main-480p,,0,0,0,,Bilmem.
Dialogue: 5,0:34:56.11,0:34:59.70,Main-480p,,0,0,0,,Ama... kazanmayı planlıyorum.
Dialogue: 5,0:35:00.49,0:35:03.70,Main-480p,,0,0,0,,Bu herifin nesi var?!\NDelirmiş!
Dialogue: 5,0:35:04.33,0:35:05.97,Thoughts-480p,,0,0,0,,Böyle bir adam nasıl var olabilir?
Dialogue: 5,0:35:05.97,0:35:10.00,Thoughts-480p,,0,0,0,,Ama, o gözleri daha önce bir\Nyerde görmüşüm gibi.
Dialogue: 5,0:35:10.00,0:35:11.67,Flashbacks-480p,,0,0,0,,Prenses Vivi.
Dialogue: 5,0:35:11.67,0:35:14.84,Flashbacks-480p,,0,0,0,,Ölmemek için kesin kararını verdin mi?
Dialogue: 5,0:35:14.84,0:35:17.44,Main-480p,,0,0,0,,B-Bekle! Ben de dövüşeceğim!
Dialogue: 5,0:35:17.44,0:35:19.59,Main-480p,,0,0,0,,– Vivi!\N– Tamam. Anlaşıldı.
Dialogue: 5,0:35:19.59,0:35:23.18,Main-480p,,0,0,0,,Başlıyoruz, çocuk!
Dialogue: 5,0:35:23.18,0:35:26.35,Main-480p,,0,0,0,,Denemeyin bile! Ne yapabileceğinizi\Nsanıyorsunuz?!
Dialogue: 5,0:35:36.44,0:35:37.76,Main-480p,,0,0,0,,Hey, siz!
Dialogue: 5,0:35:37.76,0:35:40.17,Main-480p,,0,0,0,,SİZİ MAHVEDECEĞİM!
Dialogue: 5,0:35:43.00,0:35:44.37,Main-480p,,0,0,0,,Ne?
Dialogue: 5,0:35:45.91,0:35:47.84,Main-480p,,0,0,0,,– Hadi yapalım, Usopp!\N– TAMAM!
Dialogue: 5,0:35:47.84,0:35:49.50,Main-480p,,0,0,0,,Kuş!
Dialogue: 5,0:35:49.50,0:35:51.37,Main-480p,,0,0,0,,Luffy! Usopp!
Dialogue: 5,0:35:51.37,0:35:52.50,Main-480p,,0,0,0,,Carue!
Dialogue: 5,0:35:52.50,0:35:56.70,Main-480p,,0,0,0,,Efendi Brogy!\NAcının intikamını almak için geldik!
Dialogue: 5,0:35:56.70,0:35:57.68,Main-480p,,0,0,0,,Usopp{...}!
Dialogue: 5,0:35:57.68,0:36:00.70,Main-480p,,0,0,0,,Bu herifleri delik deşik olana dek...
Dialogue: 5,0:36:00.70,0:36:02.74,Main-480p,,0,0,0,,...hamur gibi yoğurun ve sonra\Nda uçurun gitsin!!
Dialogue: 5,0:36:02.74,0:36:04.73,Main-480p,,0,0,0,,Evet. Yapmayı planladığım şey bu!
Dialogue: 5,0:36:04.73,0:36:08.64,Main-480p,,0,0,0,,Dev amcaların düellosunu mahvettiler!
Dialogue: 5,0:36:08.64,0:36:13.40,Main-480p,,0,0,0,,Ah, sen misin? East Blue'daki en\Nbüyük ödüle sahip adam?
Dialogue: 5,0:36:13.40,0:36:16.32,Main-480p,,0,0,0,,Denizci Karargahları standartlarını\Ndüşürmüş gibi görünüyor.
Dialogue: 5,0:36:16.32,0:36:18.93,Main-480p,,0,0,0,,– Aaaa! Tuhaf bir kafan var!\N– Seni ilgilendirmez!
Dialogue: 5,0:36:18.93,0:36:21.32,Main-480p,,0,0,0,,– Bu 3! Üç ve yanıyor!\N– KAPA ÇENENİ!
Dialogue: 5,0:36:21.32,0:36:24.08,Main-480p,,0,0,0,,Ondan önce, Luffy, şu sütunu yok et!
Dialogue: 5,0:36:24.08,0:36:27.05,Main-480p,,0,0,0,,Mumdan figürler olmak üzereyiz!
Dialogue: 5,0:36:27.90,0:36:29.20,Main-480p,,0,0,0,,Ne? Başınız dertte miydi?
Dialogue: 5,0:36:29.20,0:36:31.45,Main-480p,,0,0,0,,Hayır, önemli bir şey değil.
Dialogue: 5,0:36:31.45,0:36:32.92,Main-480p,,0,0,0,,Dur biraz, bacakların!
Dialogue: 5,0:36:32.92,0:36:35.70,Main-480p,,0,0,0,,Ah, sadece yarısına kadar kestim.
Dialogue: 5,0:36:35.70,0:36:39.17,Main-480p,,0,0,0,,Nasıl "önemli bir şey değil" dersin?!
Dialogue: 5,0:36:39.17,0:36:43.34,Main-480p,,0,0,0,,Her neyse Luffy, önce şu sütunu\Nyok edebilir misin?
Dialogue: 5,0:36:43.34,0:36:45.06,Main-480p,,0,0,0,,Gerisini sana bırakacağım.
Dialogue: 5,0:36:45.82,0:36:47.31,Main-480p,,0,0,0,,Tamam.
Dialogue: 5,0:36:48.27,0:36:50.22,Main-480p,,0,0,0,,Ben öyle düşünmüyorum.
Dialogue: 5,0:36:50.22,0:36:53.79,Main-480p,,0,0,0,,O şey her neyse önce onu yok et.
Dialogue: 5,0:36:53.79,0:36:56.15,Main-480p,,0,0,0,,Tamam. Anladım.
Dialogue: 5,0:36:56.15,0:36:59.37,Main-480p,,0,0,0,,Bugün farklı bir adamım!
Dialogue: 5,0:37:02.03,0:37:04.57,Main-480p,,0,0,0,,Lanet olsun acele edin! Sertleşiyoruz!
