Dialogue: 2,0:01:50.04,0:01:53.34,Title-480p,,0,0,0,,{\pos(320,305)\bord0\4a&HFF&\blur0.6\fad(700,700)}Luffy,  Bay 3'e Karşı
Dialogue: 5,0:02:14.24,0:02:16.46,Main-480p,,0,0,0,,Zoro, ne yapıyorsun?
Dialogue: 5,0:02:16.46,0:02:18.40,Main-480p,,0,0,0,,Büst olacaksam bu pozda\Nolmak istiyorum.
Dialogue: 5,0:02:18.40,0:02:20.37,Main-480p,,0,0,0,,Dalga geçecek zaman değil!
Dialogue: 5,0:02:21.20,0:02:22.83,Main-480p,,0,0,0,,Dalga geçmiyorum.
Dialogue: 5,0:02:23.60,0:02:27.80,Main-480p,,0,0,0,,{\q2}Daha da önemlisi, bacakların konusunda bir\Nşey yap. Onlara bakmak bile acı veriyor.
Dialogue: 5,0:02:27.80,0:02:30.04,Main-480p,,0,0,0,,Öyleyse bakma.
Dialogue: 5,0:02:30.76,0:02:36.73,Main-480p,,0,0,0,,Neyse, sana bacaklarını kesip\Nkaçmanın aptalca olduğunu söylemiştim.
Dialogue: 5,0:02:36.73,0:02:37.92,Main-480p,,0,0,0,,Kaçmayacaktım.
Dialogue: 5,0:02:37.92,0:02:40.69,Main-480p,,0,0,0,,Bacaklarımı dövüşebilmek için kesiyordum.
Dialogue: 5,0:02:40.69,0:02:43.60,Main-480p,,0,0,0,,Bu daha da aptalca, şaka yapıyor olmalısın.
Dialogue: 5,0:02:43.60,0:02:45.60,Main-480p,,0,0,0,,Kapa çeneni.
Dialogue: 5,0:02:45.60,0:02:50.20,Main-480p,,0,0,0,,Üff, zaten siz erkeklerin hiç\Nsağduyusu yok.
Dialogue: 5,0:02:50.20,0:02:54.81,Thoughts-480p,,0,0,0,,Tehlikeden kaçmaya yakın bile değiliz.
Dialogue: 5,0:02:54.81,0:02:58.75,Thoughts-480p,,0,0,0,,Yine de biraz bile endişeli görünmüyorlar.
Dialogue: 5,0:03:03.29,0:03:06.87,Main-480p,,0,0,0,,Hey çocuk, çabalaman hemen bitti mi?
Dialogue: 5,0:03:06.87,0:03:10.87,Main-480p,,0,0,0,,Evet, başkasının çabalamasına izin\Nverme vakti gelmiş gibi görünüyor.
Dialogue: 5,0:03:12.28,0:03:13.54,Main-480p,,0,0,0,,Anlıyorum.
Dialogue: 5,0:03:16.08,0:03:19.80,Main-480p,,0,0,0,,Bay 3, onlar çok rahat görünüyor.
Dialogue: 5,0:03:19.80,0:03:24.18,Main-480p,,0,0,0,,Sen de öylesin, Bayan Altın Hafta!
Dialogue: 5,0:03:24.18,0:03:25.92,Main-480p,,0,0,0,,Lanet olsun!
Dialogue: 5,0:03:26.89,0:03:29.58,Main-480p,,0,0,0,,Hey, poz vermek istiyorsanız,\Nşimdi yapsanız iyi olur.
Dialogue: 5,0:03:29.58,0:03:31.45,Main-480p,,0,0,0,,Beni tuhaf fantezilerine sürükleme!
Dialogue: 5,0:03:31.45,0:03:34.69,Main-480p,,0,0,0,,Bay Bushido! Lütfen bunu biraz\Ndaha ciddiye alın!
Dialogue: 5,0:03:34.69,0:03:36.45,Main-480p,,0,0,0,,Ben her zaman ciddiyim.
Dialogue: 5,0:03:36.45,0:03:38.73,Main-480p,,0,0,0,,Bu yüzden çok aptalsın.
Dialogue: 5,0:03:38.73,0:03:42.43,Main-480p,,0,0,0,,Görünüşe göre artık ciddiye alınmıyoruz.
Dialogue: 5,0:03:38.73,0:03:42.43,Secondary-480p,,0,0,0,,Bunu duymak istediğim son kişi sensin!
Dialogue: 5,0:03:42.43,0:03:44.74,Main-480p,,0,0,0,,Bu çok sinir bozucu.
Dialogue: 5,0:03:45.95,0:03:47.28,Main-480p,,0,0,0,,Tamam!
Dialogue: 5,0:03:47.96,0:03:52.16,Main-480p,,0,0,0,,Bana sorarsan, özellikle güvenilir\Nbir adam gibi görünmüyor.
Dialogue: 5,0:03:52.16,0:03:53.96,Main-480p,,0,0,0,,Bay 3.
Dialogue: 5,0:03:53.96,0:03:56.90,Main-480p,,0,0,0,,Onun işini bitirmemize izin ver.
Dialogue: 5,0:03:56.90,0:03:58.42,Main-480p,,0,0,0,,"İşini bitirmek" mi?
Dialogue: 5,0:03:59.32,0:04:01.09,Main-480p,,0,0,0,,Şaka yapıyor olmalısınız.
Dialogue: 5,0:04:01.79,0:04:03.24,Main-480p,,0,0,0,,Şuna baksanıza.
Dialogue: 5,0:04:03.24,0:04:08.38,Main-480p,,0,0,0,,Saldırılarınızın etkisi yok. Bu yüzden\Ncanlı olarak karşımızda duruyor.
Dialogue: 5,0:04:08.38,0:04:13.74,Main-480p,,0,0,0,,Bu adamın sizin seviyenizdekilerle\Nhalledilemeyeceği ortada.
Dialogue: 5,0:04:16.12,0:04:19.85,Main-480p,,0,0,0,,Siz diğerleriyle ilgilenin.
Dialogue: 5,0:04:20.26,0:04:26.57,Main-480p,,0,0,0,,Hasır Şapkalı Luffy'yi kişisel mum\Nfigür koleksiyonuma ekleyeceğim.
Dialogue: 5,0:04:30.43,0:04:33.71,Main-480p,,0,0,0,,Gevezelik etmeyi bırakamaz mısın?
Dialogue: 5,0:04:34.42,0:04:38.80,Main-480p,,0,0,0,,Siz pislikler çok ileri gittiniz!\NHala yapabiliyorken vazgeçin!
Dialogue: 5,0:04:40.01,0:04:41.34,Main-480p,,0,0,0,,Küçük sinek.
Dialogue: 5,0:04:43.13,0:04:44.84,Main-480p,,0,0,0,,Hadi yapalım!
Dialogue: 5,0:04:49.06,0:04:53.98,Main-480p,,0,0,0,,Tamam! Hazırlıklar tamamlandı!\NArkanı kolluyorum, Luffy!
Dialogue: 5,0:04:55.01,0:04:56.35,Main-480p,,0,0,0,,Bir şey mi dedin?
Dialogue: 5,0:04:56.35,0:04:58.13,Main-480p,,0,0,0,,Sanırım başlama vakti geldi!
Dialogue: 5,0:04:58.13,0:05:00.90,Main-480p,,0,0,0,,{\fad(150,150)}MUM KİLİT!
Dialogue: 5,0:05:04.32,0:05:06.33,Main-480p,,0,0,0,,O da ne öyle?!
Dialogue: 5,0:05:08.20,0:05:11.41,Main-480p,,0,0,0,,– Luffy-{\i1}san{\fs10} {\r}!\N– Ne, hemen yakalandı mı?
Dialogue: 5,0:05:11.41,0:05:12.54,Main-480p,,0,0,0,,Sakar!
Dialogue: 5,0:05:13.80,0:05:16.88,Main-480p,,0,0,0,,Bu şey de ne? Çekiç kadar ağır.
Dialogue: 5,0:05:16.88,0:05:18.97,Main-480p,,0,0,0,,Çok kolaydı.
Dialogue: 5,0:05:20.70,0:05:22.46,Main-480p,,0,0,0,,Sırada ellerin var!
Dialogue: 5,0:05:26.38,0:05:28.60,Main-480p,,0,0,0,,Oooo, bu mükemmel!
Dialogue: 5,0:05:28.60,0:05:31.00,Main-480p,,0,0,0,,{\fad(150,150)}MUM KİLİT!
Dialogue: 5,0:05:38.73,0:05:40.89,Main-480p,,0,0,0,,Dev-ossan!
Dialogue: 5,0:05:41.65,0:05:43.40,Main-480p,,0,0,0,,Seni biraz ödünç almalıyım!
Dialogue: 5,0:05:43.40,0:05:46.86,Main-480p,,0,0,0,,Ne? Ne yapmaya çalışıyor olabilir?
Dialogue: 5,0:05:56.62,0:05:59.38,Main-480p,,0,0,0,,{\fad(150,150)}Gomu Gomu No...
Dialogue: 5,0:05:59.38,0:06:00.79,Main-480p,,0,0,0,,{\fad(150,150)}Çekiç
Dialogue: 5,0:06:04.84,0:06:06.38,Main-480p,,0,0,0,,Başardı!
Dialogue: 5,0:06:24.51,0:06:27.71,Main-480p,,0,0,0,,Ne şans! Ayağımdaki çekiç kırıldı!
Dialogue: 5,0:06:39.56,0:06:40.79,Main-480p,,0,0,0,,Yaşıyoruz.
Dialogue: 5,0:06:42.80,0:06:44.50,Main-480p,,0,0,0,,Kurtulduk.
Dialogue: 5,0:06:44.50,0:06:47.97,Main-480p,,0,0,0,,Durumumuz biraz bile değişmedi!
Dialogue: 5,0:06:47.97,0:06:51.39,Main-480p,,0,0,0,,Çok yakındı, niye kaçmadınız?
Dialogue: 5,0:06:51.39,0:06:54.45,Main-480p,,0,0,0,,HAREKET EDEMİYORUZ!\NBAKARAK ANLAYAMADIN MI?!
Dialogue: 5,0:06:55.29,0:06:56.56,Main-480p,,0,0,0,,Oh, sanırım edemiyorsunuz.
Dialogue: 5,0:06:56.56,0:06:59.93,Main-480p,,0,0,0,,Ama bana sütunu kırmamı söylediniz.
Dialogue: 5,0:06:59.93,0:07:01.10,Main-480p,,0,0,0,,Şaka mı yapıyordunuz?
Dialogue: 5,0:07:01.10,0:07:05.59,Main-480p,,0,0,0,,Yaşamlarımız konusunda gerçekten bu\Nadama güvenebilir miyiz, Bay Bushido?
Dialogue: 5,0:07:05.59,0:07:08.67,Main-480p,,0,0,0,,Evet, bu noktada başka seçeneğimiz yok.
Dialogue: 5,0:07:08.67,0:07:11.55,Main-480p,,0,0,0,,Kollarım çoktan sertleşti.
Dialogue: 5,0:07:11.55,0:07:13.87,Main-480p,,0,0,0,,Yalvarıyorum, lütfen bu konuda ciddi ol!
Dialogue: 5,0:07:17.29,0:07:22.69,Main-480p,,0,0,0,,Dur biraz, bedenim daha hızlı sertleşiyor.
Dialogue: 5,0:07:23.49,0:07:27.92,Main-480p,,0,0,0,,Bedenimin hiçbir yerini kıpırdatamıyorum!
Dialogue: 5,0:07:33.89,0:07:35.66,Main-480p,,0,0,0,,Ahmaklar!
Dialogue: 5,0:07:35.66,0:07:39.67,Main-480p,,0,0,0,,Mumları o kadar yakına getirmeniz\Nsadece sertleşmenizi hızlandırdı!
Dialogue: 5,0:07:39.67,0:07:44.24,Main-480p,,0,0,0,,Şimdi mum figürlerim olmaya hazır olun!
Dialogue: 5,0:07:46.61,0:07:50.32,Main-480p,,0,0,0,,Lanet olası! \Nİnsanlarla istediği gibi oynuyor!
Dialogue: 5,0:07:50.95,0:07:53.69,Main-480p,,0,0,0,,Hey, mum heykellere mi \Ndönüşüyorsunuz?!
Dialogue: 5,0:07:53.69,0:07:55.82,Main-480p,,0,0,0,,Sana söylediğimiz buydu!
Dialogue: 5,0:07:55.82,0:07:58.92,Main-480p,,0,0,0,,Lütfen acele et ve şu şeyi kır, Luffy-san!
Dialogue: 5,0:07:58.92,0:08:00.33,Main-480p,,0,0,0,,Tamam, anladım!
Dialogue: 5,0:08:00.33,0:08:03.67,Main-480p,,0,0,0,,Karışma demiştim!
Dialogue: 5,0:08:03.67,0:08:06.38,Main-480p,,0,0,0,,{\fad(150,150)}Doru Doru Sanatları: Zıpkın!
Dialogue: 5,0:08:06.38,0:08:07.38,Main-480p,,0,0,0,,{\fad(150,150)}Barut Yıldızı!
Dialogue: 5,0:08:30.70,0:08:34.91,Main-480p,,0,0,0,,Epey acı bir tadı var. \NUcuz barut kullanıyor olmalısın.
Dialogue: 5,0:08:34.91,0:08:37.87,Main-480p,,0,0,0,,Barut Yıldızı'mı yedi.
Dialogue: 5,0:08:42.11,0:08:46.59,Main-480p,,0,0,0,,Bu hiç de iyi görünmüyor.\NGittikçe hızlanıyor.
Dialogue: 5,0:08:46.59,0:08:49.55,Main-480p,,0,0,0,,– Bu pozda kaldığıma memnunum.\N– APTAL!
Dialogue: 5,0:08:49.55,0:08:52.51,Main-480p,,0,0,0,,Luffy-{\i1}san{\fs10} {\r}! Lütfen acele et!
Dialogue: 5,0:08:53.55,0:08:56.51,Main-480p,,0,0,0,,Tamam, bunu yapan şu kabak, değil mi?!
Dialogue: 5,0:08:56.51,0:08:57.65,Main-480p,,0,0,0,,Dayanın!
Dialogue: 5,0:08:57.65,0:08:58.81,Main-480p,,0,0,0,,{\fad(150,150)}Gomu Gomu no...
Dialogue: 5,0:08:58.81,0:09:00.39,Main-480p,,0,0,0,,Hareketlerin işe yaramaz!
Dialogue: 5,0:09:00.39,0:09:02.06,Main-480p,,0,0,0,,{\fad(150,150)}MUM DUVAR!
Dialogue: 5,0:09:03.52,0:09:05.62,Main-480p,,0,0,0,,{\fad(150,150)}...BAZUKA!
Dialogue: 5,0:09:09.40,0:09:10.94,Main-480p,,0,0,0,,Hey! Yoluma çıkma!
Dialogue: 5,0:09:10.94,0:09:13.60,Main-480p,,0,0,0,,Bunu benim söylemem gerektiğine inanıyorum.
Dialogue: 5,0:09:13.60,0:09:17.97,Main-480p,,0,0,0,,Sanatıma karışmaktan vazgeçmeni\Nısrar etmek zorundayım.
Dialogue: 5,0:09:17.97,0:09:19.41,Main-480p,,0,0,0,,{\fad(150,150)}MUM KİLİT!
Dialogue: 5,0:09:22.65,0:09:24.16,Main-480p,,0,0,0,,Çekicim oldu!
Dialogue: 5,0:09:25.37,0:09:27.21,Main-480p,,0,0,0,,GOMU GOMU NO...
Dialogue: 5,0:09:27.21,0:09:28.33,Main-480p,,0,0,0,,Ah, hayır!
Dialogue: 5,0:09:28.33,0:09:29.59,Main-480p,,0,0,0,,{\fad(150,150)}MUM DUVAR!
Dialogue: 5,0:09:29.59,0:09:31.32,Main-480p,,0,0,0,,{\fad(150,150)}...ÇEKİÇ!
Dialogue: 5,0:09:50.00,0:09:52.46,Main-480p,,0,0,0,,– B-Bay 3.\N– İmkansız!
Dialogue: 5,0:09:55.59,0:10:00.24,Main-480p,,0,0,0,,Luffy! Acele et ve \Nşansın varken şu şeyi kır!
Dialogue: 5,0:10:01.53,0:10:02.41,Main-480p,,0,0,0,,Olmaz.
Dialogue: 5,0:10:02.41,0:10:04.50,Main-480p,,0,0,0,,Şakayı bırak ve yap şunu!
Dialogue: 5,0:10:05.10,0:10:06.50,Main-480p,,0,0,0,,Olmaz.
Dialogue: 5,0:10:06.50,0:10:08.58,Main-480p,,0,0,0,,Dalga geçecek zaman değil!
Dialogue: 5,0:10:08.58,0:10:11.05,Main-480p,,0,0,0,,Luffy-{\i1}san{\fs10} {\r}! Lütfen!
Dialogue: 5,0:10:12.20,0:10:14.70,Main-480p,,0,0,0,,Niye yapayım?
Dialogue: 5,0:10:14.70,0:10:17.72,Main-480p,,0,0,0,,Sizi kurtarmak istemiyorum.
Dialogue: 5,0:10:21.00,0:10:23.18,Main-480p,,0,0,0,,Ne diyorsun?
Dialogue: 5,0:10:25.28,0:10:27.11,Main-480p,,0,0,0,,{\fad(150,150)}Renklerin Tuzağı.
Dialogue: 5,0:10:48.71,0:10:50.25,Main-480p,,0,0,0,,Hey! Luffy!
Dialogue: 5,0:10:50.25,0:10:53.60,Main-480p,,0,0,0,,Burada vaktimiz tükeniyor!\NSaçmalamayı bırak ve bize yardım et!
Dialogue: 5,0:10:53.60,0:10:55.50,Main-480p,,0,0,0,,Evet, anladım.
Dialogue: 5,0:10:55.50,0:10:58.59,Main-480p,,0,0,0,,– Anladıysan acele et!\N– Evet, Luffy!
Dialogue: 5,0:11:00.03,0:11:01.93,Main-480p,,0,0,0,,Anlıyorum, ama...
Dialogue: 5,0:11:04.78,0:11:07.85,Main-480p,,0,0,0,,Ama, sizi kurtarmak istemiyorum.
Dialogue: 5,0:11:07.85,0:11:09.60,Main-480p,,0,0,0,,Ne demeye çalışıyorsun?!
Dialogue: 5,0:11:09.60,0:11:11.82,Main-480p,,0,0,0,,Mum figürlere dönüşüyoruz!
Dialogue: 5,0:11:11.82,0:11:14.09,Main-480p,,0,0,0,,Anlıyor musun?! Öleceğiz!
Dialogue: 5,0:11:14.09,0:11:18.57,Main-480p,,0,0,0,,Evet... ama içimden gelmiyor.
Dialogue: 5,0:11:18.57,0:11:21.57,Main-480p,,0,0,0,,İÇİNDEN GELİP GELMEMESİ UMRUMUZDA DEĞİL!!
Dialogue: 5,0:11:22.56,0:11:27.04,Main-480p,,0,0,0,,Lanet olası... nesi var onun?
Dialogue: 5,0:11:27.04,0:11:31.40,Main-480p,,0,0,0,,Acele etmezse, \Nbedeli arkadaşlarımızın hayatları olacak!
Dialogue: 5,0:11:32.97,0:11:34.50,Main-480p,,0,0,0,,Ona biraz akıl vereceğim!
Dialogue: 5,0:11:34.50,0:11:36.16,Main-480p,,0,0,0,,Gidelim, Carue!
Dialogue: 5,0:11:40.51,0:11:43.34,Main-480p,,0,0,0,,Bunlar nereden geldi?!
Dialogue: 5,0:11:44.01,0:11:47.85,Main-480p,,0,0,0,,Vazgeçin. Çoktan onun tuzağına düştü.
Dialogue: 5,0:11:49.30,0:11:52.31,Main-480p,,0,0,0,,Doğru. Üzerinde durduğu işareti\Ngörmüyor musun?
Dialogue: 5,0:11:52.31,0:11:54.02,Main-480p,,0,0,0,,Durduğu yer mi?
Dialogue: 5,0:11:54.77,0:11:56.88,Main-480p,,0,0,0,,Hmm, bir bakalım...
Dialogue: 5,0:11:58.76,0:12:02.66,Main-480p,,0,0,0,,O da ne? Orada tuhaf, siyah bir şekil var.
Dialogue: 5,0:12:03.50,0:12:05.58,Main-480p,,0,0,0,,Nedir o?
Dialogue: 5,0:12:06.30,0:12:09.89,Main-480p,,0,0,0,,Evet, o sadece sıradan bir resim.
Dialogue: 5,0:12:12.11,0:12:13.29,Main-480p,,0,0,0,,Resim mi?
Dialogue: 5,0:12:14.21,0:12:22.30,Main-480p,,0,0,0,,Kısacası siz ve onlar, \Nhepiniz birlikte öleceksiniz!
Dialogue: 5,0:12:35.39,0:12:37.92,Main-480p,,0,0,0,,Carue! Şimdilik geri çekilmeliyiz!
Dialogue: 5,0:12:39.39,0:12:40.99,Main-480p,,0,0,0,,Kuşla birlikte kaçmaya çalışıyor!
Dialogue: 5,0:12:40.99,0:12:42.40,Main-480p,,0,0,0,,Peşlerinden!
Dialogue: 5,0:12:47.37,0:12:48.78,Main-480p,,0,0,0,,Tam gaz ileri!
Dialogue: 5,0:12:53.37,0:12:57.34,Main-480p,,0,0,0,,HEY! A-APTAL!! BEN DAHA BİNMEDİM!!\NCARUE!
Dialogue: 5,0:13:00.38,0:13:03.18,Main-480p,,0,0,0,,Tamam, dur! Binmeme izin ver!
Dialogue: 5,0:13:08.41,0:13:14.39,Main-480p,,0,0,0,,Benden niye korkuyorsun?!\NBinmeme izin ver!!
Dialogue: 5,0:13:18.61,0:13:20.57,Main-480p,,0,0,0,,Bayan Altın Hafta.
Dialogue: 5,0:13:20.57,0:13:22.75,Main-480p,,0,0,0,,Bundan sen sorumlusun!
Dialogue: 5,0:13:25.03,0:13:28.24,Main-480p,,0,0,0,,{\fad(150,150)}Renklerin Tuzağı Siyahın İhaneti!
Dialogue: 5,0:13:29.29,0:13:33.60,Main-480p,,0,0,0,,{\q2}Siyah boyaya dokunduğun zaman\Narkadaşların ne kadar değerli olursa olsun...
Dialogue: 5,0:13:33.60,0:13:35.71,Main-480p,,0,0,0,,...onlara ihanet edersin.
Dialogue: 5,0:13:35.71,0:13:39.50,Main-480p,,0,0,0,,Ne demek istiyor?\NBana ne yaptığını söyle.
Dialogue: 5,0:13:39.50,0:13:43.92,Main-480p,,0,0,0,,{\q2}O "gerçekçi ressam" dır. Renklerin çağrıştırdığı\Nduyguları alıp, onları gerçeğe dönüştürebilir!
Dialogue: 5,0:13:46.00,0:13:52.14,Main-480p,,0,0,0,,O boyalarıyla etkileşime giren insanların\Nzihinlerini manipüle edebilir.
Dialogue: 5,0:13:52.81,0:13:55.10,Main-480p,,0,0,0,,"Manipüle"?! Bu çok kötü!
Dialogue: 5,0:13:56.15,0:14:01.32,Main-480p,,0,0,0,,O yarım akıllı aptal önerilere karşı\Nnormal insanlardan daha dirençlidir!
Dialogue: 5,0:14:01.95,0:14:05.28,Main-480p,,0,0,0,,Yani onu resmin üzerinden\Nçekmeliyiz, değil mi?
Dialogue: 5,0:14:05.28,0:14:07.69,Main-480p,,0,0,0,,Luffy! Oradan çekilmelisin.
Dialogue: 5,0:14:07.69,0:14:08.69,Main-480p,,0,0,0,,Hayır, bu işe yaramayacak!
Dialogue: 5,0:14:08.69,0:14:13.70,Main-480p,,0,0,0,,Luffy-{\i1}san{\fs10} {\r}! lütfen siyah resim halkasından\Nne olursa olsun ayrılma! Lütfen!
Dialogue: 5,0:14:13.70,0:14:14.60,Main-480p,,0,0,0,,Yalvarıyorum.
Dialogue: 5,0:14:17.28,0:14:18.51,Main-480p,,0,0,0,,Vivi, niye?
Dialogue: 5,0:14:18.51,0:14:22.16,Main-480p,,0,0,0,,Bizi kurtarmanı istemiyoruz!
Dialogue: 5,0:14:25.90,0:14:27.13,Main-480p,,0,0,0,,Olmaz.
Dialogue: 5,0:14:28.28,0:14:29.88,Main-480p,,0,0,0,,Anlıyorum.
Dialogue: 5,0:14:29.88,0:14:33.85,Main-480p,,0,0,0,,Bilerek zıttını söylemek, \Nonun "ihanet" etmesini sağlıyor.
Dialogue: 5,0:14:33.85,0:14:35.56,Main-480p,,0,0,0,,Ha?
Dialogue: 5,0:14:36.82,0:14:40.31,Main-480p,,0,0,0,,Bir anlığına kendimi tuhaf hissettim.
Dialogue: 5,0:14:40.31,0:14:42.29,Main-480p,,0,0,0,,Luffy-san, ÇABUK!
Dialogue: 5,0:14:42.29,0:14:45.58,Main-480p,,0,0,0,,Tamam! Sizi hemen kurtaracağım!
Dialogue: 5,0:14:53.33,0:14:55.99,Main-480p,,0,0,0,,Ama şimdi düşünüyorum da\Ngülmeyi tercih ederim!
Dialogue: 5,0:14:58.20,0:14:59.44,Main-480p,,0,0,0,,NİYE?!
Dialogue: 5,0:14:59.44,0:15:00.41,Main-480p,,0,0,0,,SEN...
Dialogue: 5,0:15:00.41,0:15:01.83,Main-480p,,0,0,0,,{\i1}ŞİMDİ{\i0} NE VAR?!
Dialogue: 5,0:15:07.15,0:15:10.34,Main-480p,,0,0,0,,{\fad(150,150)}Renklerin Tuzağı Gülen Sarı
Dialogue: 5,0:15:11.60,0:15:13.80,Main-480p,,0,0,0,,Kötü çocuk, o noktadan ayrıldı.
Dialogue: 5,0:15:17.41,0:15:19.06,Main-480p,,0,0,0,,Bu kez elbisesinde!
Dialogue: 5,0:15:19.06,0:15:22.50,Main-480p,,0,0,0,,Luffy! Çabuk ol ve gömleğini çıkart!
Dialogue: 5,0:15:22.50,0:15:24.75,Main-480p,,0,0,0,,Olmaz.
Dialogue: 5,0:15:24.75,0:15:27.69,Main-480p,,0,0,0,,Ş-şu anda gülmek daha önemli!
Dialogue: 5,0:15:32.06,0:15:34.01,Main-480p,,0,0,0,,Kahretsin.
Dialogue: 5,0:15:34.01,0:15:38.95,Main-480p,,0,0,0,,Bu sisin çöküş hızına göre\Nsadece bir dakikamız falan kaldı.
Dialogue: 5,0:15:45.40,0:15:47.46,Main-480p,,0,0,0,,SİZ SERSEMLER OYUN OYNAMAK\NİÇİN Mİ GELDİNİZ?!
Dialogue: 5,0:15:51.55,0:15:55.72,Main-480p,,0,0,0,,Bak! Usopp ve Carue ona çarptığı\Nzaman, sırtındaki boyayı bulaştırdılar!
Dialogue: 5,0:15:58.70,0:16:01.82,Main-480p,,0,0,0,,Yine bana bir şey yaptın.
Dialogue: 5,0:16:04.06,0:16:07.72,Main-480p,,0,0,0,,Hey, sen! Kes şunu, lanet olası!
Dialogue: 5,0:16:07.72,0:16:10.72,Main-480p,,0,0,0,,Gülen Sarı eğlenceli miydi?
Dialogue: 5,0:16:10.72,0:16:14.57,Main-480p,,0,0,0,,KAPA ÇENENİ! \NSENİ APTAL ÇOCUK! APTAL!
Dialogue: 5,0:16:14.57,0:16:17.03,Main-480p,,0,0,0,,Her neyse, o kabağı parçalamalıyım!
Dialogue: 5,0:16:17.03,0:16:18.41,Main-480p,,0,0,0,,{\fad(150,150)}GOMU GOMU NO...
Dialogue: 5,0:16:18.41,0:16:21.87,Main-480p,,0,0,0,,{\fad(150,150)}Renklerin Tuzağı Boğa Güreşi Kırmızısı
Dialogue: 5,0:16:23.09,0:16:25.04,Main-480p,,0,0,0,,{\fad(150,150)}...BAZUKA!
Dialogue: 5,0:16:26.09,0:16:27.89,Main-480p,,0,0,0,,NEREYE NİŞAN ALIYORSUN?!
Dialogue: 5,0:16:27.89,0:16:31.38,Main-480p,,0,0,0,,Onu kırmamalısın. Bay 3 kızacak.
Dialogue: 5,0:16:31.38,0:16:32.72,Main-480p,,0,0,0,,Bu da ne?
Dialogue: 5,0:16:32.72,0:16:36.70,Main-480p,,0,0,0,,Aynı kırmızı örtüye saldıran bir boğa gibi.
Dialogue: 5,0:16:36.70,0:16:39.65,Main-480p,,0,0,0,,Şimdi sadece o Boğa Güreşi Kırmızısı\Nişaretine saldıracaksın.
Dialogue: 5,0:16:39.65,0:16:40.93,Main-480p,,0,0,0,,Senin için çok kötü.
Dialogue: 5,0:16:42.02,0:16:45.40,Main-480p,,0,0,0,,Senden bıktım artık!!\NBuradan defol!!
Dialogue: 5,0:16:45.40,0:16:48.15,Main-480p,,0,0,0,,{\fad(150,150)}GOMU GOMU NO BAZUKA!
Dialogue: 5,0:16:50.70,0:16:51.90,Main-480p,,0,0,0,,Eğlenceli mi?
Dialogue: 5,0:16:53.70,0:16:54.96,Main-480p,,0,0,0,,Faydasız.
Dialogue: 5,0:16:54.96,0:16:57.49,Main-480p,,0,0,0,,Bu dövüş tamamen onun zararına.
Dialogue: 5,0:16:57.49,0:16:59.87,Main-480p,,0,0,0,,Gücünün onun üstünde hiçbir etkisi yok.
Dialogue: 5,0:16:59.87,0:17:01.20,Main-480p,,0,0,0,,Ve son rötuşlar.
Dialogue: 5,0:17:01.20,0:17:04.21,Main-480p,,0,0,0,,Sırtında Gülen Sarı ile\NÜzüntü Mavisi'ni karıştıracağım ve...
Dialogue: 5,0:17:06.08,0:17:09.42,Main-480p,,0,0,0,,{\fad(150,150)}Renklerin Tuzağı Yatıştırıcı Yeşil
Dialogue: 5,0:17:13.90,0:17:15.76,Main-480p,,0,0,0,,Ah, bu iyi bir çay.
Dialogue: 5,0:17:15.76,0:17:17.60,Main-480p,,0,0,0,,SERSEM!!
Dialogue: 5,0:17:19.20,0:17:21.50,Main-480p,,0,0,0,,Pekala, şimdi ne yapıyoruz?
Dialogue: 5,0:17:21.50,0:17:25.05,Main-480p,,0,0,0,,Gördünüz mü? Şansınız varken\Nsize poz vermenizi söylemiştim.
Dialogue: 5,0:17:25.05,0:17:26.69,Main-480p,,0,0,0,,Bahse varım şimdi üzülüyorsunuzdur.
Dialogue: 5,0:17:26.69,0:17:29.27,Main-480p,,0,0,0,,Nasıl hala tasasız olabilirsin?!
Dialogue: 5,0:17:43.12,0:17:46.29,Main-480p,,0,0,0,,Kahretsin! Nasıl bu kadar hızlı koşabilirler?!
Dialogue: 5,0:17:50.29,0:17:53.34,Main-480p,,0,0,0,,{\fad(150,150)}Fantastik Çift Burun Topu!!
Dialogue: 5,0:17:58.11,0:18:01.18,Main-480p,,0,0,0,,Iskaladın! İyi iş, Carue!
Dialogue: 5,0:18:04.18,0:18:05.60,Main-480p,,0,0,0,,İşte bir karşılık!
Dialogue: 5,0:18:05.60,0:18:07.77,Main-480p,,0,0,0,,{\fad(150,150)}Kesin Öldürücü Kurşun Yıldız!
Dialogue: 5,0:18:10.36,0:18:13.32,Main-480p,,0,0,0,,Luffy ve diğerlerine geri dönelim!
Dialogue: 5,0:18:15.51,0:18:18.25,Main-480p,,0,0,0,,Sadece koşarak onları yakalayamayacağız.
Dialogue: 5,0:18:18.25,0:18:19.66,Main-480p,,0,0,0,,Kesinlikle.
Dialogue: 5,0:18:24.29,0:18:29.12,Main-480p,,0,0,0,,{\q2}Bunu onun gibi bir süprüntüde kullanmak\Nistememiştim ama bundan kurtulamayacak.
Dialogue: 5,0:18:29.90,0:18:35.00,Main-480p,,0,0,0,,Flintlock. 44 kalibre 6 patlar.
Dialogue: 5,0:18:35.00,0:18:38.09,Main-480p,,0,0,0,,Güney Mavi'den yeni bir model.
Dialogue: 5,0:18:38.09,0:18:40.00,Main-480p,,0,0,0,,Tam otomatik.
Dialogue: 5,0:18:40.00,0:18:42.55,Main-480p,,0,0,0,,Üstelik ben onu kullanırken\Nmermiler görünmez.
Dialogue: 5,0:18:44.52,0:18:50.28,Thoughts-480p,,0,0,0,,Luffy'nin tuhaf davranışı, \Nonların da dediği gibi, şu resim yüzünden!
Dialogue: 5,0:18:50.28,0:18:52.28,Thoughts-480p,,0,0,0,,Buna neden olan o olmalı!
Dialogue: 5,0:18:52.28,0:18:56.62,Thoughts-480p,,0,0,0,,Demin Luffy'ye çarptığımda \Nsırtında bir şey vardı!
Dialogue: 5,0:18:56.62,0:18:58.11,Thoughts-480p,,0,0,0,,Hiç şüphesiz!
Dialogue: 5,0:18:58.11,0:19:00.36,Thoughts-480p,,0,0,0,,O resim konusunda bir şey yapabilirsem...
Dialogue: 5,0:19:00.36,0:19:01.57,Main-480p,,0,0,0,,Acele et!
Dialogue: 5,0:19:16.70,0:19:19.92,Main-480p,,0,0,0,,Bu iyi bir çay.
Dialogue: 5,0:19:21.84,0:19:23.79,Main-480p,,0,0,0,,Bu çay...
Dialogue: 5,0:19:24.71,0:19:28.02,Main-480p,,0,0,0,,Luffy! Sen ne...?
Dialogue: 5,0:19:30.00,0:19:36.48,Main-480p,,0,0,0,,BU ÇAY... ÇOK İYİ.
Dialogue: 5,0:19:37.22,0:19:41.07,Main-480p,,0,0,0,,NE YAPIYORSUN, GERİ ZEKALI?!
Dialogue: 5,0:19:46.66,0:19:49.12,Main-480p,,0,0,0,,Siz serseriler için yolun sonu.
Dialogue: 5,0:19:49.12,0:19:51.42,Main-480p,,0,0,0,,En büyük yeteneğimi seyret!
Dialogue: 5,0:19:52.32,0:19:54.17,Main-480p,,0,0,0,,{\fad(150,150)}Kesin Öldürücü Alev Yıldızı
Dialogue: 5,0:20:05.14,0:20:08.97,Main-480p,,0,0,0,,Ne ahmak ama! \NIskaladı ve kendi arkadaşını vurdu!
Dialogue: 5,0:20:10.43,0:20:13.19,Main-480p,,0,0,0,,Hiç mermi görmedim!
Dialogue: 5,0:20:16.90,0:20:18.90,Main-480p,,0,0,0,,{\fad(150,150)}NEFES RÜZGARI BOMBASI!
Dialogue: 5,0:20:23.78,0:20:26.65,Main-480p,,0,0,0,,Nefesimin bile patlayıcı\Nolduğunu söylemeyi unuttum mu?
Dialogue: 5,0:20:28.24,0:20:33.46,Main-480p,,0,0,0,,Lanet olsun. Bu çok fazla.\NMermi yok mu?
Dialogue: 5,0:20:33.46,0:20:36.03,Main-480p,,0,0,0,,Carue! İyi misin??!
Dialogue: 5,0:20:37.53,0:20:39.80,Main-480p,,0,0,0,,Hey, daha şu kötü durumdan\Nkurtulamadın mı?!
Dialogue: 5,0:20:41.13,0:20:43.59,Main-480p,,0,0,0,,Evet, döndüm. Teşekkür ederim!
Dialogue: 5,0:20:44.64,0:20:49.06,Main-480p,,0,0,0,,Son saldırısı gömleğini yaktı ve\Ntuzağı etkisizleştirdi!
Dialogue: 5,0:20:50.28,0:20:53.02,Main-480p,,0,0,0,,Artık beni o tuhaf boyayla\Nkontrol etmeyeceksin!
Dialogue: 5,0:20:55.52,0:20:58.48,Main-480p,,0,0,0,,Hiç birinin ölmesine izin vermiyorum!
Dialogue: 5,0:20:59.59,0:21:01.44,Main-480p,,0,0,0,,Şimdi gerçekten kızdım!
Dialogue: 5,0:21:03.90,0:21:07.23,Main-480p,,0,0,0,,Kahretsin, bu acayip derecede tuhaf.
Dialogue: 5,0:21:07.23,0:21:09.87,Main-480p,,0,0,0,,Saatlerdir bekliyorum ve daha\Nkimse dönmedi.
Dialogue: 5,0:21:10.77,0:21:14.07,Main-480p,,0,0,0,,Nami-san'a veya Vivi-chan'a\Nbir şey olmuş olmalı.
Dialogue: 5,0:21:14.07,0:21:18.59,Main-480p,,0,0,0,,Eğer öyleyse, bu kesinlikle kertenkele\Nyemeği hazırlayacak zaman değil!
Dialogue: 5,0:21:19.96,0:21:25.11,Main-480p,,0,0,0,,Nami-{\i1}san{\fs10} {\r}! Vivi-{\i1}chwan{\fs10} {\r}!
Dialogue: 5,0:21:25.93,0:21:29.89,Main-480p,,0,0,0,,Hey~! Bir şey söyleyin! SİZİ SEVİYORUM!
Dialogue: 5,0:21:36.07,0:21:38.40,Main-480p,,0,0,0,,Bu da ne böyle?
Dialogue: 5,0:21:40.23,0:21:45.32,Main-480p,,0,0,0,,Sen kızarken arkadaşların\Nçoktan bu hale geldi.
Dialogue: 5,0:21:45.32,0:21:47.55,Main-480p,,0,0,0,,Ne olmuş?! Hala yaşıyorlar!
Dialogue: 5,0:21:49.89,0:21:51.76,Main-480p,,0,0,0,,Bunu bilemem.
Dialogue: 5,0:21:51.76,0:21:55.35,Main-480p,,0,0,0,,Bayan Altın Hafta onları boyadıktan sonra...
Dialogue: 5,0:21:55.35,0:21:57.33,Main-480p,,0,0,0,,...mükemmel mum figürler olacaklar.
Dialogue: 5,0:21:57.33,0:22:00.34,Main-480p,,0,0,0,,Onları kurtarmak için çok geç kaldın, \NHasır Şapka!
Dialogue: 5,0:22:01.71,0:22:03.84,Main-480p,,0,0,0,,Bu kesinlikle doğru!
Dialogue: 5,0:22:04.60,0:22:09.26,Main-480p,,0,0,0,,Çok fazla geç kaldın. \NŞimdi saldırımın sonsuz ümitsizliğinin...
Dialogue: 5,0:22:19.27,0:22:20.99,Main-480p,,0,0,0,,...tadına bak.
Dialogue: 5,0:22:26.90,0:22:29.96,Main-480p,,0,0,0,,{\fad(150,150)}MUM...
Dialogue: 5,0:22:30.91,0:22:34.06,Main-480p,,0,0,0,,{\fad(150,150)}...ŞAMPİYON!
Dialogue: 5,0:22:38.50,0:22:40.33,Main-480p,,0,0,0,,Ne yapıyor bu?
Dialogue: 5,0:22:40.33,0:22:45.80,Main-480p,,0,0,0,,Bu ona 42 milyon beli ödül kazandıran şey.
Dialogue: 5,0:22:45.80,0:22:48.26,Main-480p,,0,0,0,,Bay 3'ün en büyük sanat eseri.
Dialogue: 5,0:22:48.26,0:22:55.47,Main-480p,,0,0,0,,Şimdi, Bayan Altın Hafta!\NBeni renklerinle sanatsal bir şekilde boya.
Dialogue: 5,0:22:55.47,0:22:57.20,Main-480p,,0,0,0,,Sonra mola verebilir miyim?
Dialogue: 5,0:22:57.20,0:23:01.44,Main-480p,,0,0,0,,Sorun değil, ama yolumda durma.
Dialogue: 5,0:23:01.44,0:23:04.87,Main-480p,,0,0,0,,Bu durumdayken tamamen yenilmez!
Dialogue: 5,0:23:04.87,0:23:10.71,Main-480p,,0,0,0,,{\q2}Harikulade Doru Doru Mum'um çelik kadar sert.\NTüm bedenim delinmez bir zırhla kaplı!
Dialogue: 5,0:23:10.71,0:23:13.16,Main-480p,,0,0,0,,Bu yüzden hiç...
Dialogue: 5,0:23:14.20,0:23:16.53,Main-480p,,0,0,0,,...ZAYIFLIĞIM YOK!
Dialogue: 5,0:23:19.81,0:23:22.46,Main-480p,,0,0,0,,Çok süper~!
Dialogue: 5,0:23:22.46,0:23:26.45,Main-480p,,0,0,0,,ONU TAKDİR ETME! DÖVÜŞ ONUNLA!
Dialogue: 5,0:23:30.34,0:23:31.43,Main-480p,,0,0,0,,Tamam!
Dialogue: 5,0:23:31.43,0:23:33.97,Main-480p,,0,0,0,,{\fad(150,150)}GOMU GOMU NO...
Dialogue: 5,0:23:33.97,0:23:36.77,Main-480p,,0,0,0,,– Boyama işi bitti!\N– Şimdi...
Dialogue: 5,0:23:36.77,0:23:38.35,Main-480p,,0,0,0,,{\fad(150,150)}...TABANCA!
Dialogue: 5,0:23:40.81,0:23:44.69,Main-480p,,0,0,0,,{\fad(150,150)}Şampiyon Dövüşü: Alan Birleştirme!
Dialogue: 5,0:23:46.35,0:23:49.03,Main-480p,,0,0,0,,{\fad(150,150)}GOMU GOMU NO...
Dialogue: 5,0:23:49.99,0:23:51.15,Main-480p,,0,0,0,,{\fad(150,150)}...DAMGA!
Dialogue: 5,0:23:56.41,0:23:57.87,Main-480p,,0,0,0,,Boşuna çaba!
Dialogue: 5,0:23:57.87,0:24:01.29,Main-480p,,0,0,0,,İşe yaramadı! Saldırıları o sert\Nzırhı parçalayamıyor!
Dialogue: 5,0:24:07.20,0:24:09.21,Main-480p,,0,0,0,,Kahretsin, mum buharı-
Dialogue: 5,0:24:12.18,0:24:14.18,Main-480p,,0,0,0,,Mum?
Dialogue: 5,0:24:18.52,0:24:22.19,Main-480p,,0,0,0,,Tabii ya! Niye daha önce farketmedim?
Dialogue: 5,0:24:23.12,0:24:27.48,Main-480p,,0,0,0,,Mum buharlaştıysa eriyedebilir!
Dialogue: 5,0:24:27.48,0:24:30.40,Main-480p,,0,0,0,,Luffy! Mumunu ateşe vermelisin!
Dialogue: 5,0:24:30.40,0:24:33.03,Main-480p,,0,0,0,,Ne kadar sert olursa olsun,\Nyine de sadece mum!
Dialogue: 5,0:24:33.03,0:24:36.60,Main-480p,,0,0,0,,Zoro, diğerleri ve Usta Brogy çoktan\Nsertleşmiş olsa da hala zaman var!
Dialogue: 5,0:24:36.60,0:24:38.54,Main-480p,,0,0,0,,Onları kurtarabiliriz!
Dialogue: 5,0:24:38.54,0:24:40.54,Main-480p,,0,0,0,,NE? CİDDEN Mİ?!
Dialogue: 5,0:24:40.54,0:24:42.88,Main-480p,,0,0,0,,Evet, haklı.
Dialogue: 5,0:24:42.88,0:24:44.83,Main-480p,,0,0,0,,Onlara bunu nasıl söyleyebilirsin?!
Dialogue: 5,0:24:45.88,0:24:48.88,Main-480p,,0,0,0,,Elbette, bunu bilmek bir şey değiştirmez!
Dialogue: 5,0:24:48.88,0:24:51.51,Main-480p,,0,0,0,,Ne şansın ne de zamanın var!
Dialogue: 5,0:24:51.51,0:24:57.12,Main-480p,,0,0,0,,Otuz saniye kadar sonra kalpleri duracak!
Dialogue: 5,0:24:57.12,0:25:01.35,Main-480p,,0,0,0,,Şimdi bile şuurlarının son kırıntılarında\Nacı ve ıstırabı hissediyorlar!
Dialogue: 5,0:25:01.35,0:25:05.95,Main-480p,,0,0,0,,Ölümün dehşetini tadıyorlar!
Dialogue: 5,0:25:07.36,0:25:10.48,Main-480p,,0,0,0,,Otuz saniyeye ihtiyacımız yok,\Nonları hemen kurtaracağım!
Dialogue: 5,0:25:10.48,0:25:11.94,Main-480p,,0,0,0,,{\fad(150,150)}Kesin Öldürücü Alev...
Dialogue: 5,0:25:11.94,0:25:14.45,Main-480p,,0,0,0,,{\fad(150,150)}Burun Nefesi Bombası!
Dialogue: 5,0:25:17.54,0:25:19.12,Main-480p,,0,0,0,,USOPP!
Dialogue: 5,0:25:23.58,0:25:27.29,Main-480p,,0,0,0,,Onu duymadınız mı? Kazanma şansınız yok.
Dialogue: 5,0:25:31.25,0:25:33.72,Main-480p,,0,0,0,,Kahretsin! Hiç vakit yok!
Dialogue: 5,0:25:33.72,0:25:35.34,Main-480p,,0,0,0,,Vazgeç.
Dialogue: 5,0:25:42.20,0:25:45.20,Main-480p,,0,0,0,,Dinle, bu ip...
Dialogue: 5,0:25:45.20,0:25:47.35,Main-480p,,0,0,0,,Ah! Bu eğlenceli görünüyor!
Dialogue: 5,0:25:47.35,0:25:49.03,Main-480p,,0,0,0,,Ne planlıyor olabilirsin?
Dialogue: 5,0:25:49.65,0:25:51.67,Main-480p,,0,0,0,,Benim de katılmama izin vermek ister misin?
Dialogue: 5,0:25:54.88,0:25:57.49,Main-480p,,0,0,0,,Carue. Koş.
Dialogue: 5,0:25:57.49,0:25:59.03,Main-480p,,0,0,0,,KOŞ!!
Dialogue: 5,0:25:59.03,0:26:02.95,Main-480p,,0,0,0,,NE OLURSA OLSUN ÇEVRESİNDE\NKOŞMAYA DEVAM ET!
Dialogue: 5,0:26:05.21,0:26:07.42,Main-480p,,0,0,0,,Ne planlarsanız planlayın, faydasız.
Dialogue: 5,0:26:08.13,0:26:09.32,Main-480p,,0,0,0,,İzninle.
Dialogue: 5,0:26:10.30,0:26:12.59,Main-480p,,0,0,0,,{\fad(150,150)}Artış taşı...
Dialogue: 5,0:26:14.19,0:26:17.38,Main-480p,,0,0,0,,Kaç kiloya kadar baş edebileceğini\Nmerak ediyorum.
Dialogue: 5,0:26:20.05,0:26:21.33,Main-480p,,0,0,0,,10 kilo.
Dialogue: 5,0:26:22.93,0:26:24.81,Main-480p,,0,0,0,,100 kilo.
Dialogue: 5,0:26:26.98,0:26:28.86,Main-480p,,0,0,0,,200 kilo.
Dialogue: 5,0:26:30.44,0:26:32.57,Main-480p,,0,0,0,,300 kilo!
Dialogue: 5,0:26:36.12,0:26:38.59,Main-480p,,0,0,0,,Yerinde dur! Sırnaşık küçük kuş!
Dialogue: 5,0:26:40.66,0:26:43.33,Main-480p,,0,0,0,,Vazgeç! Vazgeç!
Dialogue: 5,0:26:43.33,0:26:47.46,Main-480p,,0,0,0,,Sevgili sanat eserlerim olacaklar!
Dialogue: 5,0:26:48.71,0:26:50.67,Main-480p,,0,0,0,,Bunun olmasına izin\Nvereceğimi mi sanıyorsun?!
Dialogue: 5,0:26:50.67,0:26:54.09,Main-480p,,0,0,0,,Hayatları senin gibi biri\Ntarafından alınmayacak!
Dialogue: 5,0:26:54.09,0:26:57.47,Main-480p,,0,0,0,,Eritmek için sadece ateş\Ngerekiyorsa bunu kullanacağım!
Dialogue: 5,0:26:57.47,0:27:00.09,Main-480p,,0,0,0,,Hayır! Kes şunu!
Dialogue: 5,0:27:00.09,0:27:03.56,Main-480p,,0,0,0,,Luffy! O küçük alev onları\Nzamanında eritmeyecek!
Dialogue: 5,0:27:04.12,0:27:07.02,Main-480p,,0,0,0,,Carue'nun ipini ateşe ver!
Dialogue: 5,0:27:07.02,0:27:08.98,Main-480p,,0,0,0,,Kuşun ipini mi?
Dialogue: 5,0:27:08.98,0:27:11.49,Main-480p,,0,0,0,,Bu özel bir ip!
Dialogue: 5,0:27:11.49,0:27:14.02,Main-480p,,0,0,0,,Yağa bulanmış durumda.
Dialogue: 5,0:27:14.02,0:27:16.86,Main-480p,,0,0,0,,– Pekala! Herkes uyansın!\N– Hey! Bekle! Dur!
Dialogue: 5,0:27:16.86,0:27:19.61,Main-480p,,0,0,0,,İşler biraz ısınacak. Sadece dayanın.
Dialogue: 5,0:27:20.28,0:27:22.12,Main-480p,,0,0,0,,DUUUUUUR!
Dialogue: 5,0:27:35.25,0:27:40.32,Main-480p,,0,0,0,,SICAK! SICAK!
Dialogue: 5,0:27:40.32,0:27:43.76,Main-480p,,0,0,0,,Ne büyük bir ateş!\Nİyi olacaklar mı?
Dialogue: 5,0:27:44.56,0:27:48.06,Main-480p,,0,0,0,,Hayır! Seni lanet olası Hasır Şapka!
Dialogue: 5,0:27:48.06,0:27:52.73,Main-480p,,0,0,0,,Mum Servis Seti'mi nasıl mahvedebilirsin?!
Dialogue: 5,0:27:52.73,0:27:54.19,Main-480p,,0,0,0,,Bunu ödeyeceksin!
Dialogue: 5,0:27:58.30,0:28:00.11,Main-480p,,0,0,0,,Kaçamayacaksınız pislikler!
Dialogue: 5,0:28:03.11,0:28:06.64,Main-480p,,0,0,0,,Kahretsin! Sinsi küçük pislik!
Dialogue: 5,0:28:08.88,0:28:11.74,Main-480p,,0,0,0,,Şimdi yaptınız işte!
Dialogue: 5,0:28:12.62,0:28:15.09,Main-480p,,0,0,0,,Gösteri bitti!
Dialogue: 5,0:28:15.09,0:28:20.09,Main-480p,,0,0,0,,Şimdi ...kafanı parçalara ayıracağım!
Dialogue: 5,0:28:20.09,0:28:23.76,Main-480p,,0,0,0,,{\fad(150,150)}Kesin öldürücü! 10,000 Kilo Giyotin!
Dialogue: 5,0:28:33.44,0:28:36.40,Main-480p,,0,0,0,,Orası sıcaktı. Aklına gelebilecek\Nen iyi şey bu muydu?
Dialogue: 5,0:28:40.50,0:28:44.86,Main-480p,,0,0,0,,Ne tür bir lüks umuyordunuz ki?!\NHayatta olduğunuza minnettar olmalısınız!
Dialogue: 5,0:28:44.86,0:28:47.12,Main-480p,,0,0,0,,Haklısın. Teşekkürler!
Dialogue: 5,0:28:47.12,0:28:50.08,Main-480p,,0,0,0,,Buna inanamıyorum! Yaşıyoruz.
Dialogue: 5,0:28:50.08,0:28:53.51,Main-480p,,0,0,0,,Mumu erittiniz, tam bir baş belasısınız.
Dialogue: 5,0:28:53.51,0:28:57.54,Main-480p,,0,0,0,,Ama artık görevimizi batırmanıza\Nizin vermeyeceğim!
Dialogue: 5,0:28:58.78,0:29:00.55,Main-480p,,0,0,0,,Bay 5!
Dialogue: 5,0:29:00.55,0:29:03.88,Main-480p,,0,0,0,,{\fad(150,150)}Kesin Öldürücü Barut Yıldızı!
Dialogue: 5,0:29:04.81,0:29:06.04,Main-480p,,0,0,0,,Aptal!
Dialogue: 5,0:29:06.04,0:29:10.85,Main-480p,,0,0,0,,{\q2}Bunu daha keç kez kanıtlamak zorundayım?\NBarut, Bomba Adam üzerinde işe yaramaz!
Dialogue: 5,0:29:10.85,0:29:12.31,Main-480p,,0,0,0,,Tadı nasıl?
Dialogue: 5,0:29:16.19,0:29:19.34,Main-480p,,0,0,0,,Afedersin, ama ben yalancıyım.
Dialogue: 5,0:29:19.34,0:29:22.69,Main-480p,,0,0,0,,Ağzındaki barut değil; \Nbenim özel Tabasco Yıldızım!
Dialogue: 5,0:29:23.95,0:29:26.45,Main-480p,,0,0,0,,YANIYOOOOORRR!
Dialogue: 5,0:29:32.36,0:29:35.21,Main-480p,,0,0,0,,Etkililiğinden bahsetmeden önce,\Nne olduğunu bildiğinden emin ol!
Dialogue: 5,0:29:37.17,0:29:39.62,Main-480p,,0,0,0,,Seni pis korsan!
Dialogue: 5,0:29:40.63,0:29:43.47,Main-480p,,0,0,0,,Seni tüm bedenimi patlatarak yok edeceğim!
Dialogue: 5,0:29:43.47,0:29:46.01,Main-480p,,0,0,0,,İşim bittiğinde kemik kırıntılarından\Nbaşka bir şey olmayacaksın!
Dialogue: 5,0:29:46.01,0:29:48.18,Main-480p,,0,0,0,,Hey! Dur! Hayır!
Dialogue: 5,0:29:48.18,0:29:52.10,Main-480p,,0,0,0,,Bekle! Hayır! Üzgünüm! \NBöyle yaptığım için üz-
Dialogue: 5,0:29:58.71,0:30:01.07,Main-480p,,0,0,0,,{\fad(150,150)}Yanan Şeytan...
Dialogue: 5,0:30:03.99,0:30:05.69,Main-480p,,0,0,0,,{\fad(150,150)}...Biçici
Dialogue: 5,0:30:21.80,0:30:24.45,Main-480p,,0,0,0,,Kılıçlar yanarken hiç de fena değil.
Dialogue: 5,0:30:28.19,0:30:29.74,Main-480p,,0,0,0,,Zoro!
Dialogue: 5,0:30:41.38,0:30:43.73,Main-480p,,0,0,0,,Selam. Görünüşe göre başardık.
Dialogue: 5,0:30:44.88,0:30:46.24,Main-480p,,0,0,0,,Evet.
Dialogue: 5,0:30:53.70,0:30:55.18,Main-480p,,0,0,0,,Usta...
Dialogue: 5,0:30:57.01,0:31:00.03,Main-480p,,0,0,0,,Daha o ikisi var.
Dialogue: 5,0:31:02.01,0:31:03.44,Main-480p,,0,0,0,,Kuş!
Dialogue: 5,0:31:05.09,0:31:07.55,Main-480p,,0,0,0,,Onları asla affetme!
Dialogue: 5,0:31:07.55,0:31:10.55,Main-480p,,0,0,0,,Bir dövüşü mahveden kimse adam değildir!
Dialogue: 5,0:31:18.82,0:31:24.33,Main-480p,,0,0,0,,Ah, demek geldin.\NDoru Doru Köşkü'me hoşgeldin.
Dialogue: 5,0:31:24.33,0:31:26.07,Main-480p,,0,0,0,,Bu da ne?
Dialogue: 5,0:31:26.07,0:31:31.20,Main-480p,,0,0,0,,Pekala, nerede olduğumu\Nsöyleyebilir misin acaba?
Dialogue: 5,0:31:34.80,0:31:39.00,Main-480p,,0,0,0,,Bizi takip etmekle akıllılık etmedin.
Dialogue: 5,0:31:39.00,0:31:44.21,Main-480p,,0,0,0,,Biz Baroque Works'un en zeki çiftiyiz.
Dialogue: 5,0:31:44.21,0:31:52.97,Main-480p,,0,0,0,,Senin gibi iç güdüleriyle hareket eden\Nbir güç manyağı bizi yenmeyi umamaz.
Dialogue: 5,0:31:52.97,0:31:55.64,Main-480p,,0,0,0,,Ben Bay 3'üm.
Dialogue: 5,0:31:55.64,0:31:59.43,Main-480p,,0,0,0,,Görevlerimi harfi harfine\Nyerine getiriyorum.
Dialogue: 5,0:31:59.43,0:32:02.90,Main-480p,,0,0,0,,Lütfen, içeri buyur!
Dialogue: 5,0:32:09.44,0:32:16.13,Main-480p,,0,0,0,,Ama sırtını bana dönersen...
Dialogue: 5,0:32:19.88,0:32:23.86,Main-480p,,0,0,0,,...kalbin o anda parça parça olacak.
Dialogue: 5,0:32:41.40,0:32:43.34,Main-480p,,0,0,0,,{\fad(150,0)}GOMU GOMU NO...
Dialogue: 5,0:32:43.34,0:32:45.02,Main-480p,,0,0,0,,{\fad(0,150)}...DAMGA!!
Dialogue: 5,0:32:47.73,0:32:52.32,Main-480p,,0,0,0,,Nasıl... bilebilirsin?
Dialogue: 5,0:32:52.99,0:32:55.95,Main-480p,,0,0,0,,B-Ben...
Dialogue: 5,0:33:02.51,0:33:04.08,Main-480p,,0,0,0,,İçgüdü.
Dialogue: 5,0:33:38.72,0:33:42.90,Main-480p,,0,0,0,,Öğleden sonra çayı için,\NEarl grey gerçekten en iyisi.
Dialogue: 5,0:33:44.68,0:33:46.79,Main-480p,,0,0,0,,Hey, dur biraz!
Dialogue: 5,0:33:46.79,0:33:51.58,Main-480p,,0,0,0,,Burada oturup şık bir şekilde\Nçay içiyor olmamalıyım!
Dialogue: 5,0:33:51.58,0:33:55.51,Main-480p,,0,0,0,,Nami-san ve diğerleri benim onları\Nkurtarmamı bekliyor olabilir!
Dialogue: 5,0:33:56.75,0:33:58.75,Main-480p,,0,0,0,,Ah, ne zor bir durum!
Dialogue: 5,0:33:59.37,0:34:03.97,Main-480p,,0,0,0,,Acaba niye ormanın içinde\Nböyle aşırı rahat bir yer var?
Dialogue: 5,0:34:14.21,0:34:15.95,Main-480p,,0,0,0,,Ne?
Dialogue: 5,0:34:25.38,0:34:27.20,Main-480p,,0,0,0,,Den Den Mushi.
Dialogue: 5,0:34:30.34,0:34:34.66,Main-480p,,0,0,0,,Hey, aradığınız için teşekkürler.\NBurası Beş Para Etmez Restoran.
Dialogue: 5,0:34:34.66,0:34:36.24,Main-480p,,0,0,0,,Sipariş vermek ister misiniz?
Dialogue: 5,0:34:39.80,0:34:43.87,Main-480p,,0,0,0,,Saçmalamayı kes, seni aptal.
Dialogue: 5,0:34:46.01,0:34:50.27,Main-480p,,0,0,0,,Raporun gecikti.
Dialogue: 5,0:34:50.27,0:34:53.13,Main-480p,,0,0,0,,Ha? Rapor mu?
Dialogue: 5,0:34:54.20,0:34:57.65,Main-480p,,0,0,0,,Kimin aradığını sorabilir miyim?
Dialogue: 5,0:34:57.65,0:34:59.24,Main-480p,,0,0,0,,{\i1}Benim.{\i0}
Dialogue: 5,0:34:59.24,0:35:01.51,Main-480p,,0,0,0,,{\i1}BAY 0.{\i0}
