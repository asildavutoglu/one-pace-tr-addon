Dialogue: 1,0:01:50.21,0:01:55.88,Title-480p,,0,0,0,,{\c&H000000&\1a&HFF&\fad(700,700)\t(620,700,\1a&H00&)\t(4970,5050,\1a&HFF&)}Doğruca İleri!
Dialogue: 2,0:01:50.21,0:01:55.88,Title-480p,,0,0,0,,{\bord0\4a&HFF&\fad(700,700)}Doğruca İleri!
Dialogue: 5,0:01:56.19,0:01:58.47,Main-480p,,0,0,0,,Hey! Şuna bakın! Orada!
Dialogue: 5,0:01:58.47,0:02:00.55,Main-480p,,0,0,0,,Gökkuşağı! Bir gökkuşağı!
Dialogue: 5,0:02:10.66,0:02:12.48,Main-480p,,0,0,0,,Ağlaması bile büyük!
Dialogue: 5,0:02:12.48,0:02:14.57,Main-480p,,0,0,0,,Şelale altında olmak gibi.
Dialogue: 5,0:02:14.57,0:02:18.03,Main-480p,,0,0,0,,Anlıyorum... Usta Brogy.
Dialogue: 5,0:02:41.89,0:02:44.35,Main-480p,,0,0,0,,Dorry... Sen... nasıl...?
Dialogue: 5,0:02:45.70,0:02:48.77,Main-480p,,0,0,0,,Sanırım kendimden geçmişim.
Dialogue: 5,0:02:51.42,0:02:53.61,Thoughts-480p,,0,0,0,,Bay 0 mı?
Dialogue: 5,0:02:54.25,0:02:59.57,Thoughts-480p,,0,0,0,,Vivi-chan düşmanın patronunun adının Bay 0 olduğunu söylememiş miydi?
Dialogue: 5,0:03:00.24,0:03:04.53,Thoughts-480p,,0,0,0,,Öyleyse bu Den Den Mushi'nin\Ndiğer tarafındaki adam...
Dialogue: 5,0:03:09.87,0:03:12.63,Thoughts-480p,,0,0,0,,...Shichibukailerden biri!
Dialogue: 5,0:03:12.63,0:03:16.41,Main-480p,,0,0,0,,Sana emirlerini vereli günler oldu.
Dialogue: 5,0:03:16.41,0:03:18.46,Main-480p,,0,0,0,,Neden bu kadar uzadı?
Dialogue: 5,0:03:18.46,0:03:23.43,Thoughts-480p,,0,0,0,,Bay 3... Bu Den Den Mushi'nin\Nsahibi o olmalı.
Dialogue: 5,0:03:24.44,0:03:27.32,Thoughts-480p,,0,0,0,,Sanırım şimdi anlıyorum.
Dialogue: 5,0:03:27.32,0:03:29.02,Thoughts-480p,,0,0,0,,Bu düşmanın yuvası.
Dialogue: 5,0:03:29.02,0:03:33.93,Thoughts-480p,,0,0,0,,{\q2}Bay 3 adındaki bu adam, Vivi-chan'ın hayatını\Nalmak için onu bu adaya kadar takip etmiş.
Dialogue: 5,0:03:34.81,0:03:39.60,Thoughts-480p,,0,0,0,,Kahretsin! Gerçekten avlanmaya\Nçıkmamalıydım!
Dialogue: 5,0:03:39.60,0:03:41.93,Thoughts-480p,,0,0,0,,Umarım herkes iyidir.
Dialogue: 5,0:03:43.07,0:03:45.66,Main-480p,,0,0,0,,Bu sessizlik de ne?
Dialogue: 5,0:03:45.66,0:03:48.34,Main-480p,,0,0,0,,{\i1}Sana bir soru sordum.{\i0}
Dialogue: 5,0:03:48.34,0:03:52.21,Main-480p,,0,0,0,,{\i1}Prenses Vivi'yi ve o Hasır Şapka\NKorsanları'nı yok ettin mi?{\i0}
Dialogue: 5,0:03:52.21,0:03:55.13,Main-480p,,0,0,0,,Evet, görev tamamlandı.
Dialogue: 5,0:03:55.13,0:03:59.72,Main-480p,,0,0,0,,Sırrınızı açığa çıkaran\Npisliklerden kurtuldum.
Dialogue: 5,0:03:59.72,0:04:02.17,Main-480p,,0,0,0,,Bu yüzden artık onları takip\Netmeye gerek yok.
Dialogue: 5,0:04:02.17,0:04:04.30,Main-480p,,0,0,0,,Anlıyorum. İyi iş.
Dialogue: 5,0:04:05.18,0:04:08.20,Main-480p,,0,0,0,,Şanssızlar bulunduğunuz yere\Ndoğru hareket etti.
Dialogue: 5,0:04:08.20,0:04:12.27,Main-480p,,0,0,0,,Görevinizin başarısını doğrulayacaklar\Nve teslimat yapacaklar.
Dialogue: 5,0:04:12.27,0:04:15.10,Main-480p,,0,0,0,,Şanssızlar mı? Teslimat mı?
Dialogue: 5,0:04:15.10,0:04:19.24,Main-480p,,0,0,0,,Arabasta Krallığı'nı gösteren\Nbir Daimi Belirleyici.
Dialogue: 5,0:04:20.28,0:04:27.28,Main-480p,,0,0,0,,Sen ve Bayan Altın Hafta'nın \NArabasta'ya dönmesi için. Vakit geldi.
Dialogue: 5,0:04:27.28,0:04:31.55,Main-480p,,0,0,0,,Planımızın en kritik bölümüne başlayacağız.
Dialogue: 5,0:04:31.55,0:04:35.21,Main-480p,,0,0,0,,Detaylı açıklamayı Arabasta'ya\Nulaşırken bekleyin.
Dialogue: 5,0:04:38.50,0:04:40.63,Main-480p,,0,0,0,,Bunlar da kim?
Dialogue: 5,0:04:49.85,0:04:51.64,Main-480p,,0,0,0,,{\i1}Hey. Neler oluyor?{\i0}
Dialogue: 5,0:04:51.64,0:04:54.10,Main-480p,,0,0,0,,Ah... yok bir şey.
Dialogue: 5,0:04:57.74,0:04:59.11,Main-480p,,0,0,0,,Bu da ne?
Dialogue: 5,0:05:14.75,0:05:19.40,Main-480p,,0,0,0,,Beni öldürmeye çalışıyorsun, ha?!\NGel bakalım, seni kahrolası maymun!
Dialogue: 5,0:05:25.59,0:05:27.63,Main-480p,,0,0,0,,Sen de şunu...
Dialogue: 5,0:05:30.85,0:05:33.14,Main-480p,,0,0,0,,...kesmelisin artık!
Dialogue: 5,0:05:33.14,0:05:35.81,Main-480p,,0,0,0,,Lanet olası dev tavuk!
Dialogue: 5,0:05:40.81,0:05:43.35,Main-480p,,0,0,0,,{\i1}Ne oldu? O ses de neydi?{\i0}
Dialogue: 5,0:05:43.35,0:05:47.49,Main-480p,,0,0,0,,Ah... eh... Bir şey yok... efendim.
Dialogue: 5,0:05:47.49,0:05:50.45,Main-480p,,0,0,0,,Hasır Şapka pisliklerinden\Nbiri hala yaşıyormuş.
Dialogue: 5,0:05:50.45,0:05:53.09,Main-480p,,0,0,0,,Ama her şey kontrol altında,\Nişini bitirdim.
Dialogue: 5,0:05:53.09,0:05:54.56,Main-480p,,0,0,0,,Endişe etmeyin.
Dialogue: 5,0:05:56.37,0:05:59.14,Main-480p,,0,0,0,,Yaşıyor mu?
Dialogue: 5,0:05:59.14,0:06:02.64,Main-480p,,0,0,0,,Görevini tamamladığını söylemiştin.
Dialogue: 5,0:06:02.64,0:06:04.65,Main-480p,,0,0,0,,Dediğin bu değil miydi?
Dialogue: 5,0:06:06.30,0:06:08.06,Main-480p,,0,0,0,,Şey, evet...
Dialogue: 5,0:06:08.06,0:06:10.80,Main-480p,,0,0,0,,Tamamladığımı düşünmüştüm, evet.
Dialogue: 5,0:06:11.40,0:06:15.02,Main-480p,,0,0,0,,Ama bu pislik umduğumdan\Ndaha kuvvetliydi.
Dialogue: 5,0:06:15.84,0:06:21.31,Main-480p,,0,0,0,,Diğer bir deyişle, \Nbana yanlış rapor verdin.
Dialogue: 5,0:06:21.31,0:06:26.49,Main-480p,,0,0,0,,Şey, evet... öyle düşünmek istiyorsanız.
Dialogue: 5,0:06:26.49,0:06:29.60,Main-480p,,0,0,0,,Ama bu kez, işini bitirdiğimden\Nepey eminim.
Dialogue: 5,0:06:29.60,0:06:32.53,Main-480p,,0,0,0,,Buraya başka birini göndermenize\Ngerek yok, tamam mı?
Dialogue: 5,0:06:33.20,0:06:34.41,Main-480p,,0,0,0,,Her neyse.
Dialogue: 5,0:06:34.41,0:06:39.50,Main-480p,,0,0,0,,Ne olursa olsun, Arabasta'ya gidiyorsun.
Dialogue: 5,0:06:42.58,0:06:46.09,Main-480p,,0,0,0,,Büyük ihtimalle... silahın yüzündendi.
Dialogue: 5,0:06:47.84,0:06:50.43,Main-480p,,0,0,0,,Silah mı? Elbette!
Dialogue: 5,0:06:51.09,0:06:54.09,Main-480p,,0,0,0,,Yüz yıl boyunca devlerin\Ndövüşünde kullanıldıktan sonra...
Dialogue: 5,0:06:54.09,0:06:58.43,Main-480p,,0,0,0,,...Elbaf'tan gelen silahlar bile körelir!
Dialogue: 5,0:06:59.77,0:07:02.04,Main-480p,,0,0,0,,Büyük şans...
Dialogue: 5,0:07:02.04,0:07:03.61,Main-480p,,0,0,0,,Bu muhteşem bir mucize!
Dialogue: 5,0:07:05.41,0:07:09.57,Main-480p,,0,0,0,,Hey, Brogy. Bana tutunma!\NYaramı acıtıyorsun.
Dialogue: 5,0:07:09.57,0:07:12.98,Main-480p,,0,0,0,,Yaşadığına çok sevindim, sevgili arkadaşım!
Dialogue: 5,0:07:18.19,0:07:21.50,Main-480p,,0,0,0,,Burada mucize yok. Doğal bir şey.
Dialogue: 5,0:07:21.50,0:07:26.33,Main-480p,,0,0,0,,Geçen yüzyılın ardından o silahların\Nhala keskin olması daha tuhaf olurdu.
Dialogue: 5,0:07:26.33,0:07:28.01,Main-480p,,0,0,0,,Bu sahipleri için de geçerli.
Dialogue: 5,0:07:28.01,0:07:33.47,Main-480p,,0,0,0,,Bugün gerçekten mükemmel bir gün!\NTanrımız Elbaf'a teşekkür ederim!
Dialogue: 5,0:07:33.47,0:07:35.30,Main-480p,,0,0,0,,Oh, Brogy?
Dialogue: 5,0:07:35.30,0:07:41.39,Main-480p,,0,0,0,,{\q2}Beni kestiğin ve kendimden geçmeme neden\Nolduğun için gerçekten mutlu görünüyorsun.
Dialogue: 5,0:07:41.39,0:07:45.02,Main-480p,,0,0,0,,Aptal! Bundan öyle bahsetme!
Dialogue: 5,0:07:45.02,0:07:49.49,Main-480p,,0,0,0,,Yarama vurma!
Dialogue: 5,0:07:57.91,0:08:03.24,Main-480p,,0,0,0,,– Dövüş mü istiyorsun, seni köpek?!\N– Evet! Seni yere yapıştıracağım!
Dialogue: 5,0:08:05.04,0:08:09.21,Main-480p,,0,0,0,,Süper! Evet! Müthiş!
Dialogue: 5,0:08:10.20,0:08:12.67,Main-480p,,0,0,0,,Niye yeniden dövüşüyorsunuz?!
Dialogue: 5,0:08:13.21,0:08:17.18,Main-480p,,0,0,0,,Sinyali burada kesiyorum.
Dialogue: 5,0:08:17.18,0:08:20.64,Main-480p,,0,0,0,,Denizcilerin bundan haberi olursa\Ncan sıkıcı olur.
Dialogue: 5,0:08:20.64,0:08:25.73,Main-480p,,0,0,0,,Şu ana dek emirleri aldığın şekilde\Nseninle yeniden iletişime geçeceğim.
Dialogue: 5,0:08:25.73,0:08:29.61,Main-480p,,0,0,0,,Hepsi bu. İyi yolculuklar, Bay 3.
Dialogue: 5,0:08:37.67,0:08:39.91,Main-480p,,0,0,0,,Bayan Tüm Pazar.
Dialogue: 5,0:08:41.54,0:08:42.62,Main-480p,,0,0,0,,Ne oldu?
Dialogue: 5,0:08:42.62,0:08:46.12,Main-480p,,0,0,0,,Bay 2'yi Küçük Bahçe'ye gönderin.
Dialogue: 5,0:08:47.42,0:08:53.38,Main-480p,,0,0,0,,Bay 3'ü Arabasta ile Küçük Bahçe\Narasındaki rotada imha etsin.
Dialogue: 5,0:08:53.38,0:08:58.35,Main-480p,,0,0,0,,Epey acımasızsınız, değil mi?\NBay 0 Crocodile?
Dialogue: 5,0:08:58.35,0:09:03.70,Main-480p,,0,0,0,,Yeterli adamımız var.\NBana karşılık mı veriyorsun?
Dialogue: 5,0:09:03.70,0:09:07.94,Main-480p,,0,0,0,,Hayır. Emirleri takip ediyorum. \NDerhal ayarlanacak.
Dialogue: 5,0:09:20.75,0:09:23.66,Main-480p,,0,0,0,,Hat kesildi. Ah, neyse.
Dialogue: 5,0:09:23.66,0:09:27.04,Main-480p,,0,0,0,,Bunlar kimin nesi böyle?
Dialogue: 5,0:09:33.23,0:09:34.76,Main-480p,,0,0,0,,Bu da ne?
Dialogue: 5,0:09:36.10,0:09:38.58,Main-480p,,0,0,0,,Kaptan Smoker{!}. Kaptan Smoker!
Dialogue: 5,0:09:38.58,0:09:40.72,Main-480p,,0,0,0,,Epey ilginç bir sinyal yakaladık.
Dialogue: 5,0:09:40.72,0:09:42.22,Main-480p,,0,0,0,,Ne?
Dialogue: 5,0:09:45.29,0:09:47.85,Main-480p,,0,0,0,,Ne mükemmel bir hitatsura*!
Dialogue: 5,0:09:47.85,0:09:49.90,Main-480p,,0,0,0,,*Ryō Wazamono'dan biri, Kashuu*.
Dialogue: 5,0:09:50.44,0:09:52.69,Main-480p,,0,0,0,,Tashigi! Hey! Tashigi!
Dialogue: 5,0:09:52.69,0:09:57.90,Main-480p,,0,0,0,,{\q2}Grand Line'dan daha azını beklemezdim. Böyle güzel\Nbir Meitou* ile bu kadar kısa sürede tanışmak...
Dialogue: 5,0:09:57.90,0:09:59.28,Main-480p,,0,0,0,,TASHIGI! HEY!
Dialogue: 5,0:09:59.28,0:10:01.33,Main-480p,,0,0,0,,SAĞIR MISIN, KATANA KAÇIĞI?!
Dialogue: 5,0:10:01.33,0:10:04.24,Main-480p,,0,0,0,,Evet, efendim! Ne oldu, Kaptan Smoker?\NBiraz kahve iste-
Dialogue: 5,0:10:09.61,0:10:13.17,Main-480p,,0,0,0,,İstemiyorum! \NSadece buraya gel ve şunu dinle!
Dialogue: 0,0:10:15.84,0:10:18.34,Captions-480p,,0,0,0,,{\pos(521,280)\fscx75\fscy75\bord1\c&H000000&\1a&HFF&\fad(800,0)\t(500,800,\1a&H00&)}Siyah Casus \NDen Den Mushi
Dialogue: 1,0:10:15.84,0:10:18.34,Captions-480p,,0,0,0,,{\pos(521,280)\fscx75\fscy75\bord0\4a&HFF&\fad(800,0)}Siyah Casus \NDen Den Mushi
Dialogue: 5,0:10:14.65,0:10:18.34,Main-480p,,0,0,0,,O... Siyah Casus Den Den Mushi!
Dialogue: 5,0:10:18.34,0:10:22.40,Main-480p,,0,0,0,,İyi dinle. Bu konuşmayı iki adam\Narasında yakaladık.
Dialogue: 5,0:10:22.40,0:10:24.60,Main-480p,,0,0,0,,İzninizle başçavuş, tekrar edeceğim.
Dialogue: 5,0:10:24.60,0:10:26.81,Main-480p,,0,0,0,,Evet, lütfen devam edin.
Dialogue: 5,0:10:28.40,0:10:30.02,Main-480p,,0,0,0,,...Bay 0...
Dialogue: 5,0:10:30.02,0:10:33.77,Main-480p,,0,0,0,,Prenses Vivi ve Hasır Şapka Korsa...
Dialogue: 5,0:10:33.77,0:10:36.03,Main-480p,,0,0,0,,Hasır Şapka... Hasır Şapka Korsanları?!
Dialogue: 5,0:10:36.03,0:10:39.40,Main-480p,,0,0,0,,{\i1}Evet, görev tamamlandı.{\i0}
Dialogue: 5,0:10:39.40,0:10:43.41,Main-480p,,0,0,0,,...iletişim kur... ...dek emirleri alaca...
Dialogue: 5,0:10:43.41,0:10:45.16,Main-480p,,0,0,0,,{\i1}Hepsi bu...{\i0}
Dialogue: 5,0:10:46.88,0:10:49.22,Main-480p,,0,0,0,,Geri kalanında deşifre\Nedemeyecek kadar parazit vardı.
Dialogue: 5,0:10:49.22,0:10:55.13,Main-480p,,0,0,0,,{\q2}Sinyal bozucu bile olsa o iki adam arasındaki\Ndört anahtar kelimeyi yakalamayı başardık.
Dialogue: 5,0:10:55.13,0:11:01.76,Main-480p,,0,0,0,,Prenses Vivi; Hasır Şapka, \NEmirler ve Bay 0.
Dialogue: 5,0:11:01.76,0:11:05.10,Main-480p,,0,0,0,,Bay 0 mı? Bir tür kod adı olabilir mi?
Dialogue: 5,0:11:05.10,0:11:10.23,Main-480p,,0,0,0,,{\q2}Öyleyse, geçen gün Runes'de yakaladığımız\Nşüpheli kılıç ustasıyla bir ilgisi olabilir.
Dialogue: 5,0:11:10.92,0:11:13.18,Main-480p,,0,0,0,,O adam kendisine "Bay 11" dedi.
Dialogue: 0,0:11:10.64,0:11:17.90,Captions-480p,,0,0,0,,{\pos(120,321)\c&H181818&\3c&H181818&\1a&HFF&\fad(800,800)\t(755,800,\1a&H00&)\t(6460,6505,\1a&HFF&)}Bay 11\N{\fs22}Sınır Ajanı\NBaroque Works
Dialogue: 1,0:11:10.64,0:11:17.90,Captions-480p,,0,0,0,,{\pos(120,321)\bord0\4a&HFF&\fad(800,800)}Bay 11\N{\fs22}Sınır Ajanı\NBaroque Works
Dialogue: 5,0:11:13.18,0:11:14.73,Main-480p,,0,0,0,,İyi nokta.
Dialogue: 5,0:11:14.73,0:11:18.10,Main-480p,,0,0,0,,Büyük ihtimalle üyelerinin kod adı olarak\Nnumaralar kullandığı bir suç örgütü...
Dialogue: 5,0:11:18.10,0:11:22.15,Main-480p,,0,0,0,,...ve üyeler "emirleri" yerine getiriyor. \NÖyle bir şey mi?
Dialogue: 5,0:11:22.15,0:11:26.22,Main-480p,,0,0,0,,Bay 0 mı? Suç Örgütü mü?\NHiç duymadım.
Dialogue: 5,0:11:26.22,0:11:27.70,Main-480p,,0,0,0,,Bana öyle saçmalıklardan bahsetme.
Dialogue: 5,0:11:27.70,0:11:32.23,Main-480p,,0,0,0,,Bu doğruysa, cebindeki o emirler neydi?
Dialogue: 5,0:11:32.23,0:11:34.79,Thoughts-480p,,0,0,0,,Emirleri yaktığımdan emin\Nolduğumu sanmıştım!
Dialogue: 5,0:11:34.79,0:11:37.71,Main-480p,,0,0,0,,O-Onlar... Şey...
Dialogue: 5,0:11:37.71,0:11:42.63,Main-480p,,0,0,0,,Onlar mı? Lanet olası cebinde\Nhiçbir şey yoktu.
Dialogue: 5,0:11:48.89,0:11:50.60,Main-480p,,0,0,0,,Prenses Vivi...
Dialogue: 5,0:11:50.60,0:11:54.09,Main-480p,,0,0,0,,Doğru hatırlıyorsam, \Nbu Arabasta Prensesi'nin adı.
Dialogue: 5,0:11:54.09,0:11:56.75,Main-480p,,0,0,0,,Şu anki yeri bilinmiyor.
Dialogue: 5,0:11:56.75,0:12:01.48,Main-480p,,0,0,0,,Ama Arabasta Krallığı bir hükümet\Ndarbesinin ortasında değil mi?
Dialogue: 5,0:12:01.48,0:12:07.21,Main-480p,,0,0,0,,{\q2}Bu gizli suç örgütü ve Hasır Şapka Korsanları\Noradaki kaosa karışmış olabilirler mi?
Dialogue: 5,0:12:07.21,0:12:08.79,Main-480p,,0,0,0,,Bilmiyorum.
Dialogue: 5,0:12:08.79,0:12:13.12,Main-480p,,0,0,0,,{\q2}Ama şimdilik Hasır Şapka'nın yeri \Nkonusunda sahip olduğumuz tek ipucu bu.
Dialogue: 5,0:12:13.74,0:12:15.71,Main-480p,,0,0,0,,Öyleyse, buradan...
Dialogue: 5,0:12:15.71,0:12:20.40,Main-480p,,0,0,0,,Evet. Karargahla bağlantıya geç\Nve bize daimi belirleyici al!
Dialogue: 5,0:12:20.40,0:12:21.17,Main-480p,,0,0,0,,Emredersiniz!
Dialogue: 5,0:12:22.81,0:12:28.72,Main-480p,,0,0,0,,Küçük bir yolculuğa çıkalım,\NKum Krallığı Arabasta'ya.
Dialogue: 5,0:12:39.65,0:12:46.07,Main-480p,,0,0,0,,Demek bu başımızdaki ödüllerle ilgiliydi!\NTamamen unutmuşum!
Dialogue: 5,0:12:46.07,0:12:50.89,Main-480p,,0,0,0,,Ama ilk olarak bu adaya\Ngelme sebepleri benim.
Dialogue: 5,0:12:50.89,0:12:51.70,Main-480p,,0,0,0,,Ah!
Dialogue: 5,0:12:51.70,0:12:53.75,Main-480p,,0,0,0,,Şunu keser misin?
Dialogue: 5,0:12:53.75,0:12:57.18,Main-480p,,0,0,0,,Haklı, Vivi! Ne diye bu kadar üzgünsün?
Dialogue: 5,0:12:57.18,0:12:58.20,Main-480p,,0,0,0,,Prinç Krakeri ister misin?
Dialogue: 5,0:12:58.20,0:13:00.75,Main-480p,,0,0,0,,Onları nereden aldınız?
Dialogue: 5,0:13:00.75,0:13:03.53,Main-480p,,0,0,0,,Tamam! Prinç Krakeri partisi zamanı!
Dialogue: 5,0:13:03.53,0:13:05.76,Main-480p,,0,0,0,,Ama sadece prinç krakerimiz varsa pek parti olmaz.
Dialogue: 5,0:13:05.76,0:13:07.71,Main-480p,,0,0,0,,Gerçekten mi? \NYine de onlarla tost yapabiliriz, değil mi?
Dialogue: 5,0:13:07.71,0:13:10.19,Main-480p,,0,0,0,,Sana karşı kin güden biri var mı?
Dialogue: 5,0:13:10.19,0:13:12.03,Main-480p,,0,0,0,,Kanpai!
Dialogue: 5,0:13:12.03,0:13:15.19,Main-480p,,0,0,0,,Hey, onları ziyan ediyorsun.
Dialogue: 5,0:13:15.19,0:13:18.59,Main-480p,,0,0,0,,Üfff, yemeğe öyle saygısızlık ediyorsun.
Dialogue: 5,0:13:18.59,0:13:21.97,Main-480p,,0,0,0,,Aptal, ne yapıyorsun?!\NYemeyeceğimi kim söyledi?!
Dialogue: 5,0:13:21.97,0:13:25.57,Main-480p,,0,0,0,,– Hey! Onları hala yiyebilirsin!\N– Ama onları atmıştın!
Dialogue: 5,0:13:25.57,0:13:27.11,Main-480p,,0,0,0,,O da ne?
Dialogue: 5,0:13:27.11,0:13:29.07,Main-480p,,0,0,0,,Bir şey değil, sadece böcek ısırığı.
Dialogue: 5,0:13:29.76,0:13:33.95,Main-480p,,0,0,0,,Seyirin bir sonraki adaya ayarlanması\Niçin bir yıl beklemek, epey ciddi.
Dialogue: 5,0:13:33.95,0:13:37.42,Main-480p,,0,0,0,,Haklısın. Bu gülünecek bir şey değil!
Dialogue: 5,0:13:37.42,0:13:42.30,Main-480p,,0,0,0,,Size borçluyuz. Minnettarlığımızı\Ngöstermenin bir yolu olmalı.
Dialogue: 5,0:13:43.79,0:13:47.26,Main-480p,,0,0,0,,Pekala Dev amcalar, seyirimiz\Nkonusunda bir şey yapın!
Dialogue: 5,0:13:48.33,0:13:52.22,Main-480p,,0,0,0,,Seyir bir şey yapamayacağımız tek konu.
Dialogue: 5,0:13:54.31,0:13:58.19,Main-480p,,0,0,0,,Nami-{\i1}san{\fs10} {\r}! Vivi-{\i1}chwan{\fs10} {\r}! \NVe diğer lanet olasıcalar!
Dialogue: 5,0:13:58.19,0:14:00.69,Main-480p,,0,0,0,,Selam, Sanji!
Dialogue: 5,0:14:01.65,0:14:05.65,Main-480p,,0,0,0,,Herkes güvende, değil mi?! Hele şükür!
Dialogue: 5,0:14:05.65,0:14:10.57,Main-480p,,0,0,0,,{\q2}O sersem bize yardım etmek için ortaya çıkmadı\Nve şimdi de kızlara gösteriş mi yapıyor?!
Dialogue: 5,0:14:12.58,0:14:17.08,Main-480p,,0,0,0,,BU DA NE?! SİZ BAY 3 MÜSÜNÜZ?!
Dialogue: 5,0:14:17.08,0:14:20.70,Main-480p,,0,0,0,,Hey, Bay 3'ü nereden biliyorsun?
Dialogue: 5,0:14:21.61,0:14:22.59,Main-480p,,0,0,0,,Nami-{\i1}san{\fs10} {\r}!
Dialogue: 5,0:14:22.59,0:14:25.05,Main-480p,,0,0,0,,Her zamanki gibi teşvik edicisin!
Dialogue: 5,0:14:25.05,0:14:26.34,Main-480p,,0,0,0,,Ölmek mi istiyorsun?
Dialogue: 5,0:14:26.34,0:14:31.27,Main-480p,,0,0,0,,Tamam, tamam, Nami-san.\NO şekilde üşüteceksin.
Dialogue: 5,0:14:31.27,0:14:32.78,Main-480p,,0,0,0,,Buyur, bunu giy.
Dialogue: 5,0:14:32.78,0:14:33.64,Main-480p,,0,0,0,,Teşekkür ederim.
Dialogue: 5,0:14:34.70,0:14:39.60,Main-480p,,0,0,0,,Pekala, Bay 0'la \NDen Den Mushi'den konuştum.
Dialogue: 5,0:14:39.60,0:14:41.81,Main-480p,,0,0,0,,Patronla konuştun mu?!
Dialogue: 5,0:14:41.81,0:14:46.53,Main-480p,,0,0,0,,Evet. Ormanın ortasında tuhaf\Nbir gizlenme yeri vardı.
Dialogue: 5,0:14:46.53,0:14:55.08,Main-480p,,0,0,0,,Beni Bay 3'le karıştırmış gibiydi. Ben de\Nrol yaptım ve işinizi bitirdiğimi söyledim.
Dialogue: 5,0:14:55.08,0:14:58.54,Main-480p,,0,0,0,,Bu ölü olduğumuzu düşündüğü\Nanlamına geliyor, değil mi?
Dialogue: 5,0:14:58.54,0:15:04.51,Main-480p,,0,0,0,,Niye kimse bizi aramıyorken gidemiyoruz?!
Dialogue: 5,0:15:04.51,0:15:08.56,Main-480p,,0,0,0,,Gidemiyor muyuz? \NDaha burada yapacak işimiz mi var?
Dialogue: 5,0:15:08.56,0:15:11.80,Main-480p,,0,0,0,,Üstelik size bunu getirmek için\Nonca sıkıntıya katlanmışken.
Dialogue: 5,0:15:18.93,0:15:20.06,Main-480p,,0,0,0,,N-Ne?
Dialogue: 5,0:15:20.06,0:15:23.40,Main-480p,,0,0,0,,Bu Arabasta'yı gösteren daimi seyir!
Dialogue: 5,0:15:23.40,0:15:26.80,Main-480p,,0,0,0,,Yola çıkabiliriz!
Dialogue: 5,0:15:26.80,0:15:29.63,Main-480p,,0,0,0,,Gitme zamanı, Sanji-kun!
Dialogue: 5,0:15:32.40,0:15:34.30,Main-480p,,0,0,0,,Çok teşekkür ederim, Sanji-{\i1}san{\fs10} {\r}!
Dialogue: 5,0:15:34.30,0:15:36.16,Main-480p,,0,0,0,,Bir anlığına her şeyin bittiğini\Ndüşünmüştüm!
Dialogue: 5,0:15:36.16,0:15:41.62,Main-480p,,0,0,0,,B-Bir şey değil! Çok kolaydı~!\NBu kadar mutlu olacağını bilseydim...
Dialogue: 5,0:15:41.62,0:15:45.85,Main-480p,,0,0,0,,Tamam millet!\NPrinç Krakeri Partisi!!
Dialogue: 5,0:15:45.85,0:15:47.72,Main-480p,,0,0,0,,Bu çok kötü, Luffy!
Dialogue: 5,0:15:47.72,0:15:50.14,Main-480p,,0,0,0,,Sadece üç tane kaldıysa prinç krakeri\Npartisi yapamayız!
Dialogue: 5,0:15:50.14,0:15:50.97,Main-480p,,0,0,0,,Ne?
Dialogue: 5,0:15:51.79,0:15:54.59,Main-480p,,0,0,0,,Zaten buna zamanımız yok!
Dialogue: 5,0:15:54.59,0:15:57.81,Main-480p,,0,0,0,,Gidelim Kaptan! \NBurada oyalanacak vaktimiz yok!
Dialogue: 5,0:15:59.55,0:16:00.93,Main-480p,,0,0,0,,Ah evet, sen.
Dialogue: 5,0:16:01.73,0:16:04.90,Main-480p,,0,0,0,,Av müsabakamızı unutmadın, değil mi?
Dialogue: 5,0:16:04.90,0:16:10.11,Main-480p,,0,0,0,,Unutmadım. Bu arada ben kazandım.\NKocaman bir gergedan yakaladım.
Dialogue: 5,0:16:10.11,0:16:13.79,Main-480p,,0,0,0,,Gergedan mı? Yenilir bir şey olsa iyi olur.
Dialogue: 5,0:16:13.79,0:16:15.07,Main-480p,,0,0,0,,Elbette.
Dialogue: 5,0:16:15.67,0:16:19.04,Thoughts-480p,,0,0,0,,Av Müsabakası?
Dialogue: 5,0:16:19.04,0:16:21.68,Main-480p,,0,0,0,,Bu bana bir şey anımsatıyor.
Dialogue: 5,0:16:25.69,0:16:28.29,Main-480p,,0,0,0,,Pekala, yuvarlak amca ve büyük amca!
Dialogue: 5,0:16:28.29,0:16:29.50,Main-480p,,0,0,0,,Biz gidiyoruz.
Dialogue: 5,0:16:31.55,0:16:35.36,Main-480p,,0,0,0,,Anlıyorum. Aceleniz var gibi.
Dialogue: 5,0:16:35.36,0:16:37.41,Main-480p,,0,0,0,,Kalamamanız çok kötü ama sizi tutmayalım.
Dialogue: 5,0:16:37.41,0:16:39.51,Main-480p,,0,0,0,,Umarım ülkeniz güvendedir.
Dialogue: 5,0:16:39.51,0:16:41.52,Main-480p,,0,0,0,,Evet, teşekkür ederim.
Dialogue: 5,0:16:41.52,0:16:45.09,Main-480p,,0,0,0,,Görüşürüz! Artık ölmeyin!
Dialogue: 5,0:16:45.77,0:16:48.94,Main-480p,,0,0,0,,Bir gün Elbaf'a gideceğim!
Dialogue: 5,0:16:48.94,0:16:52.00,Main-480p,,0,0,0,,Görene dek bekle. Benimki daha büyük.
Dialogue: 5,0:16:52.00,0:16:53.40,Main-480p,,0,0,0,,Heh! Evet, tabi!
Dialogue: 5,0:16:54.65,0:16:56.99,Main-480p,,0,0,0,,Denizin Cesur Savaşçısı olacağım!
Dialogue: 5,0:17:01.26,0:17:03.46,Main-480p,,0,0,0,,Arkadaşlarımız gidiyor.
Dialogue: 5,0:17:03.46,0:17:08.50,Main-480p,,0,0,0,,{\q2}Evet. Ama öylece gitmelerine izin veremeyiz.\NO canavar hala batı denizinde geziniyor.
Dialogue: 5,0:17:09.27,0:17:11.92,Main-480p,,0,0,0,,Dorry, yaran nasıl?
Dialogue: 5,0:17:12.66,0:17:14.92,Main-480p,,0,0,0,,Ne olmuş? Ölmeyeceğim.
Dialogue: 5,0:17:18.40,0:17:21.35,Main-480p,,0,0,0,,Baltam ve kılıcın sonlarına ulaşmak üzere.
Dialogue: 5,0:17:24.48,0:17:25.77,Main-480p,,0,0,0,,Buna üzülüyor musun?
Dialogue: 5,0:17:25.77,0:17:30.20,Main-480p,,0,0,0,,Evet, üzüldüm. Bu baltayla yüz\Nyıldan fazla bir süre dövüştüm.
Dialogue: 5,0:17:30.20,0:17:34.69,Main-480p,,0,0,0,,Ama o küçük insanlar için\Nbuna pişman olmayacağım.
Dialogue: 5,0:17:34.69,0:17:37.20,Main-480p,,0,0,0,,Öyleyse tamamdır.
Dialogue: 5,0:17:46.12,0:17:49.70,Main-480p,,0,0,0,,Kendin gör! Benimki daha büyük!
Dialogue: 5,0:17:49.70,0:17:51.80,Main-480p,,0,0,0,,İyi bak! Kertenkelem kazanır!
Dialogue: 5,0:17:51.80,0:17:57.30,Main-480p,,0,0,0,,Gözlerin bir işe yarıyor mu?!\NGergedanım çok daha büyük!
Dialogue: 5,0:17:57.30,0:17:59.88,Main-480p,,0,0,0,,Kimin umrunda? \Nİkisi de lezzetli görünüyor.
Dialogue: 5,0:17:59.88,0:18:01.72,Main-480p,,0,0,0,,SEN ÇENENİ KAPA!!\NSEN ÇENENİ KAPA!!
Dialogue: 5,0:18:01.72,0:18:05.56,Main-480p,,0,0,0,,{\q2}– Bak şunlara! Seninki o kadar şişman değil!\N– Besbelli benimkinin eti çok!
Dialogue: 5,0:18:05.56,0:18:08.65,Main-480p,,0,0,0,,{\c&HEDEDED&}{\c&HC5C5C5&}O et hiç iyi değil!{\c&HFFFFFF&}{\c&HFFFFFF&}\NBuna daha ne kadar devam edeceksiniz?
Dialogue: 5,0:18:08.65,0:18:13.80,Main-480p,,0,0,0,,{\q2}Zaten hepsinin gemiye sığacağı yok. Sadece\Nihtiyacımız olanı kesin. Yelken açmaya hazırız.
Dialogue: 5,0:18:13.80,0:18:15.61,Main-480p,,0,0,0,,Tamam! Nami-san~!
Dialogue: 5,0:18:15.61,0:18:19.74,Main-480p,,0,0,0,,Hey, Usopp! \NKazandığımı görebiliyorsun, değil mi?
Dialogue: 5,0:18:19.74,0:18:21.04,Main-480p,,0,0,0,,Umrumda değil.
Dialogue: 5,0:18:21.04,0:18:22.62,Main-480p,,0,0,0,,Berabere kabul edemez misiniz?
Dialogue: 5,0:18:22.62,0:18:24.99,Main-480p,,0,0,0,,Müsabakada berabere diye bir şey olmaz.
Dialogue: 5,0:18:24.99,0:18:26.62,Main-480p,,0,0,0,,HEMEN BURAYA GELİN!!
Dialogue: 5,0:18:27.48,0:18:29.00,Main-480p,,0,0,0,,Tamam!
Dialogue: 5,0:18:34.09,0:18:36.38,Main-480p,,0,0,0,,YELKEN AÇIN!
Dialogue: 5,0:18:40.09,0:18:44.22,Main-480p,,0,0,0,,Bu rotada devam edersek adanın\Nbatı tarafından çıkacağımızı söylediler.
Dialogue: 5,0:18:44.22,0:18:47.03,Main-480p,,0,0,0,,Hey. Daha fazla et yükleyemez miyiz?
Dialogue: 5,0:18:47.03,0:18:50.00,Main-480p,,0,0,0,,Sersem, daha fazla alırsak\Nbiz yemeden hepsi bozulur!
Dialogue: 5,0:18:50.00,0:18:52.06,Main-480p,,0,0,0,,Gemiyi batırmaya mı çalışıyorsun?
Dialogue: 5,0:18:58.37,0:19:01.99,Main-480p,,0,0,0,,Dev amcalar! \NBizi uğurlamaya gelmişler!
Dialogue: 5,0:19:06.95,0:19:09.91,Main-480p,,0,0,0,,Bu adaya gelen tüm küçük insanların...
Dialogue: 5,0:19:09.91,0:19:14.88,Main-480p,,0,0,0,,...bir sonraki adaya asla\Nulaşamamalarının en büyük sebebi.
Dialogue: 5,0:19:16.55,0:19:21.16,Main-480p,,0,0,0,,Onurumuzu hayatlarınızla korudunuz.
Dialogue: 5,0:19:21.16,0:19:24.51,Main-480p,,0,0,0,,Bu yüzden ne tür düşman olursa\Nolsun biz de aynısını yapacağız.
Dialogue: 5,0:19:28.10,0:19:31.06,Main-480p,,0,0,0,,Bir arkadaşın onuru ne pahasına\Nolursa olsun lekelenmemeli!
Dialogue: 5,0:19:33.35,0:19:35.36,Main-480p,,0,0,0,,Bize inanın ve dümdüz devam edin!
Dialogue: 5,0:19:35.36,0:19:38.74,Main-480p,,0,0,0,,Ortaya ne çıkarsa çıksın, rotanızdan sapmayın!
Dialogue: 5,0:19:39.82,0:19:41.82,Main-480p,,0,0,0,,Anlaşıldı!
Dialogue: 5,0:19:41.82,0:19:43.70,Main-480p,,0,0,0,,Bu da ne demek?
Dialogue: 5,0:19:43.70,0:19:45.66,Main-480p,,0,0,0,,Neyi anladın?
Dialogue: 5,0:19:45.66,0:19:48.62,Main-480p,,0,0,0,,NE OLURSA OLSUN, DÜZ GİDİYORUZ!
Dialogue: 5,0:19:56.33,0:19:57.74,Main-480p,,0,0,0,,Elveda.
Dialogue: 5,0:19:57.74,0:19:59.44,Main-480p,,0,0,0,,Yine karşılaşacağız.
Dialogue: 5,0:19:59.44,0:20:00.55,Main-480p,,0,0,0,,Hiç şüphesiz.
Dialogue: 5,0:20:00.55,0:20:01.93,Main-480p,,0,0,0,,Bakın! İleride!
Dialogue: 5,0:20:08.58,0:20:10.39,Main-480p,,0,0,0,,Demek yüzeye çıktın, Ada Yiyici.
Dialogue: 5,0:20:10.39,0:20:14.35,Main-480p,,0,0,0,,Geçmelerine izin vermeni sağlayacağız,\NElbaf adına!
Dialogue: 5,0:20:38.13,0:20:39.55,Main-480p,,0,0,0,,O DA NE ÖYLE?!
Dialogue: 5,0:20:41.51,0:20:44.47,Main-480p,,0,0,0,,O şey de ne? Süs balığı mı?
Dialogue: 5,0:20:45.20,0:20:49.43,Main-480p,,0,0,0,,D-Dev bir süs balığı mı?\NB-Bunu daha önce nerede duymuştum?
Dialogue: 5,0:20:49.43,0:20:52.29,Main-480p,,0,0,0,,Dümeni çevir! Çabuk yoksa bizi yiyecek!
Dialogue: 5,0:20:52.29,0:20:53.72,Main-480p,,0,0,0,,Usopp, çabuk!
Dialogue: 5,0:20:53.72,0:20:55.40,Main-480p,,0,0,0,,Y-Yapamam!
Dialogue: 5,0:20:55.40,0:20:58.27,Main-480p,,0,0,0,,Düz gidiyoruz! D-Değil mi, Luffy?
Dialogue: 5,0:20:58.27,0:21:00.61,Main-480p,,0,0,0,,Elbette!
Dialogue: 5,0:21:06.57,0:21:10.79,Main-480p,,0,0,0,,Delirdiniz mi?! Bu şey Laboon gibi değil!
Dialogue: 5,0:21:10.79,0:21:13.25,Main-480p,,0,0,0,,Biliyorum. Sakin ol.
Dialogue: 5,0:21:13.25,0:21:15.92,Main-480p,,0,0,0,,İşte, son prinç krakerini al.
Dialogue: 5,0:21:15.92,0:21:20.99,Main-480p,,0,0,0,,İstemiyorum! Gemiyi döndürmeliyiz!\NHepimiz...!!
Dialogue: 5,0:21:22.18,0:21:24.01,Main-480p,,0,0,0,,Nami, vazgeç.
Dialogue: 5,0:21:28.22,0:21:31.39,Main-480p,,0,0,0,,Luffy! Onlara güvenebiliriz, değil mi?
Dialogue: 5,0:21:31.39,0:21:32.22,Main-480p,,0,0,0,,Evet!
Dialogue: 5,0:21:32.22,0:21:35.69,Main-480p,,0,0,0,,Cidden mi? Gerçekten o canavarın\Niçine doğru mu gideceğiz?!
Dialogue: 5,0:21:35.69,0:21:38.65,Main-480p,,0,0,0,,Çok geç! Artık duramayız!
Dialogue: 5,0:21:47.66,0:21:52.08,Main-480p,,0,0,0,,Demek iyice büyüdün, Ada Yiyici.\NSeni canavar süs balığı!
Dialogue: 5,0:21:52.68,0:21:56.04,Main-480p,,0,0,0,,Şaşırtıcı olan sadece büyüklüğü değil.
Dialogue: 5,0:21:56.04,0:22:01.69,Main-480p,,0,0,0,,Yedikten sonra sıçtığı adaların\Nmuazzam büyüklüğü ve genişliği de var.
Dialogue: 5,0:22:01.69,0:22:05.82,Main-480p,,0,0,0,,Nanimonai adında dev bir bok adası hatırlıyorum.
Dialogue: 5,0:22:08.05,0:22:13.01,Main-480p,,0,0,0,,Kara sanıp ilk kez o şeylerden birinin\Nüzerine çıktığımız zamanı hatırlıyorum.
Dialogue: 5,0:22:13.01,0:22:15.37,Main-480p,,0,0,0,,Eski, güzel maceralı günler.
Dialogue: 5,0:22:15.37,0:22:18.48,Main-480p,,0,0,0,,Onları izlemek bana o günleri anımsatıyor.
Dialogue: 5,0:22:22.44,0:22:27.65,Main-480p,,0,0,0,,Sadece kana bulanmış yılanı parçalayamayız!
Dialogue: 5,0:22:28.69,0:22:32.91,Main-480p,,0,0,0,,Elbaf'ın Dev Savaşçı Kabilesi'nin\Nen güçlü kargılarını seyredin!
Dialogue: 5,0:22:38.92,0:22:41.38,Main-480p,,0,0,0,,DÜMDÜZ İLERİ! D-DÜMDÜZ İLERİ!!
Dialogue: 5,0:22:41.38,0:22:44.63,Main-480p,,0,0,0,,Neden bahsediyorsun?! Yutulduk artık!
Dialogue: 5,0:22:44.63,0:22:46.96,Main-480p,,0,0,0,,DÜMDÜZ İLERİ! DÜMDÜZ İLERİ!
Dialogue: 5,0:23:05.57,0:23:08.00,Main-480p,,0,0,0,,{\fad(150,150)}Savaşçı Ulus!!
Dialogue: 5,0:23:09.32,0:23:11.63,Main-480p,,0,0,0,,İçinden geçtik!
Dialogue: 5,0:23:19.08,0:23:22.54,Main-480p,,0,0,0,,Geri dönmek yok!\NDüz gidiyoruz!
Dialogue: 5,0:23:26.00,0:23:29.34,Main-480p,,0,0,0,,Kocaman! Çok büyüktü!
Dialogue: 5,0:23:29.34,0:23:33.28,Main-480p,,0,0,0,,Okyanusun kendisini bile parçaladılar!
Dialogue: 5,0:23:33.28,0:23:37.31,Main-480p,,0,0,0,,Bu bir Elbaf Savaşçısının gerçek gücü!
Dialogue: 5,0:23:38.26,0:23:40.99,Main-480p,,0,0,0,,Çok müthiş~!
Dialogue: 5,0:23:53.58,0:23:54.78,Main-480p,,0,0,0,,ŞİMDİ ARKADAŞLAR!
Dialogue: 5,0:23:59.95,0:24:02.00,Main-480p,,0,0,0,,GİDİN!
Dialogue: 5,0:24:12.46,0:24:16.38,Narrator-480p,,0,0,0,,Yıllar önce Dev Savaşçı Korsanlar diye bilinen...
Dialogue: 5,0:24:16.38,0:24:18.89,Narrator-480p,,0,0,0,,...korkutucu bir tayfa\Nbu denizlerde yelken açtı.
Dialogue: 5,0:24:18.89,0:24:21.97,Narrator-480p,,0,0,0,,O korsanların iki lideri...
Dialogue: 5,0:24:21.97,0:24:25.70,Narrator-480p,,0,0,0,,...Kırmızı Ogre Brogy ve Mavi Ogre Dorry...
Dialogue: 5,0:24:25.70,0:24:27.36,Narrator-480p,,0,0,0,,...ürkütücü bir güçtüler.
Dialogue: 5,0:24:28.38,0:24:32.00,Narrator-480p,,0,0,0,,Sıradan insanların onlara karşı hiç şansı olmadığı için...
Dialogue: 5,0:24:32.00,0:24:34.29,Narrator-480p,,0,0,0,,...çoğunlukla denetimsiz bırakıldılar.
Dialogue: 5,0:24:34.29,0:24:38.50,Narrator-480p,,0,0,0,,Ama sonunda yakıp yıkmalarına\Nson veren şeyin...
Dialogue: 5,0:24:38.50,0:24:42.37,Narrator-480p,,0,0,0,,...tek bir küçük kız olduğu söylenir.
Dialogue: 5,0:24:45.04,0:24:48.70,Flashbacks-480p,,0,0,0,,Bugün patronların yakaladıklarından\Npay aldın mı?
Dialogue: 5,0:24:48.70,0:24:53.39,Flashbacks-480p,,0,0,0,,Evet, beni aşırı heyecanlandırdı,\Nhala sakinleşemiyorum!
Dialogue: 5,0:24:53.39,0:24:58.89,Flashbacks-480p,,0,0,0,,Sonuçta, her biri devasa\NDeniz Krallarından öldürdü!
Dialogue: 5,0:24:58.89,0:25:02.68,Flashbacks-480p,,0,0,0,,Elbaf'ın Dev Kabilesi olabiliriz ama...
Dialogue: 5,0:25:02.70,0:25:07.60,Flashbacks-480p,,0,0,0,,...o tip yaratıkları\Ndevirebilecek olan sadece patronlardır!
Dialogue: 5,0:25:07.60,0:25:09.11,Flashbacks-480p,,0,0,0,,Bu doğru değil mi, millet?
Dialogue: 5,0:25:09.71,0:25:12.86,Flashbacks-480p,,0,0,0,,– Evet!\N– Doğru anlamışsın!
Dialogue: 5,0:25:15.03,0:25:19.21,Flashbacks-480p,,0,0,0,,Bu kesinlikle en büyük başarımız olmalı!
Dialogue: 5,0:25:21.40,0:25:24.12,Flashbacks-480p,,0,0,0,,Avladıklarımızın en büyüğü!
Dialogue: 5,0:25:26.60,0:25:28.92,Flashbacks-480p,,0,0,0,,Peki, hangisi daha büyük?
Dialogue: 5,0:25:31.07,0:25:33.18,Flashbacks-480p,,0,0,0,,– Ki...\N– ...minki?
Dialogue: 5,0:25:33.18,0:25:36.34,Flashbacks-480p,,0,0,0,,Av Müsabakanızı kim kazandı?
Dialogue: 5,0:25:41.05,0:25:44.99,Flashbacks-480p,,0,0,0,,İyi bak Brogy. \NBenimkisi biraz daha büyük görünüyor.
Dialogue: 5,0:25:44.99,0:25:48.42,Flashbacks-480p,,0,0,0,,Hadi ama! Benimki en\Nazından 3 cm daha büyük!
Dialogue: 5,0:25:48.42,0:25:50.63,Flashbacks-480p,,0,0,0,,– NE?!\N– O DA NE?!
Dialogue: 5,0:25:50.63,0:25:53.78,Flashbacks-480p,,0,0,0,,PATRONLAR! LÜTFEN DURUN!
Dialogue: 5,0:26:01.40,0:26:07.21,Main-480p,,0,0,0,,Bu arada Brogy, Önemli bir şeyi\Nunutmuşum gibi hissediyorum.
Dialogue: 5,0:26:07.21,0:26:09.92,Main-480p,,0,0,0,,Aslını söylemek gerekirse, ben de öyle.
Dialogue: 5,0:26:13.48,0:26:14.88,Main-480p,,0,0,0,,Merkez dağ!
Dialogue: 5,0:26:14.88,0:26:19.26,Main-480p,,0,0,0,,Neyse ne, skoru son bir kez belirleyelim!
Dialogue: 5,0:26:19.26,0:26:23.10,Main-480p,,0,0,0,,Evet! Seni yendikten sonra\Nbunu hatırlayacağım!
