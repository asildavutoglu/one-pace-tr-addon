Dialogue: 0,0:00:06.90,0:00:10.48,RogerMonologue,,0,0,0,,Bir dünya... Evet!
Dialogue: 0,0:00:10.48,0:00:16.53,RogerMonologue,,0,0,0,,Senin gibi özgürlüğü arayan biri için koca bir dünya tam gözlerinin önünde.
Dialogue: 0,0:00:16.53,0:00:20.41,RogerMonologue,,0,0,0,,Sonu olmayan rüyaların peşinden gitmek istiyorsan,
Dialogue: 0,0:00:20.41,0:00:25.17,RogerMonologue,,0,0,0,,inandıklarının bayrağını taşıyarak onların ötesine geç!
Dialogue: 0,0:00:29.88,0:00:35.56,Lyrics,,0,0,0,karaoke,♪ Engin dalgaların arasından
Dialogue: 0,0:00:35.56,0:00:38.71,Lyrics,,0,0,0,karaoke,sonsuz dünyayı arayışım henüz yeni başladı. ♪
Dialogue: 0,0:00:40.01,0:00:43.07,Lyrics,,0,0,0,karaoke,♪ İçime sığmayan tutkuyla,
Dialogue: 0,0:00:43.07,0:00:45.15,Lyrics,,0,0,0,karaoke,kimselerin görmediği ışığın peşinden,
Dialogue: 0,0:00:45.15,0:00:53.46,Lyrics,,0,0,0,karaoke,nereye olursa giderim. ♪
Dialogue: 0,0:00:53.46,0:00:59.02,Lyrics,,0,0,0,karaoke,♪ Yaz güneşi, kalbimin yelkenlerini hareketlendiriyor... ♪
Dialogue: 0,0:00:59.10,0:01:03.41,Lyrics,,0,0,0,karaoke,♪ (Uçup git, kasvetli mavi deniz...) ♪
Dialogue: 0,0:01:03.48,0:01:09.21,Lyrics,,0,0,0,karaoke,♪ İşte yeni dünyaya açılan kapıya işaret bu... ♪
Dialogue: 0,0:01:09.23,0:01:13.05,Lyrics,,0,0,0,karaoke,♪ (Uçup git, kasvetli mavi gökyüzü...) ♪
Dialogue: 0,0:01:13.13,0:01:18.14,Lyrics,,0,0,0,karaoke,♪ Dalgalar üzerinde salınarak, umutsuzluğun ötesine geçerek,
Dialogue: 0,0:01:18.14,0:01:25.61,Lyrics,,0,0,0,karaoke,ufkun öteki tarafını hedef alıyorum. ♪
Dialogue: 0,0:01:25.74,0:01:31.41,Lyrics,,0,0,0,karaoke,♪ Engin dalgaların arasından,
Dialogue: 0,0:01:31.41,0:01:34.59,Lyrics,,0,0,0,karaoke,sonsuz dünyayı arayışım henüz yeni başladı. ♪
Dialogue: 0,0:01:36.03,0:01:38.94,Lyrics,,0,0,0,karaoke,♪ İçime sığmayan tutkuyla,
Dialogue: 0,0:01:38.94,0:01:41.05,Lyrics,,0,0,0,karaoke,kimselerin görmediği ışığın peşinden,
Dialogue: 0,0:01:41.05,0:01:47.64,Lyrics,,0,0,0,karaoke,nereye olursa giderim. ♪
