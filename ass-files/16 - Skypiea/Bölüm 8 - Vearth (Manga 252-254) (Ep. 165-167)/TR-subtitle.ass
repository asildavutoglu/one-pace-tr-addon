Dialogue: 50,0:22:49.18,0:22:51.02,Lyrics2,,50,0,0,,♪ Arkadaşdan öteyiz ♪
Dialogue: 50,0:22:51.02,0:22:53.18,Lyrics2,,50,0,0,,♪ Arkadaş dediğinin çok daha fazlası ♪
Dialogue: 50,0:22:55.56,0:22:57.56,Lyrics2,,50,0,117,,♪ Denizde olduğumuz sürece
Dialogue: 50,0:22:53.18,0:22:56.48,Lyrics2,,50,0,0,,biz bir AİLEYİZ! ♪
Dialogue: 50,0:22:56.48,0:22:58.69,Lyrics2,,50,0,0,,♪ Kardeş değiliz,
Dialogue: 50,0:22:58.69,0:23:01.19,Lyrics2,,50,0,0,,kan bağımız yok ♪
Dialogue: 50,0:23:01.57,0:23:05.91,Lyrics2,,50,0,0,,♪ Ama tayfamız yine de bir AİLE! ♪
Dialogue: 50,0:23:11.29,0:23:14.66,Lyrics2,,50,0,0,,♪ Bolca harita var,
Dialogue: 50,0:23:14.66,0:23:19.21,Lyrics2,,50,0,0,,hiç görmediğin kadar büyük haritalar ♪
Dialogue: 50,0:23:19.21,0:23:21.92,Lyrics2,,50,0,0,,♪ Yine bir önemi yok,
Dialogue: 50,0:23:21.92,0:23:24.67,Lyrics2,,50,0,0,,böyle bir aile bulamazsın ♪
Dialogue: 50,0:23:24.67,0:23:29.47,Lyrics2,,50,0,0,,♪ Sadece dışlanmışlar ve haylazlar
Dialogue: 50,0:23:29.47,0:23:33.10,Lyrics2,,50,0,0,,gemimize binebilir ♪
Dialogue: 50,0:23:33.10,0:23:37.02,Lyrics2,,50,0,0,,♪ Tüm mantığını geride bırak,
Dialogue: 50,0:23:37.02,0:23:41.15,Lyrics2,,50,0,0,,belki o zaman bizle yelken açabilirsin ♪
Dialogue: 50,0:23:42.94,0:23:46.53,Lyrics2,,50,0,0,,♪ He gün fırtınayla boğuşmak ♪
Dialogue: 50,0:23:46.53,0:23:50.28,Lyrics2,,50,0,0,,♪ Bir insan daha ne ister ki ♪
Dialogue: 50,0:23:50.28,0:23:54.12,Lyrics2,,50,0,0,,♪ En büyük hazineyi bulacağız, hedefimiz bu ♪
Dialogue: 50,0:23:54.12,0:24:00.29,Lyrics2,,50,0,0,,♪ GEMİMİZİN yardımı ile ♪
Dialogue: 50,0:24:01.42,0:24:05.22,Lyrics2,,50,0,0,,♪ En iyi insanların ortak bir özelliği vardır ♪
Dialogue: 50,0:24:05.22,0:24:11.47,Lyrics2,,50,0,0,,♪ Kendilerine has bir gülüşleri vardır! ♪
Dialogue: 50,0:24:12.43,0:24:14.56,Lyrics2,,50,0,0,,♪ Biz yoldaştan öteyiz ♪
Dialogue: 50,0:24:14.56,0:24:16.64,Lyrics2,,50,0,0,,♪ Arkadaş dediğinin çok daha fazlası ♪
Dialogue: 50,0:24:18.90,0:24:21.86,Lyrics2,,50,0,117,,♪ Eğlence ve özgürlük olduğu sürece! ♪
Dialogue: 50,0:24:16.64,0:24:20.06,Lyrics2,,50,0,0,,♪ Biz bir AİLEYİZ! ♪
Dialogue: 50,0:24:20.06,0:24:22.02,Lyrics2,,50,0,0,,♪ Kardeş değiliz,
Dialogue: 50,0:24:22.02,0:24:25.03,Lyrics2,,50,0,0,,kan bağımız yok ♪
Dialogue: 50,0:24:25.03,0:24:29.32,Lyrics2,,50,0,0,,♪ Ama tayfamız yine de bir AİLE! ♪
